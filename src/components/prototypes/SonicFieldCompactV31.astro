<style is:global>
  /*
   * Sonic Field v3.1 compact pass.
   *
   * This is intentionally an override layer on top of v3 so the viewport-budget
   * experiment can be accepted or rejected without rewriting the base prototype.
   * `body` raises specificity above the base component's scoped selectors without
   * resorting to !important.
   */

  body .sonic .sitebar {
    min-height: 50px;
  }

  body .sonic .intro {
    min-height: 104px;
    gap: 30px;
    padding: 14px 0;
  }

  body .sonic h1 {
    font-size: clamp(34px, 3.3vw, 46px);
    line-height: 0.98;
  }

  body .sonic .description {
    margin-top: 7px;
    font-size: 12px;
  }

  body .sonic .intro-state {
    min-width: 220px;
  }

  body .sonic .sheet-bar {
    min-height: 40px;
  }

  body .sonic .rail-group {
    min-height: 64px;
    padding: 10px 12px;
  }

  body .sonic .rail-group > small {
    margin-bottom: 6px;
  }

  body .sonic .segmented button {
    min-height: 32px;
  }

  body .sonic .run,
  body .sonic .stop,
  body .sonic .answer {
    min-height: 36px;
  }

  body .sonic .safety-strip {
    min-height: 32px;
    padding: 6px 12px;
  }

  body .sonic .decision-band {
    min-height: 84px;
    padding: 11px 14px;
  }

  body .sonic .decision-band h2 {
    font-size: 17px;
  }

  body .sonic .prototype-footer {
    display: none;
  }

  /*
   * Desktop is budgeted from viewport height rather than a fixed screenshot.
   * At low desktop heights the complete sheet keeps at least ~36 px below it;
   * taller displays give the audio field more room up to a sensible ceiling.
   */
  @media (min-width: 761px) {
    body .sonic .canvas,
    body .sonic .headphone-canvas,
    body .sonic .spectrum-canvas,
    body .sonic .hearing-canvas {
      min-height: 0;
      height: clamp(420px, calc(100vh - 326px), 560px);
    }

    body .sonic .hearing-current {
      top: 15%;
    }

    body .sonic .frequency-path {
      top: 50%;
    }
  }

  @media (max-width: 760px) {
    body .sonic .sitebar {
      min-height: 46px;
    }

    body .sonic .intro {
      min-height: 0;
      gap: 6px;
      padding: 12px 0 10px;
    }

    body .sonic h1 {
      font-size: 31px;
      line-height: 1;
    }

    body .sonic .description {
      margin-top: 5px;
      font-size: 10.5px;
      line-height: 1.35;
    }

    body .sonic .intro-state {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 7px;
      text-align: left;
    }

    body .sonic .intro-state small {
      display: none;
    }

    body .sonic .intro-state strong {
      font-size: 12px;
    }

    body .sonic .intro-state span {
      font-size: 9px;
    }

    body .sonic .sheet-bar {
      min-height: 38px;
    }

    body .sonic .canvas {
      min-height: 0;
    }

    body .sonic .headphone-canvas,
    body .sonic .spectrum-canvas {
      min-height: 0;
      height: 350px;
    }

    body .sonic .hearing-canvas {
      min-height: 0;
      height: 360px;
    }

    body .sonic .rail-group {
      min-height: 58px;
      padding: 8px 10px;
    }

    body .sonic .spectrum-rail,
    body .sonic .hearing-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    body .sonic .spectrum-rail > .mode-group,
    body .sonic .spectrum-rail > .action-group,
    body .sonic .hearing-rail > .setup-group,
    body .sonic .hearing-rail > .action-group {
      grid-column: 1 / -1;
    }

    body .sonic .spectrum-rail > .rail-group:nth-child(2),
    body .sonic .hearing-rail > .rail-group:nth-child(2) {
      border-right: 1px solid #c2c7c3;
    }

    body .sonic .spectrum-rail > .rail-group:nth-child(4),
    body .sonic .hearing-rail > .rail-group:nth-child(4) {
      border-right: 0;
    }

    body .sonic .safety-strip {
      min-height: 34px;
      align-items: center;
      flex-direction: row;
      gap: 8px;
      padding: 6px 10px;
      font-size: 8px;
    }

    body .sonic .current-frequency {
      top: 12%;
    }

    body .sonic .current-frequency strong {
