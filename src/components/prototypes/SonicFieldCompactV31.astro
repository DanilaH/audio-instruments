      left: 63%;
    }

    body .sonic .hearing-current strong {
      font-size: 50px;
    }

    body .sonic .frequency-path {
      top: 145px;
    }

    body .sonic .observation-line {
      bottom: 110px;
    }

    body .sonic .decision-band {
      left: 0;
      grid-template-columns: 1fr;
      gap: 7px;
      min-height: 100px;
      padding: 9px 11px;
    }
  }

  @media (max-width: 390px) {
    body .sonic h1 {
      font-size: 30px;
    }

    body .sonic .intro-state span {
      display: none;
    }

    body .sonic .canvas,
    body .sonic .headphone-canvas,
    body .sonic .spectrum-canvas,
    body .sonic .hearing-canvas {
      min-height: 0;
    }
  }
</style>
