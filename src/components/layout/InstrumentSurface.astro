---
interface Props {
  label: string;
  accent?:
    "lavender" | "blue" | "mint" | "peach" | "yellow" | "cyan" | "neutral";
}

const { label, accent = "lavender" } = Astro.props;
---

<section class="instrument-surface" data-accent={accent} aria-label={label}>
  <slot />
</section>

<style>
  .instrument-surface {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: 30px;
    background:
      radial-gradient(
        circle at 88% 0%,
        rgb(143 124 255 / 0.16),
        transparent 30%
      ),
      linear-gradient(145deg, var(--color-surface), var(--color-surface-alt));
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  @media (max-width: 520px) {
    .instrument-surface {
      border-radius: 24px;
    }
  }
</style>
