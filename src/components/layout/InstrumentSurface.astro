---
interface Props {
  label: string;
  accent?:
    "lavender" | "blue" | "mint" | "peach" | "yellow" | "cyan" | "neutral";
}

const { label, accent = "lavender" } = Astro.props;
---

<section class="instrument-surface" data-accent={accent} aria-label={label}>
  <slot />
</section>

<style>
  .instrument-surface {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 520px) {
    .instrument-surface {
      border-radius: 8px;
    }
  }
</style>
