---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  accent?:
    | "lavender"
    | "blue"
    | "mint"
    | "peach"
    | "yellow"
    | "cyan"
    | "neutral";
}

const { eyebrow, title, description, accent = "lavender" } = Astro.props;
---

<article class="tool-shell shell" data-accent={accent}>
  <header class="tool-shell__header">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="tool-shell__lede">{description}</p>
  </header>
  <slot />
</article>

<style>
  .tool-shell {
    padding: clamp(16px, 2.2vw, 28px) 0 72px;
  }

  .tool-shell__header {
    max-width: 900px;
    margin-bottom: clamp(14px, 1.8vw, 22px);
  }

  .tool-shell__header .eyebrow {
    margin-bottom: 8px;
    color: #2b6971;
  }

  .tool-shell__header h1 {
    max-width: 900px;
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 0.98;
  }

  .tool-shell__lede {
    max-width: 780px;
    margin: 9px 0 0;
    color: var(--color-ink-muted);
    font-size: clamp(0.92rem, 1.15vw, 1.03rem);
    line-height: 1.48;
  }

  @media (max-width: 520px) {
    .tool-shell {
      padding-top: 12px;
      padding-bottom: 56px;
    }

    .tool-shell__header {
      margin-bottom: 12px;
    }

    .tool-shell__header .eyebrow {
      margin-bottom: 7px;
      font-size: 0.72rem;
    }

    .tool-shell__header h1 {
      font-size: 2rem;
      line-height: 1;
    }

    .tool-shell__lede {
      margin-top: 7px;
      font-size: 0.87rem;
      line-height: 1.4;
    }
  }
</style>
