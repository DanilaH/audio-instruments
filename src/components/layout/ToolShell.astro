---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  accent?:
    "lavender" | "blue" | "mint" | "peach" | "yellow" | "cyan" | "neutral";
}

const { eyebrow, title, description, accent = "lavender" } = Astro.props;
---

<article class="tool-shell shell" data-accent={accent}>
  <header class="tool-shell__header">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="tool-shell__lede">{description}</p>
  </header>
  <slot />
</article>

<style>
  .tool-shell {
    padding: 18px 0 64px;
  }

  .tool-shell__header {
    max-width: 920px;
    margin-bottom: 18px;
  }

  .tool-shell__header h1 {
    font-size: clamp(2.25rem, 3.8vw, 3.4rem);
    letter-spacing: -0.035em;
  }

  .tool-shell__lede {
    max-width: 680px;
    margin: 8px 0 0;
    color: var(--color-ink-muted);
    font-size: clamp(0.94rem, 1.2vw, 1.04rem);
    line-height: 1.5;
  }

  @media (min-width: 821px) and (max-height: 900px) {
    .tool-shell {
      padding-top: 14px;
    }

    .tool-shell__header {
      max-width: 900px;
      margin-bottom: 14px;
    }

    .tool-shell__header h1 {
      max-width: 900px;
      font-size: 2.65rem;
    }

    .tool-shell__header .eyebrow {
      margin-bottom: 10px;
    }

    .tool-shell__lede {
      max-width: 780px;
      margin-top: 10px;
      font-size: 0.95rem;
      line-height: 1.45;
    }
  }

  @media (max-width: 520px) {
    .tool-shell {
      padding-top: 14px;
    }

    .tool-shell__header {
      margin-bottom: 14px;
    }

    .tool-shell__header h1 {
      font-size: 2rem;
      line-height: 1.02;
    }

    .tool-shell__header .eyebrow {
      margin-bottom: 10px;
    }

    .tool-shell__lede {
      margin-top: 10px;
      font-size: 0.9rem;
      line-height: 1.45;
    }
  }

  /* Reference Instrument prototype */
  .tool-shell__header .eyebrow {
    margin-bottom: 7px;
    color: var(--color-ink-muted);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }
</style>
