---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  accent?:
    "lavender" | "blue" | "mint" | "peach" | "yellow" | "cyan" | "neutral";
}

const { eyebrow, title, description, accent = "lavender" } = Astro.props;
---

<article class="tool-shell shell" data-accent={accent}>
  <header class="tool-shell__header">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="tool-shell__lede">{description}</p>
  </header>
  <slot />
</article>

<style>
  .tool-shell {
    padding: clamp(34px, 5vw, 64px) 0 88px;
  }

  .tool-shell__header {
    max-width: 780px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }

  .tool-shell__header h1 {
    font-size: clamp(2.8rem, 6.5vw, 5.6rem);
  }

  .tool-shell__lede {
    max-width: 680px;
    margin: 20px 0 0;
    color: var(--color-ink-muted);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.65;
  }

  @media (min-width: 821px) and (max-height: 820px) {
    .tool-shell {
      padding-top: 14px;
    }

    .tool-shell__header {
      max-width: 900px;
      margin-bottom: 14px;
    }

    .tool-shell__header h1 {
      max-width: 900px;
      font-size: 3rem;
    }

    .tool-shell__header .eyebrow {
      margin-bottom: 10px;
    }

    .tool-shell__lede {
      max-width: 780px;
      margin-top: 10px;
      font-size: 0.95rem;
      line-height: 1.45;
    }
  }

  @media (max-width: 520px) {
    .tool-shell {
      padding-top: 14px;
    }

    .tool-shell__header {
      margin-bottom: 14px;
    }

    .tool-shell__header h1 {
      font-size: 2.2rem;
      line-height: 1.02;
    }

    .tool-shell__header .eyebrow {
      margin-bottom: 10px;
    }

    .tool-shell__lede {
      margin-top: 10px;
      font-size: 0.9rem;
      line-height: 1.45;
    }
  }
</style>
