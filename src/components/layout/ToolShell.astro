---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  accent?:
    "lavender" | "blue" | "mint" | "peach" | "yellow" | "cyan" | "neutral";
}

const { eyebrow, title, description, accent = "lavender" } = Astro.props;
---

<article class="tool-shell shell" data-accent={accent}>
  <header class="tool-shell__header">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="tool-shell__lede">{description}</p>
  </header>
  <slot />
</article>

<style>
  .tool-shell {
    padding: clamp(8px, 1.35vw, 16px) 0 72px;
  }

  .tool-shell__header {
    max-width: 900px;
    margin-bottom: clamp(10px, 1.1vw, 14px);
  }

  .tool-shell__header .eyebrow {
    margin-bottom: 5px;
    color: #2b6971;
    font-size: 0.74rem;
  }

  .tool-shell__header h1 {
    max-width: 900px;
    font-size: clamp(2.25rem, 3.2vw, 2.75rem);
    line-height: 1;
  }

  .tool-shell__lede {
    max-width: 780px;
    margin: 6px 0 0;
    color: var(--color-ink-muted);
    font-size: clamp(0.9rem, 1vw, 0.98rem);
    line-height: 1.42;
  }

  @media (max-width: 520px) {
    .tool-shell {
      padding-top: 12px;
      padding-bottom: 56px;
    }

    .tool-shell__header {
      margin-bottom: 12px;
    }

    .tool-shell__header .eyebrow {
      margin-bottom: 7px;
      font-size: 0.72rem;
    }

    .tool-shell__header h1 {
      font-size: 2rem;
      line-height: 1;
    }

    .tool-shell__lede {
      margin-top: 7px;
      font-size: 0.87rem;
      line-height: 1.4;
    }
  }
</style>
