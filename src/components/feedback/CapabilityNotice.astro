---
interface Props {
  id: string;
  message?: string;
  hidden?: boolean;
}

const { id, message = "", hidden = true } = Astro.props;
---

<p id={id} class="capability-notice" data-capability-notice hidden={hidden}>
  <i class="ph ph-info" aria-hidden="true"></i>
  <span data-capability-message>{message}</span>
</p>

<style>
  .capability-notice {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: rgb(255 255 255 / 0.62);
    color: var(--color-ink-muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .capability-notice[hidden] {
    display: none;
  }

  .capability-notice i {
    margin-top: 2px;
    color: var(--color-focus);
  }
</style>
