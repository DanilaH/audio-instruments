---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolShell from "../components/layout/ToolShell.astro";
import RelatedTools from "../components/navigation/RelatedTools.astro";
import SpectrumAnalyzer from "../tools/spectrum-analyzer/SpectrumAnalyzer.astro";
import { getPublicTools, toolRegistry } from "../registry/tools";

const spectrumTool = toolRegistry.find(
  (tool) => tool.id === "spectrum-analyzer",
);
if (!spectrumTool)
  throw new Error("Spectrum Analyzer registry entry is missing");
const publicTools = getPublicTools();
const publicToolsById = new Map(publicTools.map((tool) => [tool.id, tool]));
const relatedTools = spectrumTool.relatedToolIds.flatMap((id) => {
  const tool = publicToolsById.get(id);
  return tool ? [{ title: tool.title, route: tool.route }] : [];
});
---

<BaseLayout
  title="Spectrum Analyzer — Browser Audio Lab"
  description="Visualize relative microphone frequency content with spectrum, waveform and bounded 10-second spectrogram views using browser Web Audio analysis."
  hasLiveTools={publicTools.length > 0}
>
  <ToolShell
    eyebrow="Input & analysis"
    title="Spectrum Analyzer"
    description="Inspect the relative frequency content of the microphone stream with a logarithmic spectrum, live waveform, or rolling spectrogram."
    accent="cyan"
  >
    <SpectrumAnalyzer />

    <section class="spectrum-content" aria-labelledby="spectrum-about-title">
      <div>
        <p class="eyebrow">Relative FFT analysis</p>
        <h2 id="spectrum-about-title">
          See what the browser audio stream contains
        </h2>
      </div>
      <div class="spectrum-content__copy">
        <p>
          Spectrum mode uses Web Audio float frequency-bin data on a logarithmic
          20 Hz to 20 kHz-or-Nyquist axis. The selectable FFT size changes
          frequency resolution while the baseline smoothing remains 0.8.
        </p>
        <p>
          The dominant readout is only the strongest displayed FFT bin at or
          above 40 Hz. It is not a musical-pitch estimate and should not be
          interpreted as one.
        </p>
      </div>
    </section>

    <section class="spectrum-help" aria-labelledby="spectrum-help-title">
      <h2 id="spectrum-help-title">What the views mean</h2>
      <div class="spectrum-help__grid">
        <p>
          Waveform shows the current time-domain signal. Spectrogram keeps at
          most 10 seconds of timestamped frequency columns, sampled at no more
          than 30 columns per second and capped at 300 retained columns.
        </p>
        <p>
          These are relative browser-stream visualizations. They do not
          calibrate the microphone, measure acoustic SPL, determine physical
          frequency response, or automatically diagnose a microphone or room.
        </p>
      </div>
    </section>

    <RelatedTools relatedTools={relatedTools} />
  </ToolShell>
</BaseLayout>

<style>
  .spectrum-content,
  .spectrum-help {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 72px);
    margin-top: 64px;
    padding-top: 44px;
    border-top: 1px solid var(--color-border);
  }

  .spectrum-content h2,
  .spectrum-help h2 {
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    line-height: 1.08;
  }

  .spectrum-content__copy,
  .spectrum-help__grid {
    display: grid;
    gap: 14px;
  }

  .spectrum-content p,
  .spectrum-help p {
    margin: 0;
    color: var(--color-ink-muted);
    line-height: 1.72;
  }

  @media (max-width: 620px) {
    :global([data-spectrum-analyzer] .spectrum-input-slot),
    :global([data-spectrum-analyzer] .spectrum-selection-slot) {
      min-height: 0;
    }
  }

  @media (max-width: 760px) {
    .spectrum-content,
    .spectrum-help {
      grid-template-columns: 1fr;
      margin-top: 48px;
      padding-top: 34px;
    }
  }
</style>
