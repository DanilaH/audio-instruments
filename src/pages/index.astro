---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getPublicTools,
  getPublicToolsByCategory,
  type NavigationCategory,
} from "../registry/tools";

const publicTools = getPublicTools();
const toneGenerator = publicTools.find((tool) => tool.id === "tone-generator");

const featuredTargetIds = [
  "tone-generator",
  "speaker-test",
  "microphone-test",
  "headphone-test",
] as const;

type FeaturedToolId = (typeof featuredTargetIds)[number];

const featuredPresentation: Record<
  FeaturedToolId,
  {
    kicker: string;
    description: string;
    icon: string;
    variant: string;
  }
> = {
  "tone-generator": {
    kicker: "Signal & frequency",
    description:
      "Generate a controlled reference tone, change waveform and route it left, right or to both channels.",
    icon: "ph-wave-sine",
    variant: "tone",
  },
  "speaker-test": {
    kicker: "Output diagnostics",
    description:
      "Check channel routing, phase, sweep behavior and user-observed bass or rattle changes from one focused speaker workflow.",
    icon: "ph-speaker-high",
    variant: "speaker",
  },
  "microphone-test": {
    kicker: "Input & analysis",
    description:
      "Inspect live microphone input, waveform and relative level, with an optional short recording that stays local in core v1.",
    icon: "ph-microphone",
    variant: "microphone",
  },
  "headphone-test": {
    kicker: "Output diagnostics",
    description:
      "Check left, right and both ears, then compare phase, sweep and bass behavior without turning listening observations into hardware diagnoses.",
    icon: "ph-headphones",
    variant: "headphone",
  },
};

const featuredTools = featuredTargetIds.flatMap((id) => {
  const tool = publicTools.find((candidate) => candidate.id === id);
  if (!tool) return [];
  return [{ tool, presentation: featuredPresentation[id] }];
});

const categories: readonly {
  id: NavigationCategory;
  label: string;
  description: string;
  icon: string;
}[] = [
  {
    id: "output",
    label: "Output diagnostics",
    description: "Playback, channel, phase and multichannel checks.",
    icon: "ph-speaker-high",
  },
  {
    id: "signal-frequency",
    label: "Signal and frequency",
    description: "Reference tones, sweeps, noise, bass and hearing exploration.",
    icon: "ph-wave-sine",
  },
  {
    id: "input-analysis",
    label: "Input and analysis",
    description: "Microphone capture, spectrum, pitch and relative level tools.",
    icon: "ph-waveform",
  },
  {
    id: "timing-specialist",
    label: "Timing / specialist",
    description: "Browser-reported latency and perception-based AV sync.",
    icon: "ph-timer",
  },
];

const liveCategories = categories
  .map((category) => ({
    ...category,
    tools: getPublicToolsByCategory(category.id),
  }))
  .filter(({ tools }) => tools.length > 0);
---

<BaseLayout
  title="Browser Audio Lab"
  description="Browser-based audio testing and measurement tools with clear limitations and local-first microphone processing."
  hasLiveTools={publicTools.length > 0}
>
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Browser-based audio tools</p>
        <h1>Understand what your audio setup is doing.</h1>
        <p class="lede">
          Focused tools for testing playback, signals, microphones and audio
          analysis — designed to show what the browser actually knows without
          pretending it can measure what it cannot.
        </p>
        {
          toneGenerator && (
            <div class="hero__actions">
              <a class="hero__primary-action" href={toneGenerator.route}>
                <span>Open Tone Generator</span>
                <i class="ph ph-arrow-right" aria-hidden="true" />
              </a>
              <span class="hero__action-note">
                20 Hz–20 kHz nominal range, capped to browser audio limits
              </span>
            </div>
          )
        }
      </div>

      <div
        class="hero-visual"
        role="img"
        aria-label="Stylized 440 hertz sine-wave reference signal"
      >
        <div class="hero-visual__top" aria-hidden="true">
          <span class="signal-badge">
            <i class="ph ph-wave-sine"></i>
            Reference signal
          </span>
          <strong>
            440 <small>Hz</small>
          </strong>
        </div>

        <svg class="hero-waveform" viewBox="0 0 620 220" aria-hidden="true">
          <path
            class="hero-waveform__trail hero-waveform__trail--far"
            d="M0 110 C38 110 48 42 82 42 S126 178 164 178 208 42 246 42 290 178 328 178 372 42 410 42 454 178 492 178 536 42 574 42 607 110 620 110"
          ></path>
          <path
            class="hero-waveform__trail"
            d="M0 110 C38 110 48 42 82 42 S126 178 164 178 208 42 246 42 290 178 328 178 372 42 410 42 454 178 492 178 536 42 574 42 607 110 620 110"
          ></path>
          <path
            class="hero-waveform__signal"
            d="M0 110 C38 110 48 42 82 42 S126 178 164 178 208 42 246 42 290 178 328 178 372 42 410 42 454 178 492 178 536 42 574 42 607 110 620 110"
          ></path>
        </svg>

        <div class="hero-visual__footer" aria-hidden="true">
          <span>Sine</span>
          <span>Both channels</span>
          <span>−24 dB level</span>
        </div>
      </div>
    </div>
  </section>

  {
    featuredTools.length > 0 && (
      <section
        class="shell tools-section featured-section"
        aria-labelledby="featured-tools-title"
      >
        <div class="section-heading-row">
          <div>
            <p class="eyebrow">Featured tools</p>
            <h2 id="featured-tools-title">Start with a focused check.</h2>
          </div>
          <a class="section-jump" href="#tools">
            Browse all {publicTools.length} tools
            <i class="ph ph-arrow-down" aria-hidden="true" />
          </a>
        </div>

        <div
          class="tool-grid tool-grid--featured"
          data-featured-count={featuredTools.length}
        >
          {featuredTools.map(({ tool, presentation }, index) => (
            <a
              class={`featured-card featured-card--${presentation.variant} ${
                presentation.variant === "tone" ||
                presentation.variant === "headphone"
                  ? "featured-card--wide"
                  : "featured-card--compact"
              }`}
              href={tool.route}
              data-featured-tool={tool.id}
              data-featured-order={index + 1}
              data-tool-status={tool.status}
              data-accent={tool.accent}
            >
              <span class="featured-card__copy">
                <span class="featured-card__kicker">
                  <i class={`ph ${presentation.icon}`} aria-hidden="true" />
                  {presentation.kicker}
                </span>
                <strong class="featured-card__title">{tool.title}</strong>
                <span class="featured-card__description">
                  {presentation.description}
                </span>
                <span class="featured-card__action">
                  Open tool
                  <i class="ph ph-arrow-up-right" aria-hidden="true" />
                </span>
              </span>

              {tool.id === "tone-generator" && (
                <span
                  class="featured-card__visual featured-card__visual--tone"
                  data-featured-visual="tone-waveform"
                  aria-hidden="true"
                >
                  <span class="featured-card__metric">
                    <strong>440</strong>
                    <small>Hz</small>
                  </span>
                  <svg viewBox="0 0 300 120">
                    <path d="M0 60 C22 60 28 20 48 20 S74 100 96 100 122 20 144 20 170 100 192 100 218 20 240 20 267 100 288 100 296 60 300 60" />
                  </svg>
                  <span class="featured-card__visual-meta">Sine · Both</span>
                </span>
              )}

              {tool.id === "speaker-test" && (
                <span
                  class="featured-card__device featured-speaker"
                  data-featured-visual="speaker-cones"
                  aria-hidden="true"
                >
                  <span class="featured-speaker__ring featured-speaker__ring--outer" />
                  <span class="featured-speaker__ring featured-speaker__ring--inner" />
                  <span class="featured-speaker__cone">
                    <span />
                  </span>
                  <small>Channel · phase · sweep</small>
                </span>
              )}

              {tool.id === "microphone-test" && (
                <span
                  class="featured-card__device featured-microphone"
                  data-featured-visual="microphone-waveform"
                  aria-hidden="true"
                >
                  <span class="featured-microphone__halo" />
                  <span class="featured-microphone__capsule">
                    <i class="ph ph-microphone" />
                  </span>
                  <span class="featured-microphone__wave">
                    <i style="--bar: 0.36" />
                    <i style="--bar: 0.74" />
                    <i style="--bar: 1" />
                    <i style="--bar: 0.58" />
                    <i style="--bar: 0.86" />
                    <i style="--bar: 0.44" />
                    <i style="--bar: 0.68" />
                  </span>
                  <small>Local-first input</small>
                </span>
              )}

              {tool.id === "headphone-test" && (
                <span
                  class="featured-card__device featured-headphone"
                  data-featured-visual="headphone-earcups"
                  aria-hidden="true"
                >
                  <span class="featured-headphone__arc" />
                  <span class="featured-headphone__ear featured-headphone__ear--left">
                    <strong>L</strong>
                  </span>
                  <span class="featured-headphone__signal" />
                  <span class="featured-headphone__ear featured-headphone__ear--right">
                    <strong>R</strong>
                  </span>
                  <small>Left · right · both</small>
                </span>
              )}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    publicTools.length > 0 && (
      <section
        id="tools"
        class="shell tools-section tools-section--directory"
        aria-labelledby="all-tools-title"
      >
        <div class="section-heading-row section-heading-row--directory">
          <div>
            <p class="eyebrow">All live tools</p>
            <h2 id="all-tools-title">Audio tools by job.</h2>
          </div>
          <p class="directory-summary">
            {publicTools.length} focused browser tools, grouped by the job they help
            you inspect.
          </p>
        </div>

        <div class="tool-categories" data-category-count={liveCategories.length}>
          {liveCategories.map(({ id, label, description, icon, tools }) => (
            <section
              class="tool-category"
              aria-labelledby={`category-${id}`}
              data-tool-category={id}
              data-tool-count={tools.length}
            >
              <div class="tool-category__header">
                <span class="tool-category__icon" aria-hidden="true">
                  <i class={`ph ${icon}`} />
                </span>
                <div>
                  <div class="tool-category__title-row">
                    <h3 id={`category-${id}`}>{label}</h3>
                    <span aria-label={`${tools.length} tools`}>{tools.length}</span>
                  </div>
                  <p>{description}</p>
                </div>
              </div>

              <div class="tool-list">
                {tools.map((tool) => (
                  <a
                    class="tool-link"
                    href={tool.route}
                    data-tool-id={tool.id}
                    data-tool-status={tool.status}
                    data-accent={tool.accent}
                  >
                    <span class="tool-link__identity">
                      <span class="tool-link__accent" aria-hidden="true" />
                      <strong>{tool.title}</strong>
                    </span>
                    <span class="tool-link__action">
                      Open
                      <i class="ph ph-arrow-right" aria-hidden="true" />
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    )
  }

  <section class="trust">
    <div class="shell trust__panel">
      <div>
        <p class="eyebrow">Built for honest diagnostics</p>
        <h2>Useful browser signals, with the limits visible.</h2>
      </div>
      <div>
        <p class="trust__copy">
          No account is required. Core microphone tools are designed to process
          audio locally in your browser, and core v1 does not upload microphone
          recordings or microphone audio to our server.
        </p>
        <div class="trust__facts" aria-label="Product principles">
          <div class="fact">Local-first microphone processing</div>
          <div class="fact">No account required</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero h1 {
    font-size: clamp(3rem, 5.2vw, 4.8rem);
  }

  .section-heading-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
  }

  .section-jump {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    font-weight: 800;
    text-decoration: none;
  }

  .section-jump:hover {
    color: var(--color-ink);
  }

  .tool-grid--featured {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .featured-card--wide {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.06fr) minmax(280px, 0.94fr);
    gap: clamp(24px, 4vw, 54px);
    min-height: 286px;
  }

  .featured-card--compact {
    grid-template-columns: minmax(0, 1fr) minmax(150px, 0.58fr);
    gap: 22px;
    min-height: 260px;
  }

  .featured-card--speaker {
    background:
      radial-gradient(circle at 94% 12%, rgb(255 181 141 / 0.3), transparent 38%),
      var(--color-surface);
  }

  .featured-card--microphone {
    background:
      radial-gradient(circle at 90% 8%, rgb(118 205 228 / 0.28), transparent 38%),
      var(--color-surface);
  }

  .featured-card--headphone {
    background:
      radial-gradient(circle at 90% 8%, rgb(103 167 255 / 0.24), transparent 34%),
      linear-gradient(145deg, var(--color-surface), rgb(241 247 255 / 0.86));
  }

  .featured-card--compact .featured-card__title {
    margin-top: 18px;
    font-size: clamp(1.65rem, 2.6vw, 2.45rem);
  }

  .featured-card--compact .featured-card__description {
    margin-top: 14px;
    font-size: 0.92rem;
  }

  .featured-card__device {
    position: relative;
    display: grid;
    min-height: 188px;
    place-items: center;
    align-self: stretch;
    border: 1px solid
      color-mix(in srgb, var(--tool-accent) 24%, var(--color-border));
    border-radius: 24px;
    background: rgb(255 253 252 / 0.64);
    overflow: hidden;
  }

  .featured-card__device small {
    position: absolute;
    right: 14px;
    bottom: 12px;
    left: 14px;
    color: var(--color-ink-muted);
    font-size: 0.7rem;
    font-weight: 750;
    text-align: center;
  }

  .featured-speaker__ring,
  .featured-speaker__cone {
    position: absolute;
    border-radius: 999px;
  }

  .featured-speaker__ring {
    border: 2px solid rgb(255 181 141 / 0.32);
  }

  .featured-speaker__ring--outer {
    width: 132px;
    height: 132px;
  }

  .featured-speaker__ring--inner {
    width: 102px;
    height: 102px;
  }

  .featured-speaker__cone {
    display: grid;
    width: 76px;
    height: 76px;
    place-items: center;
    background: rgb(255 181 141 / 0.52);
    box-shadow:
      inset 0 0 0 12px rgb(255 253 252 / 0.52),
      0 16px 36px rgb(111 70 43 / 0.12);
  }

  .featured-speaker__cone span {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: rgb(87 60 48 / 0.72);
  }

  .featured-microphone__halo {
    position: absolute;
    width: 132px;
    height: 132px;
    border-radius: 999px;
    background: rgb(118 205 228 / 0.16);
    box-shadow: 0 0 0 18px rgb(118 205 228 / 0.07);
  }

  .featured-microphone__capsule {
    position: relative;
    z-index: 1;
    display: grid;
    width: 72px;
    height: 92px;
    place-items: center;
    border: 1px solid rgb(72 140 158 / 0.2);
    border-radius: 34px;
    background: rgb(255 255 255 / 0.8);
    box-shadow: 0 14px 30px rgb(52 116 133 / 0.1);
  }

  .featured-microphone__capsule i {
    color: rgb(48 116 134);
    font-size: 2.1rem;
  }

  .featured-microphone__wave {
    position: absolute;
    bottom: 34px;
    display: flex;
    height: 32px;
    align-items: end;
    gap: 3px;
  }

  .featured-microphone__wave i {
    width: 3px;
    height: 28px;
    border-radius: 999px;
    background: rgb(48 116 134 / 0.58);
    transform: scaleY(var(--bar));
    transform-origin: center bottom;
  }

  .featured-headphone {
    min-height: 214px;
  }

  .featured-headphone__arc {
    position: absolute;
    top: 38px;
    width: 184px;
    height: 112px;
    border: 14px solid rgb(103 167 255 / 0.28);
    border-bottom: 0;
    border-radius: 100px 100px 0 0;
  }

  .featured-headphone__ear {
    position: absolute;
    top: 104px;
    display: grid;
    width: 64px;
    height: 82px;
    place-items: center;
    border: 1px solid rgb(63 111 173 / 0.16);
    border-radius: 26px;
    background: rgb(255 255 255 / 0.84);
    box-shadow: 0 14px 30px rgb(61 102 157 / 0.1);
  }

  .featured-headphone__ear--left {
    left: calc(50% - 100px);
  }

  .featured-headphone__ear--right {
    right: calc(50% - 100px);
  }

  .featured-headphone__ear strong {
    color: rgb(57 99 154);
    font-size: 1rem;
  }

  .featured-headphone__signal {
    width: 34px;
    height: 8px;
    border-radius: 999px;
    background: rgb(103 167 255 / 0.76);
    box-shadow:
      -38px 0 0 rgb(103 167 255 / 0.18),
      38px 0 0 rgb(103 167 255 / 0.18);
  }

  .section-heading-row--directory {
    align-items: end;
  }

  .directory-summary {
    max-width: 330px;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .tool-categories {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .tool-category {
    gap: 18px;
    min-width: 0;
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    background: rgb(255 253 252 / 0.62);
  }

  .tool-category__header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 13px;
    align-items: start;
  }

  .tool-category__icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 14px;
    background: var(--color-surface-alt);
    color: var(--color-focus);
    font-size: 1.12rem;
  }

  .tool-category__title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .tool-category__title-row h3 {
    color: var(--color-ink);
    font-size: 0.96rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .tool-category__title-row span {
    color: var(--color-ink-muted);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .tool-category__header p {
    margin: 5px 0 0;
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .tool-category .tool-link {
    min-height: 56px;
    padding: 11px 13px;
    background: rgb(255 255 255 / 0.66);
  }

  .tool-category .tool-link__identity strong {
    font-size: 0.9rem;
  }

  @media (max-width: 940px) {
    .featured-card--compact {
      grid-template-columns: 1fr;
    }

    .featured-card--compact .featured-card__device {
      min-height: 160px;
    }
  }

  @media (max-width: 820px) {
    .hero h1 {
      font-size: clamp(3rem, calc(2rem + 7vw), 4.2rem);
    }

    .section-heading-row {
      align-items: start;
      flex-direction: column;
      gap: 12px;
    }

    .tool-grid--featured,
    .tool-categories {
      grid-template-columns: 1fr;
    }

    .featured-card--wide,
    .featured-card--compact {
      grid-column: auto;
      grid-template-columns: 1fr;
    }

    .featured-card--wide {
      min-height: 0;
    }

    .featured-card__device,
    .featured-headphone {
      min-height: 180px;
    }

    .directory-summary {
      max-width: 560px;
    }
  }

  @media (max-width: 520px) {
    .featured-section {
      padding-top: 10px;
    }

    .featured-card {
      padding: 20px;
      border-radius: 24px;
    }

    .featured-card__title,
    .featured-card--compact .featured-card__title {
      margin-top: 16px;
      font-size: clamp(1.55rem, 9vw, 2.15rem);
    }

    .featured-card__description {
      font-size: 0.86rem;
      line-height: 1.55;
    }

    .featured-card__visual,
    .featured-card__device {
      min-height: 154px;
      padding: 16px;
    }

    .featured-headphone {
      min-height: 190px;
    }

    .featured-speaker__ring--outer {
      width: 108px;
      height: 108px;
    }

    .featured-speaker__ring--inner {
      width: 84px;
      height: 84px;
    }

    .featured-speaker__cone {
      width: 62px;
      height: 62px;
    }

    .featured-headphone__arc {
      top: 26px;
      width: 154px;
      height: 96px;
    }

    .featured-headphone__ear {
      top: 78px;
      width: 54px;
      height: 68px;
    }

    .featured-headphone__ear--left {
      left: calc(50% - 84px);
    }

    .featured-headphone__ear--right {
      right: calc(50% - 84px);
    }

    .tool-category {
      padding: 17px;
      border-radius: 20px;
    }

    .tool-link__action {
      font-size: 0;
    }

    .tool-link__action i {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-card,
    .tool-link {
      transition: none;
    }

    .featured-card:hover,
    .tool-link:hover {
      transform: none;
    }
  }
</style>
