---
import "@phosphor-icons/web/regular";
import "../styles/global.css";
import "../styles/sonic-shell.css";
import "../styles/touch-targets.css";
import {
  buildCloudflareWebAnalyticsBeaconConfig,
  CLOUDFLARE_WEB_ANALYTICS_SCRIPT_URL,
  resolveSiteAnalyticsConfig,
} from "../config/site-analytics";
import {
  buildCanonicalUrl,
  resolveSiteIndexingConfigFromSite,
} from "../config/site-indexing";

interface Props {
  title: string;
  description: string;
  hasLiveTools?: boolean;
}

const { title, description, hasLiveTools = false } = Astro.props;
const year = new Date().getFullYear();
const indexing = resolveSiteIndexingConfigFromSite(Astro.site);
const canonicalUrl = buildCanonicalUrl(indexing, Astro.url.pathname);
const analytics = resolveSiteAnalyticsConfig({
  SITE_ANALYTICS: import.meta.env.SITE_ANALYTICS,
  ANALYTICS_PRIVACY_REVIEW: import.meta.env.ANALYTICS_PRIVACY_REVIEW,
  CLOUDFLARE_WEB_ANALYTICS_TOKEN: import.meta.env
    .CLOUDFLARE_WEB_ANALYTICS_TOKEN,
});
const cloudflareBeaconConfig =
  buildCloudflareWebAnalyticsBeaconConfig(analytics);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={indexing.robotsDirective} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="/" aria-label="Browser Audio Lab home">
          <span class="brand__mark" aria-hidden="true"
            ><i class="ph ph-waveform"></i></span
          >
          <span>Browser Audio Lab</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {hasLiveTools && <a href="/#tools">Tools</a>}
          <a href="/privacy">Privacy</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <span>© {year} Browser Audio Lab</span>
        <a href="/privacy">Privacy</a>
      </div>
    </footer>
    {
      cloudflareBeaconConfig && (
        <script
          is:inline
          type="module"
          src={CLOUDFLARE_WEB_ANALYTICS_SCRIPT_URL}
          data-cf-beacon={cloudflareBeaconConfig}
        />
      )
    }
  </body>
</html>
