---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import SonicInstrument from "../../components/layout/SonicInstrument.astro";
---

<div data-microphone-test data-mic-state="idle">
  <SonicInstrument
    class="mic-sheet"
    label="Microphone Test capture, meter and recording controls"
  >
    <header class="mic-bar">
      <ToolStatus id="microphone-test-status" label="Ready" state="idle" />
      <div class="mic-input-readout">
        <span>Input</span>
        <strong data-mic-active-input>No active input</strong>
      </div>
    </header>

    <section class="mic-field" aria-label="Live microphone waveform and level">
      <div class="mic-field__heading">
        <div>
          <span>Live browser input</span>
          <strong>Waveform + digital level</strong>
        </div>
        <small>Local analysis · no speaker routing</small>
      </div>

      <div class="mic-waveform">
        <canvas data-mic-waveform aria-label="Live microphone waveform"
        ></canvas>
        <span class="mic-waveform__baseline" aria-hidden="true"></span>
      </div>

      <div class="mic-meters" aria-label="Digital microphone level meters">
        <div class="mic-meter">
          <span>RMS</span>
          <strong data-mic-rms>—</strong>
          <small>100 ms · 10 Hz update</small>
        </div>
        <div class="mic-meter">
          <span>Peak hold</span>
          <strong data-mic-peak>—</strong>
          <small>1 s hold · 20 dB/s decay</small>
        </div>
        <p class="mic-field__note">
          Values are digital dBFS from the browser audio stream, not calibrated
          sound-pressure level (SPL).
        </p>
      </div>
    </section>

    <section class="mic-rail" aria-label="Microphone Test controls">
      <div class="mic-capture-pane">
        <div class="mic-permission">
          <i class="ph ph-microphone" aria-hidden="true"></i>
          <div>
            <strong>Permission is requested only after Start.</strong>
            <p>
              Echo cancellation, noise suppression and automatic gain control
              are requested off where supported; reported track settings remain
              authoritative.
            </p>
          </div>
        </div>

        <div class="mic-primary-actions">
          <button type="button" class="mic-start" data-mic-start>
            <i class="ph ph-microphone" aria-hidden="true"></i>
            Start microphone
          </button>
          <button type="button" class="mic-stop" data-mic-stop disabled>
            <span class="transport-stop-shape" aria-hidden="true"></span>
            Stop
          </button>
        </div>

        <div class="mic-input-slot">
          <label class="mic-input-field" data-mic-input-field hidden>
            <span>Input device</span>
            <select data-mic-input-select aria-label="Microphone input device"
            ></select>
          </label>
          <p
            class="mic-selection-error"
            data-mic-selection-error
            role="alert"
            hidden
          >
          </p>
        </div>

        <details class="mic-details">
          <summary>Capture details</summary>
          <dl>
            <div>
              <dt>Device ID</dt>
              <dd data-mic-detail-device-id>Not reported</dd>
            </div>
            <div>
              <dt>Web Audio processing rate</dt>
              <dd data-mic-detail-analysis-rate>Not reported</dd>
            </div>
            <div>
              <dt>Reported capture rate</dt>
              <dd data-mic-detail-sample-rate>Not reported</dd>
            </div>
            <div>
              <dt>Reported channels</dt>
              <dd data-mic-detail-channel-count>Not reported</dd>
            </div>
            <div>
              <dt>Echo cancellation</dt>
              <dd data-mic-detail-echo-cancellation>Not reported</dd>
            </div>
            <div>
              <dt>Noise suppression</dt>
              <dd data-mic-detail-noise-suppression>Not reported</dd>
            </div>
            <div>
              <dt>Automatic gain control</dt>
              <dd data-mic-detail-auto-gain>Not reported</dd>
            </div>
          </dl>
        </details>
      </div>

      <section class="mic-recording" aria-labelledby="mic-recording-title">
        <div class="mic-recording__header">
          <div>
            <span class="mic-kicker">Local recording</span>
            <h3 id="mic-recording-title">Record up to 15 seconds</h3>
          </div>
          <p data-mic-recording-status role="status" aria-live="polite">
            No local recording yet
          </p>
        </div>

        <div class="mic-recording__actions">
          <button type="button" data-mic-record disabled>
            <i class="ph ph-record" aria-hidden="true"></i>
            Record
          </button>
          <button type="button" data-mic-record-stop disabled>
            <span class="transport-stop-shape" aria-hidden="true"></span>
            Stop recording
          </button>
        </div>

        <div class="mic-recording__notice-slot">
          <p class="mic-recording__notice" data-mic-recording-notice hidden></p>
        </div>
        <div class="mic-recording__playback-slot">
          <audio data-mic-playback controls preload="metadata" hidden>
            Your browser does not support audio playback controls.
          </audio>
        </div>
      </section>
    </section>

    <div class="mic-feedback-slot">
      <p class="mic-error" data-mic-error role="alert" hidden></p>
    </div>
  </SonicInstrument>
</div>

<script>
  import { MicrophoneTestController } from "./MicrophoneTestController";

  const root = document.querySelector<HTMLElement>("[data-microphone-test]");
  let controller: MicrophoneTestController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new MicrophoneTestController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .mic-bar {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 18px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .mic-input-readout {
    display: grid;
    justify-items: end;
    gap: 1px;
    min-width: 0;
    text-align: right;
  }

  .mic-input-readout span,
  .mic-field__heading span,
  .mic-kicker,
  .mic-meter span,
  .mic-input-field > span {
    color: var(--sonic-muted);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mic-input-readout strong {
    max-width: min(38vw, 300px);
    overflow: hidden;
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mic-field {
    display: grid;
    grid-template-rows: auto minmax(118px, 1fr) auto;
    gap: 9px;
    min-height: 238px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--sonic-border);
    background: var(--sonic-field);
  }

  .mic-field__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .mic-field__heading > div {
    display: grid;
    gap: 2px;
  }

  .mic-field__heading strong {
    font-size: 0.9rem;
  }

  .mic-field__heading small,
  .mic-field__note,
  .mic-permission p,
  .mic-recording__header p,
  .mic-recording__notice,
  .mic-selection-error,
  .mic-error {
    margin: 0;
    color: var(--sonic-muted);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .mic-waveform {
    position: relative;
    min-height: 118px;
    overflow: hidden;
    border: 1px solid var(--sonic-border);
    border-radius: var(--sonic-control-radius);
    background:
      linear-gradient(
        to bottom,
        transparent calc(50% - 1px),
        rgb(24 56 65 / 0.12) 50%,
        transparent calc(50% + 1px)
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent calc(12.5% - 1px),
        rgb(24 56 65 / 0.07) 12.5%
      ),
      rgb(243 240 232 / 0.64);
    color: var(--sonic-signal);
  }

  .mic-waveform canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mic-waveform__baseline {
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: rgb(24 56 65 / 0.12);
    pointer-events: none;
  }

  .mic-meters {
    display: grid;
    grid-template-columns: minmax(130px, 0.34fr) minmax(130px, 0.34fr) minmax(
        260px,
        1fr
      );
    align-items: stretch;
    gap: 7px;
  }

  .mic-meter,
  .mic-field__note {
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid var(--sonic-border-soft);
    border-radius: var(--sonic-control-radius);
    background: rgb(243 240 232 / 0.48);
  }

  .mic-meter {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 2px 8px;
  }

  .mic-meter strong {
    justify-self: end;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .mic-meter small {
    grid-column: 1 / -1;
    color: var(--sonic-muted);
    font-size: 0.64rem;
  }

  .mic-field__note {
    align-content: center;
  }

  .mic-rail {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    min-height: 196px;
  }

  .mic-capture-pane,
  .mic-recording {
    min-width: 0;
    padding: 11px 14px;
  }

  .mic-capture-pane {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    gap: 7px 10px;
    border-right: 1px solid var(--sonic-border-soft);
  }

  .mic-permission {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
  }

  .mic-permission > i {
    margin-top: 2px;
    color: var(--sonic-signal);
  }

  .mic-permission strong {
    display: block;
    margin-bottom: 2px;
    font-size: 0.76rem;
  }

  .mic-primary-actions,
  .mic-recording__actions {
    display: grid;
    gap: 6px;
  }

  .mic-primary-actions {
    grid-template-columns: minmax(132px, 1fr) minmax(84px, 0.55fr);
    align-self: start;
  }

  .mic-start,
  .mic-stop,
  .mic-recording__actions button,
  .mic-details summary,
  .mic-input-field select {
    min-height: 44px;
    border: 1px solid var(--sonic-border);
    border-radius: var(--sonic-control-radius);
    background: transparent;
    color: var(--sonic-ink);
    font: inherit;
  }

  .mic-start,
  .mic-stop,
  .mic-recording__actions button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 12px;
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
  }

  .mic-start {
    border-color: var(--sonic-ink);
    background: var(--sonic-ink);
    color: var(--sonic-sheet);
  }

  .transport-stop-shape {
    display: inline-block;
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    border-radius: 1px;
    background: currentColor;
  }

  .mic-input-slot {
    grid-column: 1 / -1;
    min-height: 50px;
  }

  .mic-input-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 10px;
  }

  .mic-input-field[hidden],
  .mic-recording__notice[hidden],
  .mic-selection-error[hidden],
  .mic-error[hidden],
  audio[hidden] {
    display: none;
  }

  .mic-input-field select {
    min-width: 0;
    padding: 0 34px 0 10px;
    background: var(--sonic-control-bg);
  }

  .mic-selection-error {
    padding-top: 4px;
    color: #773927;
  }

  .mic-details {
    grid-column: 1 / -1;
    border-top: 1px solid var(--sonic-border-soft);
  }

  .mic-details summary {
    display: flex;
    align-items: center;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    font-size: 0.73rem;
    font-weight: 800;
  }

  .mic-details dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5px 12px;
    margin: 4px 0 2px;
    padding: 5px 0;
  }

  .mic-details dl > div {
    display: grid;
    grid-template-columns: minmax(110px, 0.8fr) minmax(0, 1.2fr);
    gap: 8px;
    font-size: 0.68rem;
  }

  .mic-details dt {
    color: var(--sonic-muted);
  }

  .mic-details dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    font-weight: 700;
  }

  .mic-recording {
    display: grid;
    align-content: start;
    gap: 7px;
  }

  .mic-recording__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 10px;
  }

  .mic-recording h3 {
    margin: 1px 0 0;
    font-size: 0.85rem;
  }

  .mic-recording__header p {
    max-width: 165px;
    text-align: right;
  }

  .mic-recording__actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .mic-recording__notice-slot {
    min-height: 20px;
  }

  .mic-recording__playback-slot {
    display: flex;
    min-height: 44px;
    align-items: center;
  }

  .mic-recording audio {
    width: 100%;
    min-height: 44px;
    height: 44px;
  }

  .mic-feedback-slot:empty {
    display: none;
  }

  .mic-error {
    margin: 0;
    padding: 8px 14px;
    border-top: 1px solid rgb(149 80 59 / 0.25);
    background: rgb(149 80 59 / 0.06);
    color: #773927;
  }

  button:disabled,
  select:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  @media (min-width: 901px) and (max-height: 820px) {
    .mic-bar {
      min-height: 46px;
      padding-block: 5px;
    }

    .mic-field {
      grid-template-rows: auto 92px auto;
      min-height: 0;
      gap: 6px;
      padding-block: 8px;
    }

    .mic-waveform {
      min-height: 92px;
    }

    .mic-rail {
      min-height: 180px;
    }

    .mic-capture-pane,
    .mic-recording {
      padding-block: 8px;
    }

    .mic-input-slot {
      min-height: 46px;
    }
  }

  @media (max-width: 900px) {
    .mic-field {
      min-height: 220px;
    }

    .mic-rail {
      grid-template-columns: 1fr;
    }

    .mic-capture-pane {
      border-right: 0;
      border-bottom: 1px solid var(--sonic-border-soft);
    }
  }

  @media (max-width: 560px) {
    .mic-bar {
      align-items: flex-start;
      padding: 7px 12px;
    }

    .mic-input-readout strong {
      max-width: 48vw;
    }

    .mic-field {
      grid-template-rows: auto 112px auto;
      gap: 7px;
      min-height: 0;
      padding: 10px 12px;
    }

    .mic-field__heading {
      align-items: start;
    }

    .mic-field__heading small {
      max-width: 130px;
      text-align: right;
    }

    .mic-waveform {
      min-height: 112px;
    }

    .mic-meters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mic-field__note {
      grid-column: 1 / -1;
    }

    .mic-meter small {
      display: none;
    }

    .mic-capture-pane,
    .mic-recording {
      padding: 10px 12px;
    }

    .mic-capture-pane {
      grid-template-columns: 1fr;
    }

    .mic-primary-actions,
    .mic-input-slot,
    .mic-details {
      grid-column: 1;
    }

    .mic-input-field {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .mic-recording__header {
      display: grid;
    }

    .mic-recording__header p {
      max-width: none;
      text-align: left;
    }

    .mic-details dl {
      grid-template-columns: 1fr;
    }
  }
</style>
