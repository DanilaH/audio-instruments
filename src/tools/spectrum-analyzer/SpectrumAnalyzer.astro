---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import SonicInstrument from "../../components/layout/SonicInstrument.astro";
---

<div data-spectrum-analyzer data-spectrum-state="idle">
  <SonicInstrument
    label="Spectrum Analyzer microphone frequency visualization"
    class="spectrum-sheet"
  >
    <div class="spectrum-sheet__bar">
      <ToolStatus id="spectrum-analyzer-status" label="Ready" state="idle" />
      <div class="spectrum-input-readout">
        <span>Input</span>
        <strong data-spectrum-active-input>No active input</strong>
      </div>
    </div>

    <section
      class="spectrum-field"
      aria-label="Live microphone analysis visualization"
    >
      <div class="spectrum-field__heading">
        <div>
          <span>Time / frequency field</span>
          <strong>Local browser-stream analysis</strong>
        </div>
        <span>Canvas data is live tool state</span>
      </div>

      <div class="spectrum-canvas-wrap">
        <canvas
          data-spectrum-canvas
          aria-label="Live microphone analysis visualization"></canvas>
        <div class="spectrum-canvas-meta" aria-hidden="true">
          <span>20 Hz</span>
          <span>Relative FFT energy</span>
          <span>Display max follows sample rate</span>
        </div>
      </div>

      <div class="spectrum-readout-strip">
        <div>
          <span>Dominant FFT bin</span>
          <strong data-spectrum-dominant>—</strong>
          <small>Strongest displayed bin ≥ 40 Hz · not pitch</small>
        </div>
        <div>
          <span>Processing rate</span>
          <strong data-spectrum-analysis-rate>Not active</strong>
          <small>Web Audio context rate</small>
        </div>
      </div>
    </section>

    <section class="spectrum-rail" aria-label="Spectrum Analyzer controls">
      <div class="spectrum-transport">
        <span class="spectrum-rail__label">Capture</span>
        <div>
          <button type="button" class="spectrum-start" data-spectrum-start>
            Start analyzer
          </button>
          <button
            type="button"
            class="spectrum-stop"
            data-spectrum-stop
            disabled
          >
            <span class="transport-stop-shape" aria-hidden="true"></span>
            Stop
          </button>
        </div>
      </div>

      <fieldset class="spectrum-view-fieldset">
        <legend>View</legend>
        <div
          class="spectrum-view-switch"
          role="group"
          aria-label="Analyzer view"
        >
          <button
            type="button"
            data-spectrum-view="spectrum"
            aria-pressed="true"
          >
            Spectrum
          </button>
          <button
            type="button"
            data-spectrum-view="waveform"
            aria-pressed="false"
          >
            Waveform
          </button>
          <button
            type="button"
            data-spectrum-view="spectrogram"
            aria-pressed="false"
          >
            Spectrogram
          </button>
        </div>
      </fieldset>

      <div class="spectrum-settings">
        <label class="spectrum-control-field">
          <span>FFT size</span>
          <select data-spectrum-fft aria-label="Spectrum FFT size">
            <option value="1024">1024</option>
            <option value="2048" selected>2048</option>
            <option value="4096">4096</option>
            <option value="8192">8192</option>
          </select>
        </label>

        <div class="spectrum-input-slot">
          <label
            class="spectrum-control-field"
            data-spectrum-input-field
            hidden
          >
            <span>Input device</span>
            <select
              data-spectrum-input
              aria-label="Spectrum Analyzer input device"></select>
          </label>
        </div>
        <div class="spectrum-selection-slot">
          <p
            class="spectrum-selection-error"
            data-spectrum-selection-error
            role="alert"
            hidden
          >
          </p>
        </div>
      </div>

      <dl class="spectrum-metrics" aria-label="Current analysis settings">
        <div>
          <dt>FFT</dt>
          <dd data-spectrum-fft-value>2048</dd>
        </div>
        <div>
          <dt>Smoothing</dt>
          <dd>0.8</dd>
        </div>
        <div>
          <dt>Bin width</dt>
          <dd data-spectrum-bin-width>—</dd>
        </div>
        <div>
          <dt>Display range</dt>
          <dd data-spectrum-range>20 Hz → —</dd>
        </div>
      </dl>
    </section>

    <div class="spectrum-state-strip">
      <strong>Local input</strong>
      <p>
        Microphone permission is requested only after Start. The live input is
        analyzed locally in the browser and is never connected to speaker
        output.
      </p>
    </div>

    <div class="spectrum-claim-note">
      <strong>Relative data</strong>
      <p>
        Frequency values are relative FFT-bin data from the browser stream. This
        tool does not measure calibrated frequency response, acoustic SPL, or
        musical pitch.
      </p>
    </div>

    <p class="spectrum-error" data-spectrum-error role="alert" hidden></p>
  </SonicInstrument>
</div>

<script>
  import { SpectrumAnalyzerController } from "./SpectrumAnalyzerController";

  const root = document.querySelector<HTMLElement>("[data-spectrum-analyzer]");
  let controller: SpectrumAnalyzerController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new SpectrumAnalyzerController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .spectrum-sheet__bar {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 6px 18px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .spectrum-input-readout {
    display: grid;
    justify-items: end;
    gap: 1px;
    min-width: 0;
    text-align: right;
  }

  .spectrum-input-readout span,
  .spectrum-field__heading > div > span,
  .spectrum-rail__label,
  .spectrum-view-fieldset legend,
  .spectrum-control-field > span,
  .spectrum-readout-strip span {
    color: var(--sonic-muted);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .spectrum-input-readout strong {
    max-width: 300px;
    overflow: hidden;
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .spectrum-field {
    display: grid;
    gap: 9px;
    min-height: 326px;
    padding: 14px 18px 12px;
    border-bottom: 1px solid var(--sonic-border);
    background: var(--sonic-field);
  }

  .spectrum-field__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
  }

  .spectrum-field__heading > div {
    display: grid;
    gap: 2px;
  }

  .spectrum-field__heading strong {
    font-size: 0.88rem;
  }

  .spectrum-field__heading > span {
    color: var(--sonic-muted);
    font-size: 0.7rem;
  }

  .spectrum-canvas-wrap {
    position: relative;
    min-height: 220px;
    overflow: hidden;
    border: 1px solid var(--sonic-border);
    border-radius: 5px;
    background: #eef0e9;
  }

  .spectrum-canvas-wrap::before {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent calc(12.5% - 1px),
        rgb(24 56 65 / 0.055) 12.5%
      ),
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent calc(25% - 1px),
        rgb(24 56 65 / 0.045) 25%
      );
    content: "";
    pointer-events: none;
  }

  .spectrum-canvas-wrap canvas {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .spectrum-canvas-meta {
    position: absolute;
    z-index: 2;
    inset: auto 10px 7px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: rgb(24 52 59 / 0.58);
    font-size: 0.62rem;
    pointer-events: none;
  }

  .spectrum-readout-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--sonic-border-soft);
  }

  .spectrum-readout-strip > div {
    display: grid;
    gap: 2px;
    min-width: 0;
    padding: 8px 12px 0;
  }

  .spectrum-readout-strip > div + div {
    border-left: 1px solid var(--sonic-border-soft);
  }

  .spectrum-readout-strip strong {
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .spectrum-readout-strip small {
    overflow: hidden;
    color: var(--sonic-muted);
    font-size: 0.65rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .spectrum-rail {
    display: grid;
    grid-template-columns:
      minmax(190px, 0.7fr) minmax(250px, 0.9fr) minmax(250px, 1fr)
      minmax(260px, 1fr);
    min-height: 150px;
    align-items: stretch;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .spectrum-rail > * {
    min-width: 0;
    padding: 12px 14px;
  }

  .spectrum-rail > * + * {
    border-left: 1px solid var(--sonic-border-soft);
  }

  .spectrum-transport,
  .spectrum-settings {
    display: grid;
    align-content: start;
    gap: 7px;
  }

  .spectrum-transport > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .spectrum-start,
  .spectrum-stop,
  .spectrum-view-switch button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 10px;
    border: 1px solid var(--sonic-border);
    border-radius: 5px;
    background: transparent;
    color: var(--sonic-ink);
    font: inherit;
    font-size: 0.74rem;
    font-weight: 780;
    cursor: pointer;
  }

  .spectrum-start {
    border-color: var(--sonic-ink);
    background: var(--sonic-ink);
    color: var(--sonic-sheet);
  }

  .spectrum-view-fieldset {
    min-width: 0;
    margin: 0;
    padding: 12px 14px;
    border: 0;
  }

  .spectrum-view-fieldset legend {
    padding: 0;
  }

  .spectrum-view-switch {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
    margin-top: 7px;
  }

  .spectrum-view-switch button[aria-pressed="true"] {
    border-color: var(--sonic-signal);
    background: rgb(39 127 138 / 0.08);
    color: #155f68;
  }

  .transport-stop-shape {
    width: 9px;
    height: 9px;
    border-radius: 1px;
    background: currentColor;
  }

  .spectrum-control-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 8px;
  }

  .spectrum-control-field select {
    min-width: 0;
    min-height: 38px;
    padding: 0 28px 0 8px;
    border: 1px solid var(--sonic-border);
    border-radius: 4px;
    background: #f3f0e8;
    color: var(--sonic-ink);
    font: inherit;
    font-size: 0.74rem;
  }

  .spectrum-input-slot {
    min-height: 38px;
  }

  .spectrum-control-field[hidden] {
    display: none;
  }

  .spectrum-selection-slot {
    min-height: 20px;
  }

  .spectrum-selection-error,
  .spectrum-error {
    margin: 0;
    color: var(--sonic-opposing);
    font-size: 0.68rem;
    line-height: 1.3;
  }

  .spectrum-selection-error[hidden],
  .spectrum-error[hidden] {
    display: none;
  }

  .spectrum-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .spectrum-metrics > div {
    display: grid;
    align-content: center;
    gap: 2px;
    min-width: 0;
    padding: 9px 12px;
  }

  .spectrum-metrics > div:nth-child(odd) {
    border-right: 1px solid var(--sonic-border-soft);
  }

  .spectrum-metrics > div:nth-child(-n + 2) {
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .spectrum-metrics dt {
    color: var(--sonic-muted);
    font-size: 0.64rem;
    text-transform: uppercase;
  }

  .spectrum-metrics dd {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font-size: 0.76rem;
    font-weight: 760;
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .spectrum-state-strip,
  .spectrum-claim-note {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 12px;
    padding: 8px 18px;
  }

  .spectrum-state-strip {
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .spectrum-state-strip strong,
  .spectrum-claim-note strong {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .spectrum-state-strip strong {
    color: var(--sonic-signal);
  }

  .spectrum-claim-note strong {
    color: var(--sonic-current);
  }

  .spectrum-state-strip p,
  .spectrum-claim-note p {
    margin: 0;
    color: var(--sonic-muted);
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .spectrum-error {
    padding: 8px 18px;
  }

  button:disabled,
  select:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  @media (min-width: 981px) and (max-height: 920px) {
    .spectrum-sheet__bar {
      min-height: 44px;
      padding-block: 4px;
    }

    .spectrum-field {
      gap: 7px;
      min-height: 292px;
      padding-block: 10px 9px;
    }

    .spectrum-canvas-wrap {
      min-height: 196px;
    }

    .spectrum-rail {
      min-height: 142px;
    }

    .spectrum-state-strip,
    .spectrum-claim-note {
      padding-block: 6px;
    }
  }

  @media (max-width: 980px) {
    .spectrum-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .spectrum-rail > *:nth-child(3) {
      border-top: 1px solid var(--sonic-border-soft);
      border-left: 0;
    }

    .spectrum-rail > *:nth-child(4) {
      border-top: 1px solid var(--sonic-border-soft);
    }

    .spectrum-view-switch {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .spectrum-sheet__bar {
      padding-inline: 14px;
    }

    .spectrum-field {
      min-height: 286px;
      padding: 12px 14px 10px;
    }

    .spectrum-field__heading > span {
      display: none;
    }

    .spectrum-canvas-wrap {
      min-height: 210px;
    }

    .spectrum-canvas-meta {
      display: none;
    }

    .spectrum-readout-strip small {
      display: none;
    }

    .spectrum-rail {
      grid-template-columns: 1fr;
    }

    .spectrum-rail > * + *,
    .spectrum-rail > *:nth-child(3),
    .spectrum-rail > *:nth-child(4) {
      border-top: 1px solid var(--sonic-border-soft);
      border-left: 0;
    }

    .spectrum-view-switch {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .spectrum-state-strip,
    .spectrum-claim-note {
      grid-template-columns: 1fr;
      gap: 2px;
      padding-inline: 14px;
    }
  }

  @media (max-width: 380px) {
    .spectrum-input-readout span {
      display: none;
    }

    .spectrum-readout-strip {
      grid-template-columns: 1fr;
    }

    .spectrum-readout-strip > div + div {
      border-top: 1px solid var(--sonic-border-soft);
      border-left: 0;
    }

    .spectrum-transport > div {
      grid-template-columns: 1fr;
    }

    .spectrum-view-switch button {
      min-width: 0;
      padding-inline: 4px;
      font-size: 0.68rem;
    }
  }
</style>
