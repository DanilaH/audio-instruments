---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import InstrumentSurface from "../../components/layout/InstrumentSurface.astro";
---

<div data-spectrum-analyzer data-spectrum-state="idle">
  <InstrumentSurface
    label="Spectrum Analyzer microphone frequency visualization"
    accent="cyan"
  >
    <div class="spectrum-instrument">
      <section
        class="spectrum-monitor"
        aria-label="Live microphone analysis visualization"
      >
        <div class="spectrum-monitor__header">
          <ToolStatus
            id="spectrum-analyzer-status"
            label="Ready"
            state="idle"
          />
          <div class="spectrum-input-readout">
            <span>Input</span>
            <strong data-spectrum-active-input>No active input</strong>
          </div>
        </div>

        <div class="spectrum-canvas-wrap">
          <canvas
            data-spectrum-canvas
            aria-label="Live microphone analysis visualization"></canvas>
          <div class="spectrum-canvas-meta" aria-hidden="true">
            <span>Browser-stream analysis</span>
            <span>Scale follows the selected view</span>
          </div>
        </div>

        <div class="spectrum-readouts">
          <div class="spectrum-readout">
            <span>Dominant FFT bin</span>
            <strong data-spectrum-dominant>—</strong>
            <small>Strongest displayed bin ≥ 40 Hz · not pitch</small>
          </div>
          <div class="spectrum-readout">
            <span>Processing rate</span>
            <strong data-spectrum-analysis-rate>Not active</strong>
            <small>Web Audio context rate</small>
          </div>
        </div>
      </section>

      <section
        class="spectrum-controls"
        aria-label="Spectrum Analyzer controls"
      >
        <div class="spectrum-permission">
          <i class="ph ph-microphone" aria-hidden="true"></i>
          <div>
            <strong>Microphone permission is requested only after Start.</strong
            >
            <p>
              The live input is analyzed locally in the browser. No microphone
              branch is connected to speaker output.
            </p>
          </div>
        </div>

        <div class="spectrum-primary-actions">
          <button type="button" class="spectrum-start" data-spectrum-start>
            <i class="ph ph-waveform" aria-hidden="true"></i>
            Start analyzer
          </button>
          <button
            type="button"
            class="spectrum-stop"
            data-spectrum-stop
            disabled
          >
            <i class="ph ph-stop" aria-hidden="true"></i>
            Stop
          </button>
        </div>

        <fieldset class="spectrum-view-fieldset">
          <legend>View</legend>
          <div
            class="spectrum-view-switch"
            role="group"
            aria-label="Analyzer view"
          >
            <button
              type="button"
              data-spectrum-view="spectrum"
              aria-pressed="true"
            >
              Spectrum
            </button>
            <button
              type="button"
              data-spectrum-view="waveform"
              aria-pressed="false"
            >
              Waveform
            </button>
            <button
              type="button"
              data-spectrum-view="spectrogram"
              aria-pressed="false"
            >
              Spectrogram
            </button>
          </div>
        </fieldset>

        <label class="spectrum-field">
          <span>FFT size</span>
          <select data-spectrum-fft aria-label="Spectrum FFT size">
            <option value="1024">1024</option>
            <option value="2048" selected>2048</option>
            <option value="4096">4096</option>
            <option value="8192">8192</option>
          </select>
        </label>

        <label class="spectrum-field" data-spectrum-input-field hidden>
          <span>Input device</span>
          <select
            data-spectrum-input
            aria-label="Spectrum Analyzer input device"></select>
        </label>
        <p
          class="spectrum-selection-error"
          data-spectrum-selection-error
          role="alert"
          hidden
        >
        </p>

        <dl class="spectrum-details" aria-label="Current analysis settings">
          <div>
            <dt>FFT</dt>
            <dd data-spectrum-fft-value>2048</dd>
          </div>
          <div>
            <dt>Smoothing</dt>
            <dd>0.8</dd>
          </div>
          <div>
            <dt>Bin width</dt>
            <dd data-spectrum-bin-width>—</dd>
          </div>
          <div>
            <dt>Display range</dt>
            <dd data-spectrum-range>20 Hz → —</dd>
          </div>
        </dl>

        <div class="spectrum-claim-note">
          <i class="ph ph-info" aria-hidden="true"></i>
          <p>
            Frequency values are relative FFT-bin data from the browser stream.
            This tool does not measure calibrated frequency response, acoustic
            SPL, or musical pitch.
          </p>
        </div>

        <p class="spectrum-error" data-spectrum-error role="alert" hidden></p>
      </section>
    </div>
  </InstrumentSurface>
</div>

<script>
  import { SpectrumAnalyzerController } from "./SpectrumAnalyzerController";

  const root = document.querySelector<HTMLElement>("[data-spectrum-analyzer]");
  let controller: SpectrumAnalyzerController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new SpectrumAnalyzerController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .spectrum-instrument {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(380px, 0.82fr);
    min-height: 500px;
  }

  .spectrum-monitor,
  .spectrum-controls {
    min-width: 0;
    padding: clamp(20px, 2.5vw, 30px);
  }

  .spectrum-monitor {
    display: grid;
    grid-template-rows: auto minmax(250px, 1fr) auto;
    gap: 14px;
    border-right: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 28% 24%,
        rgb(89 211 230 / 0.16),
        transparent 34%
      ),
      radial-gradient(
        circle at 78% 72%,
        rgb(143 124 255 / 0.12),
        transparent 36%
      ),
      linear-gradient(145deg, rgb(250 254 255 / 0.98), rgb(239 248 251 / 0.9));
  }

  .spectrum-monitor__header,
  .spectrum-primary-actions,
  .spectrum-view-switch {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .spectrum-monitor__header {
    justify-content: space-between;
  }

  .spectrum-input-readout {
    display: grid;
    justify-items: end;
    gap: 2px;
    text-align: right;
  }

  .spectrum-input-readout span,
  .spectrum-readout span,
  .spectrum-field > span,
  .spectrum-view-fieldset legend {
    color: var(--color-ink-muted);
    font-size: 0.72rem;
    font-weight: 780;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .spectrum-input-readout strong {
    max-width: 250px;
    overflow: hidden;
    font-size: 0.86rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .spectrum-canvas-wrap {
    position: relative;
    min-height: 270px;
    overflow: hidden;
    border: 1px solid rgb(30 83 92 / 0.12);
    border-radius: 24px;
    background:
      linear-gradient(rgb(255 255 255 / 0.72), rgb(246 252 253 / 0.68)),
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent 39px,
        rgb(31 88 97 / 0.025) 40px
      );
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.54);
  }

  .spectrum-canvas-wrap canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .spectrum-canvas-meta {
    position: absolute;
    inset: auto 12px 10px 12px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: rgb(40 54 60 / 0.48);
    font-size: 0.66rem;
    font-weight: 700;
    pointer-events: none;
  }

  .spectrum-readouts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .spectrum-readout {
    display: grid;
    gap: 4px;
    padding: 11px 13px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: rgb(255 255 255 / 0.68);
  }

  .spectrum-readout strong {
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    font-variant-numeric: tabular-nums;
  }

  .spectrum-readout small,
  .spectrum-permission p,
  .spectrum-claim-note p,
  .spectrum-selection-error,
  .spectrum-error {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .spectrum-controls {
    display: grid;
    align-content: start;
    gap: 13px;
  }

  .spectrum-permission,
  .spectrum-claim-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 11px 12px;
    border-radius: var(--radius-control);
    background: rgb(89 211 230 / 0.11);
  }

  .spectrum-permission strong {
    display: block;
    margin-bottom: 3px;
    font-size: 0.82rem;
  }

  .spectrum-primary-actions {
    justify-content: flex-start;
  }

  .spectrum-start,
  .spectrum-stop,
  .spectrum-view-switch button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 14px;
    border-radius: var(--radius-button);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }

  .spectrum-start {
    min-height: 46px;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .spectrum-stop,
  .spectrum-view-switch button {
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .spectrum-view-switch button[aria-pressed="true"] {
    border-color: rgb(24 125 142 / 0.48);
    background: rgb(89 211 230 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(24 125 142 / 0.08);
  }

  button:disabled,
  select:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .spectrum-view-fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .spectrum-view-fieldset legend {
    margin-bottom: 7px;
  }

  .spectrum-view-switch {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .spectrum-view-switch button {
    min-width: 0;
    padding-inline: 8px;
  }

  .spectrum-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }

  .spectrum-field[hidden],
  .spectrum-selection-error[hidden],
  .spectrum-error[hidden] {
    display: none;
  }

  .spectrum-field select {
    min-width: 0;
    min-height: 42px;
    padding: 0 34px 0 11px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }

  .spectrum-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-border);
  }

  .spectrum-details > div {
    display: grid;
    gap: 3px;
    padding: 9px 10px;
    background: var(--color-surface);
  }

  .spectrum-details dt {
    color: var(--color-ink-muted);
    font-size: 0.68rem;
  }

  .spectrum-details dd {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 760;
    font-variant-numeric: tabular-nums;
  }

  .spectrum-selection-error,
  .spectrum-error {
    color: var(--color-danger, #9a3434);
  }

  @media (max-width: 900px) {
    .spectrum-instrument {
      grid-template-columns: 1fr;
    }

    .spectrum-controls {
      order: -1;
      border-bottom: 1px solid var(--color-border);
    }

    .spectrum-monitor {
      border-right: 0;
    }
  }

  @media (max-width: 560px) {
    .spectrum-monitor,
    .spectrum-controls {
      padding: 16px;
    }

    .spectrum-primary-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .spectrum-start,
    .spectrum-stop {
      width: 100%;
      padding-inline: 8px;
    }

    .spectrum-canvas-wrap {
      min-height: 220px;
    }

    .spectrum-readouts {
      grid-template-columns: 1fr;
    }

    .spectrum-readout small {
      display: none;
    }

    .spectrum-field {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .spectrum-view-switch button {
      min-height: 44px;
      padding-inline: 4px;
      font-size: 0.72rem;
    }

    .spectrum-canvas-meta {
      display: none;
    }
  }

  @media (max-width: 340px) {
    .spectrum-view-switch button {
      padding-inline: 0;
      font-size: 0.68rem;
      letter-spacing: -0.01em;
    }
  }
</style>
