---
import FrequencyControl from "../../components/controls/FrequencyControl.astro";
import LevelControl from "../../components/controls/LevelControl.astro";
import CapabilityNotice from "../../components/feedback/CapabilityNotice.astro";
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import InstrumentSurface from "../../components/layout/InstrumentSurface.astro";
import {
  BASS_PRESET_FREQUENCIES_HZ,
  BASS_SINGLE_TONE_DEFAULT_HZ,
  BASS_SWEEP_DEFAULT_HIGH_HZ,
  BASS_SWEEP_DEFAULT_LOW_HZ,
  BASS_SWEEP_MAX_HZ,
  BASS_SWEEP_MIN_HZ,
} from "../../browser/audio-output/referenceSignals";
---

<div data-bass-test data-bass-mode="tone" data-bass-visual="idle">
  <InstrumentSurface
    label="Bass Test controls and low-frequency visualization"
    accent="mint"
  >
    <div class="bass-instrument">
      <section class="bass-visual" aria-label="Bass playback visualization">
        <div class="bass-visual__header">
          <ToolStatus id="bass-status" label="Ready" state="idle" />
          <div class="bass-readout">
            <strong
              ><span data-bass-frequency-readout
                >{BASS_SINGLE_TONE_DEFAULT_HZ}</span
              >
              Hz</strong
            >
            <span data-bass-visual-label>Single tone</span>
          </div>
        </div>

        <div class="bass-driver" aria-hidden="true">
          <span class="bass-driver__frame"></span>
          <span class="bass-driver__cone"></span>
          <span class="bass-driver__cap"></span>
          <span class="bass-driver__wave bass-driver__wave--one"></span>
          <span class="bass-driver__wave bass-driver__wave--two"></span>
          <span class="bass-driver__wave bass-driver__wave--three"></span>
        </div>

        <div class="bass-scale" aria-hidden="true">
          <span>20</span>
          <span>40</span>
          <span>80</span>
          <span>120</span>
          <span>200 Hz</span>
        </div>
        <p class="bass-visual__note">
          Stylized playback visual. The numeric readout is the
          requested/generated digital frequency; the animation is not measured
          speaker motion or frequency response.
        </p>
      </section>

      <section class="bass-controls" aria-label="Bass Test settings">
        <div class="bass-safety">
          <i class="ph ph-speaker-low" aria-hidden="true"></i>
          <div>
            <p>
              Start with your device/headphone volume low. Increase it only to a
              comfortable listening level. Do not turn the volume up to
              compensate for a tone you cannot hear.
            </p>
            <strong>
              Keep playback volume moderate. If you cannot hear a low tone, do
              not turn the system volume up to compensate.
            </strong>
          </div>
        </div>

        <div class="bass-mode-selector" aria-label="Bass Test mode">
          <button type="button" data-bass-mode="tone" aria-pressed="true"
            >Single tone</button
          >
          <button type="button" data-bass-mode="sweep" aria-pressed="false"
            >Slow sweep</button
          >
          <button type="button" data-bass-mode="sequence" aria-pressed="false"
            >Preset sequence</button
          >
        </div>

        <div class="bass-panel" data-bass-panel="tone">
          <FrequencyControl
            id="bass-frequency"
            valueHz={BASS_SINGLE_TONE_DEFAULT_HZ}
            minHz={BASS_SWEEP_MIN_HZ}
            maxHz={BASS_SWEEP_MAX_HZ}
          />
          <div class="bass-presets" aria-label="Bass frequency presets">
            {
              BASS_PRESET_FREQUENCIES_HZ.map((frequency) => (
                <button type="button" data-bass-preset={frequency}>
                  {frequency}
                  <span class="sr-only"> Hz</span>
                </button>
              ))
            }
          </div>
          <button type="button" class="bass-primary" data-bass-tone-play>
            <i class="ph ph-play" aria-hidden="true"></i>
            Play selected tone
          </button>
        </div>

        <div class="bass-panel" data-bass-panel="sweep" hidden>
          <div class="bass-panel__summary">
            <div>
              <strong data-bass-sweep-range
                >{BASS_SWEEP_DEFAULT_LOW_HZ} → {BASS_SWEEP_DEFAULT_HIGH_HZ} Hz</strong
              >
              <span>12 seconds · logarithmic</span>
            </div>
            <p>
              Slowly move through the core low-frequency range to listen for
              rattles or resonant spots.
            </p>
          </div>
          <button type="button" class="bass-primary" data-bass-sweep-play>
            <i class="ph ph-wave-sine" aria-hidden="true"></i>
            Run slow sweep
          </button>
        </div>

        <div class="bass-panel" data-bass-panel="sequence" hidden>
          <div class="bass-panel__summary">
            <div>
              <strong>{BASS_PRESET_FREQUENCIES_HZ.join(" · ")} Hz</strong>
              <span>800 ms each · 300 ms gaps</span>
            </div>
            <p>
              Step through the exact reference presets with silence between
              tones.
            </p>
          </div>
          <button type="button" class="bass-primary" data-bass-sequence-play>
            <i class="ph ph-list-numbers" aria-hidden="true"></i>
            Run preset sequence
          </button>
        </div>

        <div class="bass-footer">
          <LevelControl id="bass-level" valueDb={-24} minDb={-60} maxDb={-12} />
          <button type="button" class="bass-stop" data-bass-stop disabled>
            <i class="ph ph-stop" aria-hidden="true"></i>
            Stop
          </button>
        </div>

        <CapabilityNotice id="bass-frequency-cap" />
        <p class="bass-error" data-bass-error role="alert" hidden></p>
      </section>
    </div>
  </InstrumentSurface>
</div>

<script>
  import { BassTestController } from "./BassTestController";

  const root = document.querySelector<HTMLElement>("[data-bass-test]");
  let controller: BassTestController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new BassTestController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .bass-instrument {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(430px, 1.1fr);
    min-height: 450px;
  }

  .bass-visual,
  .bass-controls {
    min-width: 0;
    padding: clamp(20px, 2.6vw, 30px);
  }

  .bass-visual {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    border-right: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 50% 48%,
        rgb(119 199 164 / 0.22),
        transparent 35%
      ),
      linear-gradient(145deg, rgb(255 253 252 / 0.94), rgb(240 250 246 / 0.9));
  }

  .bass-visual__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .bass-readout {
    display: grid;
    justify-items: end;
    gap: 2px;
    text-align: right;
  }

  .bass-readout strong {
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    line-height: 1;
  }

  .bass-readout > span,
  .bass-visual__note,
  .bass-panel__summary span,
  .bass-panel__summary p {
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .bass-driver {
    position: relative;
    width: min(220px, 62%);
    aspect-ratio: 1;
    align-self: center;
    justify-self: center;
  }

  .bass-driver__frame,
  .bass-driver__cone,
  .bass-driver__cap,
  .bass-driver__wave {
    position: absolute;
    border-radius: 50%;
  }

  .bass-driver__frame {
    inset: 5%;
    border: 12px solid rgb(39 73 61 / 0.11);
    background: rgb(255 255 255 / 0.72);
    box-shadow:
      inset 0 0 0 1px rgb(39 73 61 / 0.08),
      0 18px 44px rgb(39 73 61 / 0.08);
  }

  .bass-driver__cone {
    inset: 23%;
    border: 1px solid rgb(39 73 61 / 0.12);
    background: radial-gradient(circle at 42% 38%, #73958a, #263f37 70%);
  }

  .bass-driver__cap {
    inset: 41%;
    background: #182a24;
    box-shadow: 0 4px 16px rgb(18 40 32 / 0.24);
  }

  .bass-driver__wave {
    inset: 0;
    border: 1px solid rgb(56 138 105 / 0.22);
    opacity: 0;
  }

  [data-bass-visual="tone"] .bass-driver__cone,
  [data-bass-visual="sequence"] .bass-driver__cone {
    animation: bass-pulse 0.68s ease-in-out infinite alternate;
  }

  [data-bass-visual="sweep"] .bass-driver__cone {
    animation: bass-sweep-pulse 1.4s ease-in-out infinite alternate;
  }

  [data-bass-visual="tone"] .bass-driver__wave,
  [data-bass-visual="sequence"] .bass-driver__wave,
  [data-bass-visual="sweep"] .bass-driver__wave {
    animation: bass-wave 1.5s ease-out infinite;
  }

  .bass-driver__wave--two {
    animation-delay: 0.35s !important;
  }

  .bass-driver__wave--three {
    animation-delay: 0.7s !important;
  }

  @keyframes bass-pulse {
    from {
      transform: scale(0.97);
    }
    to {
      transform: scale(1.035);
    }
  }

  @keyframes bass-sweep-pulse {
    from {
      transform: scale(0.95);
    }
    to {
      transform: scale(1.05);
    }
  }

  @keyframes bass-wave {
    0% {
      opacity: 0.36;
      transform: scale(0.72);
    }
    100% {
      opacity: 0;
      transform: scale(1.12);
    }
  }

  .bass-scale {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    margin-top: 2px;
    padding-top: 9px;
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-muted);
    font-size: 0.68rem;
  }

  .bass-scale span:last-child {
    text-align: right;
  }

  .bass-scale span:not(:first-child):not(:last-child) {
    text-align: center;
  }

  .bass-visual__note {
    max-width: 480px;
    margin: 8px 0 0;
  }

  .bass-controls {
    display: grid;
    align-content: start;
    gap: 10px;
    background: rgb(255 253 252 / 0.78);
  }

  .bass-safety {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 9px;
    padding: 10px 12px;
    border-radius: var(--radius-control);
    background: rgb(255 215 106 / 0.18);
  }

  .bass-safety p,
  .bass-safety strong,
  .bass-error {
    margin: 0;
    font-size: 0.77rem;
    line-height: 1.42;
  }

  .bass-safety div {
    display: grid;
    gap: 4px;
  }

  .bass-safety strong {
    font-weight: 760;
  }

  .bass-mode-selector {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 5px;
    padding: 5px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: rgb(31 36 48 / 0.035);
  }

  .bass-mode-selector button {
    min-height: 42px;
    padding: 0 9px;
    border: 0;
    border-radius: calc(var(--radius-button) - 5px);
    background: transparent;
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
  }

  .bass-mode-selector button[aria-pressed="true"] {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 4px 14px rgb(31 36 48 / 0.07);
  }

  .bass-panel {
    display: grid;
    gap: 9px;
    min-height: 181px;
  }

  .bass-panel[hidden],
  .bass-error[hidden] {
    display: none;
  }

  .bass-presets {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 5px;
  }

  .bass-presets button {
    min-height: 38px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink-muted);
    font-weight: 760;
    cursor: pointer;
  }

  .bass-panel__summary {
    display: grid;
    gap: 10px;
    padding: 13px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
  }

  .bass-panel__summary > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  .bass-panel__summary p {
    margin: 0;
  }

  .bass-primary,
  .bass-stop {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--radius-button);
    font-weight: 800;
    cursor: pointer;
  }

  .bass-primary {
    border: 0;
    padding: 0 16px;
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .bass-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 118px;
    align-items: end;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
  }

  .bass-stop {
    min-height: 48px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-ink);
  }

  button:disabled,
  input:disabled {
    cursor: not-allowed;
    opacity: 0.48;
  }

  .bass-error {
    padding: 10px 12px;
    border-radius: var(--radius-control);
    background: rgb(155 47 47 / 0.08);
    color: #7f2929;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 931px) and (max-height: 820px) {
    .bass-instrument {
      min-height: 390px;
    }

    .bass-visual,
    .bass-controls {
      padding: 16px 20px;
    }

    .bass-controls {
      gap: 7px;
    }

    .bass-safety {
      padding: 8px 10px;
    }

    .bass-safety p {
      font-size: 0.72rem;
      line-height: 1.32;
    }

    .bass-safety strong {
      display: none;
    }

    .bass-panel {
      gap: 7px;
      min-height: 181px;
    }

    .bass-panel__summary {
      gap: 6px;
      padding: 9px 11px;
    }

    .bass-footer {
      gap: 8px;
      padding-top: 5px;
    }

    .bass-driver {
      width: min(170px, 54%);
    }
  }

  @media (max-width: 930px) {
    .bass-instrument {
      grid-template-columns: 1fr;
    }

    .bass-visual {
      min-height: 210px;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .bass-driver {
      width: min(132px, 38%);
    }
  }

  @media (max-width: 560px) {
    .bass-visual {
      min-height: 0;
      padding: 8px 16px;
    }

    .bass-controls {
      gap: 8px;
      padding: 8px 14px 12px;
    }

    .bass-driver,
    .bass-scale,
    .bass-visual__note,
    .bass-safety strong {
      display: none;
    }

    .bass-mode-selector {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .bass-mode-selector button {
      min-height: 44px;
      padding-inline: 4px;
      font-size: 0.71rem;
    }

    .bass-panel {
      min-height: 239px;
    }

    .bass-presets {
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 4px;
    }

    .bass-presets button {
      min-width: 0;
      min-height: 44px;
      padding-inline: 0;
      font-size: 0.72rem;
    }

    .bass-panel__summary > div {
      align-items: flex-start;
      flex-direction: column;
      gap: 2px;
    }

    .bass-footer {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bass-driver__cone,
    .bass-driver__wave {
      animation: none !important;
    }

    .bass-driver__wave {
      display: none;
    }
  }
</style>
