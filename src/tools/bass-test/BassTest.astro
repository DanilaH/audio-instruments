---
import FrequencyControl from "../../components/controls/FrequencyControl.astro";
import LevelControl from "../../components/controls/LevelControl.astro";
import CapabilityNotice from "../../components/feedback/CapabilityNotice.astro";
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import SonicInstrument from "../../components/layout/SonicInstrument.astro";
import {
  BASS_PRESET_FREQUENCIES_HZ,
  BASS_SINGLE_TONE_DEFAULT_HZ,
  BASS_SWEEP_DEFAULT_HIGH_HZ,
  BASS_SWEEP_DEFAULT_LOW_HZ,
  BASS_SWEEP_MAX_HZ,
  BASS_SWEEP_MIN_HZ,
} from "../../browser/audio-output/referenceSignals";
---

<div data-bass-test data-bass-mode="tone" data-bass-visual="idle">
  <SonicInstrument
    label="Bass Test controls and low-frequency visualization"
    class="bass-sheet"
  >
    <div class="bass-bar">
      <ToolStatus id="bass-status" label="Ready" state="idle" />
      <div class="bass-readout" aria-label="Generated frequency">
        <span>Generated frequency</span>
        <strong
          ><span data-bass-frequency-readout>{BASS_SINGLE_TONE_DEFAULT_HZ}</span
          > Hz</strong
        >
        <small data-bass-visual-label>Single tone</small>
      </div>
    </div>

    <section class="bass-field" aria-label="Bass playback visualization">
      <div class="bass-field__heading">
        <div>
          <span>Low-frequency reference</span>
          <strong>Generated signal state</strong>
        </div>
        <p>20–200 Hz nominal range</p>
      </div>

      <div class="bass-stage" aria-hidden="true">
        <div class="bass-stage__axis">
          <span>20</span><span>40</span><span>80</span><span>120</span><span
            >200 Hz</span
          >
        </div>
        <div class="bass-stage__track">
          <span class="bass-stage__band"></span>
          <span class="bass-stage__pulse bass-stage__pulse--one"></span>
          <span class="bass-stage__pulse bass-stage__pulse--two"></span>
          <span class="bass-stage__pulse bass-stage__pulse--three"></span>
          <span class="bass-stage__node"></span>
        </div>
      </div>

      <p class="bass-field__note">
        Reference visualization only. The numeric readout is the
        requested/generated digital frequency; it is not measured speaker
        motion, acoustic output, or frequency response.
      </p>
    </section>

    <section class="bass-rail" aria-label="Bass Test settings and transport">
      <div class="bass-modes">
        <span class="bass-rail__label">Mode</span>
        <button type="button" data-bass-mode="tone" aria-pressed="true"
          >Single tone</button
        >
        <button type="button" data-bass-mode="sweep" aria-pressed="false"
          >Slow sweep</button
        >
        <button type="button" data-bass-mode="sequence" aria-pressed="false"
          >Preset sequence</button
        >
      </div>

      <div class="bass-panel-slot">
        <div class="bass-panel" data-bass-panel="tone">
          <FrequencyControl
            id="bass-frequency"
            valueHz={BASS_SINGLE_TONE_DEFAULT_HZ}
            minHz={BASS_SWEEP_MIN_HZ}
            maxHz={BASS_SWEEP_MAX_HZ}
          />
          <div class="bass-presets" aria-label="Bass frequency presets">
            {
              BASS_PRESET_FREQUENCIES_HZ.map((frequency) => (
                <button type="button" data-bass-preset={frequency}>
                  {frequency}
                  <span class="sr-only"> Hz</span>
                </button>
              ))
            }
          </div>
          <button type="button" class="bass-primary" data-bass-tone-play>
            <i class="ph ph-play" aria-hidden="true"></i>
            Play selected tone
          </button>
        </div>

        <div class="bass-panel" data-bass-panel="sweep" hidden>
          <div class="bass-panel__summary">
            <div>
              <strong data-bass-sweep-range
                >{BASS_SWEEP_DEFAULT_LOW_HZ} → {BASS_SWEEP_DEFAULT_HIGH_HZ} Hz</strong
              >
              <span>12 seconds · logarithmic</span>
            </div>
            <p>
              Slowly move through the core low-frequency range to listen for
              rattles or resonant spots.
            </p>
          </div>
          <button type="button" class="bass-primary" data-bass-sweep-play>
            <i class="ph ph-wave-sine" aria-hidden="true"></i>
            Run slow sweep
          </button>
        </div>

        <div class="bass-panel" data-bass-panel="sequence" hidden>
          <div class="bass-panel__summary">
            <div>
              <strong>{BASS_PRESET_FREQUENCIES_HZ.join(" · ")} Hz</strong>
              <span>800 ms each · 300 ms gaps</span>
            </div>
            <p>
              Step through the exact reference presets with silence between
              tones.
            </p>
          </div>
          <button type="button" class="bass-primary" data-bass-sequence-play>
            <i class="ph ph-list-numbers" aria-hidden="true"></i>
            Run preset sequence
          </button>
        </div>
      </div>

      <div class="bass-utility">
        <span class="bass-rail__label">Output</span>
        <LevelControl id="bass-level" valueDb={-24} minDb={-60} maxDb={-12} />
        <button type="button" class="bass-stop" data-bass-stop disabled>
          <span class="transport-stop-shape" aria-hidden="true"></span>
          Stop
        </button>
      </div>
    </section>

    <div class="bass-state-strip bass-safety">
      <strong>Low volume</strong>
      <div>
        <p>
          Start with your device/headphone volume low. Increase it only to a
          comfortable listening level. Do not turn the volume up to compensate
          for a tone you cannot hear.
        </p>
      </div>
    </div>

    <div class="bass-feedback-slot">
      <CapabilityNotice id="bass-frequency-cap" />
      <p class="bass-error" data-bass-error role="alert" hidden></p>
    </div>
  </SonicInstrument>
</div>

<script>
  import { BassTestController } from "./BassTestController";

  const root = document.querySelector<HTMLElement>("[data-bass-test]");
  let controller: BassTestController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new BassTestController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .bass-bar {
    display: flex;
    min-height: 54px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 8px 18px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .bass-readout {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 1px 10px;
    text-align: right;
  }

  .bass-readout > span,
  .bass-field__heading span,
  .bass-rail__label {
    color: var(--sonic-muted);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .bass-readout > span {
    grid-row: 1 / 3;
    align-self: center;
  }

  .bass-readout strong {
    font-size: 1.12rem;
    line-height: 1;
  }

  .bass-readout small {
    color: var(--sonic-muted);
    font-size: 0.68rem;
  }

  .bass-field {
    display: grid;
    grid-template-rows: auto minmax(104px, 1fr) auto;
    gap: 7px;
    min-height: 218px;
    padding: 14px 20px 10px;
    border-bottom: 1px solid var(--sonic-border);
    background: var(--sonic-field);
  }

  .bass-field__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
  }

  .bass-field__heading > div {
    display: grid;
    gap: 2px;
  }

  .bass-field__heading strong {
    font-size: 0.88rem;
  }

  .bass-field__heading p,
  .bass-field__note {
    margin: 0;
    color: var(--sonic-muted);
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .bass-stage {
    display: grid;
    align-content: center;
    width: min(100%, 820px);
    margin-inline: auto;
  }

  .bass-stage__axis {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin-bottom: 7px;
    color: var(--sonic-muted);
    font-size: 0.66rem;
  }

  .bass-stage__axis span:last-child {
    text-align: right;
  }

  .bass-stage__axis span:not(:first-child):not(:last-child) {
    text-align: center;
  }

  .bass-stage__track {
    position: relative;
    height: 70px;
    border-top: 1px solid var(--sonic-border);
    border-bottom: 1px solid var(--sonic-border);
    background:
      linear-gradient(
        90deg,
        transparent 24.8%,
        rgb(24 52 59 / 0.08) 25%,
        transparent 25.2%
      ),
      linear-gradient(
        90deg,
        transparent 49.8%,
        rgb(24 52 59 / 0.08) 50%,
        transparent 50.2%
      ),
      linear-gradient(
        90deg,
        transparent 74.8%,
        rgb(24 52 59 / 0.08) 75%,
        transparent 75.2%
      );
  }

  .bass-stage__band {
    position: absolute;
    top: 50%;
    left: 4%;
    width: 92%;
    height: 2px;
    background: var(--sonic-border);
    transform: translateY(-50%);
  }

  .bass-stage__node {
    position: absolute;
    top: 50%;
    left: 28%;
    width: 22px;
    height: 22px;
    border: 4px solid var(--sonic-sheet);
    border-radius: 50%;
    background: var(--sonic-signal);
    box-shadow: 0 0 0 1px var(--sonic-signal);
    transform: translate(-50%, -50%);
  }

  .bass-stage__pulse {
    position: absolute;
    top: 50%;
    left: 28%;
    width: 30px;
    height: 30px;
    border: 1px solid var(--sonic-signal);
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%);
  }

  [data-bass-visual="tone"] .bass-stage__pulse,
  [data-bass-visual="sweep"] .bass-stage__pulse,
  [data-bass-visual="sequence"] .bass-stage__pulse {
    animation: bass-reference-pulse 1.6s ease-out infinite;
  }

  .bass-stage__pulse--two {
    animation-delay: 0.42s !important;
  }

  .bass-stage__pulse--three {
    animation-delay: 0.84s !important;
  }

  [data-bass-visual="gap"] .bass-stage__node {
    opacity: 0.46;
  }

  @keyframes bass-reference-pulse {
    0% {
      opacity: 0.54;
      transform: translate(-50%, -50%) scale(0.8);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(2.35);
    }
  }

  .bass-field__note {
    text-align: center;
  }

  .bass-rail {
    display: grid;
    grid-template-columns: minmax(190px, 0.65fr) minmax(480px, 1.8fr) minmax(
        230px,
        0.8fr
      );
    min-height: 198px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .bass-rail > div {
    min-width: 0;
    padding: 11px 13px;
  }

  .bass-rail > div + div {
    border-left: 1px solid var(--sonic-border-soft);
  }

  .bass-modes,
  .bass-utility {
    display: grid;
    align-content: center;
    gap: 6px;
  }

  .bass-modes button,
  .bass-presets button,
  .bass-primary,
  .bass-stop {
    min-height: 44px;
    border: 1px solid var(--sonic-border);
    border-radius: var(--sonic-control-radius);
    background: transparent;
    color: var(--sonic-ink);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .bass-modes button {
    padding-inline: 10px;
    text-align: left;
  }

  .bass-modes button[aria-pressed="true"] {
    border-color: var(--sonic-signal);
    background: rgb(39 127 138 / 0.08);
    color: #0b6570;
  }

  .bass-panel-slot {
    display: grid;
    align-items: stretch;
  }

  .bass-panel {
    display: grid;
    align-content: center;
    gap: 7px;
    min-height: 176px;
  }

  .bass-panel[hidden],
  .bass-error[hidden] {
    display: none;
  }

  .bass-presets {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 5px;
  }

  .bass-presets button {
    min-width: 0;
    padding-inline: 2px;
    color: var(--sonic-muted);
    font-size: 0.74rem;
  }

  .bass-primary {
    min-height: 48px;
    border-color: var(--sonic-ink);
    background: var(--sonic-ink);
    color: var(--sonic-sheet);
  }

  .bass-primary i {
    margin-right: 7px;
  }

  .bass-panel__summary {
    display: grid;
    gap: 7px;
    padding: 10px 12px;
    border: 1px solid var(--sonic-border-soft);
    border-radius: var(--sonic-control-radius);
    background: rgb(243 240 232 / 0.62);
  }

  .bass-panel__summary > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  .bass-panel__summary span,
  .bass-panel__summary p {
    color: var(--sonic-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .bass-panel__summary p {
    margin: 0;
  }

  .bass-utility :global(.level-control) {
    gap: 5px;
  }

  .bass-stop {
    min-height: 48px;
    border-color: var(--sonic-ink);
  }

  .transport-stop-shape {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 7px;
    border-radius: 1px;
    background: currentColor;
  }

  .bass-state-strip {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 12px;
    padding: 8px 18px;
    color: var(--sonic-muted);
  }

  .bass-state-strip strong {
    color: var(--sonic-ink);
    font-size: 0.72rem;
  }

  .bass-state-strip div {
    display: grid;
    gap: 2px;
  }

  .bass-state-strip p,
  .bass-state-strip small {
    margin: 0;
    font-size: 0.69rem;
    line-height: 1.35;
  }

  .bass-feedback-slot:empty {
    display: none;
  }

  .bass-feedback-slot > :global(*) {
    margin: 8px 18px;
  }

  .bass-error {
    padding: 9px 11px;
    border: 1px solid rgb(149 80 59 / 0.28);
    border-radius: var(--sonic-control-radius);
    background: rgb(149 80 59 / 0.07);
    color: #773927;
    font-size: 0.76rem;
  }

  button:disabled,
  input:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 901px) and (max-height: 820px) {
    .bass-bar {
      min-height: 48px;
      padding-block: 6px;
    }

    .bass-field {
      grid-template-rows: auto 74px auto;
      min-height: 0;
      gap: 4px;
      padding: 8px 16px 6px;
    }

    .bass-stage__track {
      height: 48px;
    }

    .bass-rail {
      min-height: 194px;
    }

    .bass-rail > div {
      padding-block: 7px;
    }

    .bass-panel {
      min-height: 176px;
    }

    .bass-state-strip {
      padding-block: 6px;
    }
  }

  @media (max-width: 1040px) {
    .bass-rail {
      grid-template-columns: minmax(170px, 0.7fr) minmax(420px, 1.7fr) minmax(
          210px,
          0.8fr
        );
    }
  }

  @media (max-width: 900px) {
    .bass-field {
      min-height: 210px;
    }

    .bass-rail {
      grid-template-columns: 1fr 1fr;
    }

    .bass-panel-slot {
      grid-column: 1 / -1;
      grid-row: 2;
      border-top: 1px solid var(--sonic-border-soft);
    }

    .bass-rail > div + div {
      border-left: 0;
    }

    .bass-utility {
      border-left: 1px solid var(--sonic-border-soft) !important;
    }
  }

  @media (max-width: 560px) {
    .bass-bar {
      align-items: flex-start;
      padding: 8px 12px;
    }

    .bass-readout {
      grid-template-columns: 1fr;
      justify-items: end;
      gap: 1px;
    }

    .bass-readout > span {
      display: none;
    }

    .bass-field {
      grid-template-rows: auto 76px auto;
      min-height: 0;
      padding: 9px 12px 7px;
    }

    .bass-field__heading p {
      display: none;
    }

    .bass-stage__track {
      height: 48px;
    }

    .bass-field__note {
      text-align: left;
    }

    .bass-rail {
      grid-template-columns: 1fr;
    }

    .bass-rail > div {
      padding: 9px 11px;
    }

    .bass-modes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .bass-modes .bass-rail__label {
      grid-column: 1 / -1;
    }

    .bass-modes button {
      padding-inline: 4px;
      font-size: 0.72rem;
      text-align: center;
    }

    .bass-panel-slot {
      grid-column: auto;
      grid-row: auto;
      min-height: 237px;
      border-top: 1px solid var(--sonic-border-soft);
      border-bottom: 1px solid var(--sonic-border-soft);
    }

    .bass-panel {
      min-height: 237px;
    }

    .bass-utility {
      border-left: 0 !important;
    }

    .bass-presets {
      gap: 4px;
    }

    .bass-presets button {
      font-size: 0.7rem;
    }

    .bass-panel__summary > div {
      align-items: flex-start;
      flex-direction: column;
      gap: 2px;
    }

    .bass-state-strip {
      grid-template-columns: 1fr;
      gap: 3px;
      padding: 8px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bass-stage__pulse {
      animation: none !important;
      display: none;
    }
  }
</style>
