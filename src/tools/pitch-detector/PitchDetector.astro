---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import SonicInstrument from "../../components/layout/SonicInstrument.astro";
---

<div data-pitch-detector data-pitch-state="idle" data-pitch-result-state="idle">
  <SonicInstrument class="pitch-sheet" label="Pitch Detector monophonic tuner">
    <header class="pitch-bar">
      <ToolStatus id="pitch-detector-status" label="Ready" state="idle" />
      <div class="pitch-input-readout">
        <span>Input</span>
        <strong data-pitch-active-input>No active input</strong>
      </div>
    </header>

    <section class="pitch-field" aria-label="Live monophonic pitch estimate">
      <div class="pitch-field__heading">
        <div>
          <span>Monophonic YIN estimate</span>
          <strong>Note + cents relationship</strong>
        </div>
        <small>50–2000 Hz target · local analysis</small>
      </div>

      <div class="pitch-result">
        <p class="pitch-result__eyebrow">Detected note</p>
        <strong class="pitch-result__note" data-pitch-note>—</strong>
        <span class="pitch-result__frequency" data-pitch-frequency>—</span>
        <p class="pitch-result__message" data-pitch-message>
          Start the microphone and provide one steady monophonic tone.
        </p>
      </div>

      <div class="pitch-tuner" aria-label="Pitch cents deviation display">
        <div class="pitch-tuner__labels" aria-hidden="true">
          <span>−50</span>
          <span>−25</span>
          <strong>0</strong>
          <span>+25</span>
          <span>+50</span>
        </div>
        <div class="pitch-tuner__rail" aria-hidden="true">
          <span class="pitch-tuner__zone"></span>
          <span class="pitch-tuner__center"></span>
          <span class="pitch-tuner__needle" data-pitch-needle></span>
        </div>
        <strong class="pitch-tuner__cents" data-pitch-cents>—</strong>
      </div>

      <div class="pitch-readouts">
        <div>
          <span>YIN confidence</span>
          <strong data-pitch-confidence>—</strong>
        </div>
        <div>
          <span>Stability</span>
          <strong data-pitch-stability>Waiting</strong>
        </div>
      </div>
    </section>

    <section class="pitch-rail" aria-label="Pitch Detector controls">
      <div class="pitch-capture-pane">
        <div class="pitch-permission">
          <i class="ph ph-microphone" aria-hidden="true"></i>
          <div>
            <strong>Permission is requested only after Start.</strong>
            <p>
              Audio is analyzed locally in the browser and is never connected to
              speaker output.
            </p>
          </div>
        </div>

        <div class="pitch-primary-actions">
          <button type="button" class="pitch-start" data-pitch-start>
            <i class="ph ph-wave-sine" aria-hidden="true"></i>
            Start detector
          </button>
          <button type="button" class="pitch-stop" data-pitch-stop disabled>
            <span class="transport-stop-shape" aria-hidden="true"></span>
            Stop
          </button>
        </div>

        <div class="pitch-input-slot">
          <label class="pitch-control-field" data-pitch-input-field hidden>
            <span>Input device</span>
            <select data-pitch-input aria-label="Pitch Detector input device"></select>
          </label>
          <p
            class="pitch-selection-error"
            data-pitch-selection-error
            role="alert"
            hidden
          ></p>
        </div>
      </div>

      <dl class="pitch-details" aria-label="Pitch analysis settings">
        <div><dt>Target</dt><dd>50–2000 Hz</dd></div>
        <div><dt>Confidence floor</dt><dd>80%</dd></div>
        <div><dt>Analysis rate</dt><dd data-pitch-analysis-rate>Not active</dd></div>
        <div><dt>Downsample</dt><dd data-pitch-downsample>—</dd></div>
        <div class="pitch-details__wide"><dt>YIN frame</dt><dd data-pitch-frame-size>—</dd></div>
      </dl>
    </section>

    <div class="pitch-state-strip">
      <strong>Estimate limits</strong>
      <p>
        Pitch is estimated from a monophonic browser microphone signal. Weak,
        noisy, polyphonic or unstable input may produce no accepted result rather
        than a guessed note.
      </p>
    </div>

    <div class="pitch-feedback-slot">
      <p class="pitch-error" data-pitch-error role="alert" hidden></p>
    </div>
  </SonicInstrument>
</div>

<script>
  import { PitchDetectorController } from "./PitchDetectorController";

  const root = document.querySelector<HTMLElement>("[data-pitch-detector]");
  let controller: PitchDetectorController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new PitchDetectorController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .pitch-bar {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 18px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .pitch-input-readout {
    display: grid;
    justify-items: end;
    gap: 1px;
    min-width: 0;
    text-align: right;
  }

  .pitch-input-readout span,
  .pitch-field__heading span,
  .pitch-result__eyebrow,
  .pitch-readouts span,
  .pitch-control-field > span {
    color: var(--sonic-muted);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pitch-input-readout strong {
    max-width: min(38vw, 300px);
    overflow: hidden;
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pitch-field {
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1.28fr);
    grid-template-rows: auto minmax(150px, 1fr) auto;
    gap: 9px 16px;
    min-height: 278px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--sonic-border);
    background: var(--sonic-field);
  }

  .pitch-field__heading {
    grid-column: 1 / -1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .pitch-field__heading > div {
    display: grid;
    gap: 2px;
  }

  .pitch-field__heading strong { font-size: 0.9rem; }

  .pitch-field__heading small,
  .pitch-result__message,
  .pitch-permission p,
  .pitch-selection-error,
  .pitch-state-strip p,
  .pitch-error {
    margin: 0;
    color: var(--sonic-muted);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .pitch-result {
    display: grid;
    justify-items: center;
    align-content: center;
    min-height: 150px;
    padding: 14px;
    border: 1px solid var(--sonic-border);
    border-radius: var(--sonic-control-radius);
    background: rgb(243 240 232 / 0.5);
    text-align: center;
  }

  .pitch-result__eyebrow { margin: 0 0 4px; }

  .pitch-result__note {
    min-height: 1em;
    font-size: clamp(3.8rem, 8vw, 6.7rem);
    font-weight: 820;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .pitch-result__frequency {
    margin-top: 5px;
    color: #155f68;
    font-size: clamp(1.05rem, 2.4vw, 1.65rem);
    font-weight: 780;
    font-variant-numeric: tabular-nums;
  }

  .pitch-result__message {
    max-width: 390px;
    margin-top: 6px;
  }

  [data-pitch-result-state="stable"] .pitch-result {
    border-color: var(--sonic-signal);
    background: rgb(39 127 138 / 0.07);
  }

  .pitch-tuner {
    display: grid;
    align-content: center;
    gap: 8px;
  }

  .pitch-tuner__labels {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    color: var(--sonic-muted);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .pitch-tuner__rail {
    --pitch-offset: 0%;
    position: relative;
    height: 30px;
    overflow: hidden;
    border: 1px solid var(--sonic-border);
    border-radius: 4px;
    background:
      repeating-linear-gradient(90deg, transparent 0, transparent calc(25% - 1px), rgb(24 56 65 / 0.1) 25%),
      rgb(243 240 232 / 0.64);
  }

  .pitch-tuner__zone {
    position: absolute;
    inset: 5px 42%;
    border: 1px solid rgb(39 127 138 / 0.24);
    background: rgb(39 127 138 / 0.08);
  }

  .pitch-tuner__center {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 50%;
    width: 2px;
    background: var(--sonic-signal);
  }

  .pitch-tuner__needle {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: calc(50% + var(--pitch-offset, 0%));
    width: 4px;
    border-radius: 2px;
    background: var(--sonic-current);
    transform: translateX(-50%);
    transition: left 90ms linear;
  }

  .pitch-tuner__cents {
    justify-self: center;
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
  }

  .pitch-readouts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--sonic-border-soft);
  }

  .pitch-readouts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    min-width: 0;
    padding: 8px 10px 0;
  }

  .pitch-readouts > div + div { border-left: 1px solid var(--sonic-border-soft); }

  .pitch-readouts strong {
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .pitch-rail {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    min-height: 170px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .pitch-capture-pane {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    gap: 7px 10px;
    min-width: 0;
    padding: 11px 14px;
    border-right: 1px solid var(--sonic-border-soft);
  }

  .pitch-permission {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
  }

  .pitch-permission > i { margin-top: 2px; color: var(--sonic-signal); }

  .pitch-permission strong {
    display: block;
    margin-bottom: 2px;
    font-size: 0.76rem;
  }

  .pitch-primary-actions {
    display: grid;
    grid-template-columns: minmax(128px, 1fr) minmax(82px, 0.55fr);
    gap: 6px;
    align-self: start;
  }

  .pitch-start,
  .pitch-stop,
  .pitch-control-field select {
    min-height: 44px;
    border: 1px solid var(--sonic-border);
    border-radius: var(--sonic-control-radius);
    background: transparent;
    color: var(--sonic-ink);
    font: inherit;
  }

  .pitch-start,
  .pitch-stop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 11px;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
  }

  .pitch-start {
    border-color: var(--sonic-ink);
    background: var(--sonic-ink);
    color: var(--sonic-sheet);
  }

  .transport-stop-shape {
    display: inline-block;
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    border-radius: 1px;
    background: currentColor;
  }

  .pitch-input-slot {
    grid-column: 1 / -1;
    min-height: 50px;
  }

  .pitch-control-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 9px;
  }

  .pitch-control-field[hidden],
  .pitch-selection-error[hidden],
  .pitch-error[hidden] { display: none; }

  .pitch-control-field select {
    min-width: 0;
    padding: 0 10px;
    background: var(--sonic-control-bg);
  }

  .pitch-selection-error { padding-top: 4px; color: #773927; }

  .pitch-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .pitch-details > div {
    display: grid;
    align-content: center;
    gap: 2px;
    min-width: 0;
    padding: 9px 12px;
  }

  .pitch-details > div:nth-child(odd) { border-right: 1px solid var(--sonic-border-soft); }
  .pitch-details > div:nth-child(-n + 4) { border-bottom: 1px solid var(--sonic-border-soft); }
  .pitch-details__wide { grid-column: 1 / -1; }

  .pitch-details dt {
    color: var(--sonic-muted);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .pitch-details dd {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font-size: 0.76rem;
    font-weight: 760;
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pitch-state-strip {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr);
    gap: 12px;
    padding: 8px 18px;
  }

  .pitch-state-strip strong {
    font-size: 0.72rem;
  }

  .pitch-feedback-slot:empty { display: none; }

  .pitch-error {
    margin: 0;
    padding: 8px 14px;
    border-top: 1px solid rgb(149 80 59 / 0.25);
    background: rgb(149 80 59 / 0.06);
    color: #773927;
  }

  button:disabled,
  select:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .pitch-tuner__needle { transition: none; }
  }

  @media (min-width: 901px) and (max-height: 820px) {
    .pitch-bar { min-height: 46px; padding-block: 5px; }
    .pitch-field { grid-template-rows: auto 126px auto; min-height: 0; padding-block: 8px; }
    .pitch-result { min-height: 126px; }
    .pitch-rail { min-height: 154px; }
    .pitch-capture-pane { padding-block: 8px; }
    .pitch-state-strip { padding-block: 6px; }
  }

  @media (max-width: 900px) {
    .pitch-field { grid-template-columns: minmax(210px, 0.75fr) minmax(0, 1.25fr); }
    .pitch-rail { grid-template-columns: 1fr; }
    .pitch-capture-pane {
      border-right: 0;
      border-bottom: 1px solid var(--sonic-border-soft);
    }
  }

  @media (max-width: 560px) {
    .pitch-bar { align-items: flex-start; padding: 7px 12px; }
    .pitch-input-readout strong { max-width: 48vw; }
    .pitch-field {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto;
      gap: 7px;
      min-height: 0;
      padding: 10px 12px;
    }
    .pitch-field__heading { grid-column: 1; align-items: start; }
    .pitch-field__heading small { max-width: 130px; text-align: right; }
    .pitch-result { min-height: 128px; padding: 10px; }
    .pitch-result__note { font-size: clamp(3.4rem, 18vw, 5.2rem); }
    .pitch-readouts { grid-column: 1; }
    .pitch-capture-pane { grid-template-columns: 1fr; padding: 10px 12px; }
    .pitch-primary-actions,
    .pitch-input-slot { grid-column: 1; }
    .pitch-control-field { grid-template-columns: 1fr; gap: 4px; }
    .pitch-details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pitch-state-strip { grid-template-columns: 1fr; gap: 3px; padding: 8px 12px; }
  }
</style>