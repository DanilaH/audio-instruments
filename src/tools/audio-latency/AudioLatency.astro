---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import InstrumentSurface from "../../components/layout/InstrumentSurface.astro";
import {
  AV_SYNC_OFFSET_MAX_MS,
  AV_SYNC_OFFSET_MIN_MS,
  AV_SYNC_OFFSET_STEP_MS,
} from "./avSyncTimeline";
---

<div data-audio-latency data-latency-state="idle">
  <InstrumentSurface
    label="Audio Latency browser metadata and manual audiovisual sync"
    accent="yellow"
  >
    <div class="latency-instrument">
      <section class="latency-stage" aria-label="Manual audiovisual sync">
        <div class="latency-stage__header">
          <ToolStatus id="audio-latency-status" label="Ready" state="idle" />
          <div class="latency-offset-summary">
            <span>Selected offset</span>
            <strong data-latency-offset-value>0 ms</strong>
          </div>
        </div>

        <div class="latency-pulse-zone">
          <div class="latency-pulse" data-latency-pulse aria-hidden="true">
            <span></span>
          </div>
          <div class="latency-pulse-copy">
            <strong>Visual pulse + audio click</strong>
            <span>One timing event every 1000 ms while active</span>
          </div>
        </div>

        <p class="latency-result" data-latency-result>
          Your selected sync offset: 0 ms
        </p>
        <p class="latency-stage__note">
          Adjust until the click and localized pulse feel synchronized to you. This
          is a perception-based setting, not a measurement of exact hardware,
          headphone or Bluetooth latency.
        </p>
      </section>

      <section class="latency-controls" aria-label="Audio Latency controls">
        <div class="latency-safety">
          <i class="ph ph-shield-check" aria-hidden="true"></i>
          <p>
            Start with your device/headphone volume low. Increase it only to a
            comfortable listening level. Do not turn the volume up to compensate
            for a tone you cannot hear.
          </p>
        </div>

        <div class="latency-reported" aria-labelledby="latency-reported-title">
          <div class="latency-section-heading">
            <div>
              <p class="latency-eyebrow">Browser-reported</p>
              <h3 id="latency-reported-title">Web Audio latency metadata</h3>
            </div>
            <i class="ph ph-browser" aria-hidden="true"></i>
          </div>

          <dl>
            <div>
              <dt>Base latency</dt>
              <dd data-latency-base>Start to query</dd>
            </div>
            <div>
              <dt>Output latency</dt>
              <dd data-latency-output>Start to query</dd>
            </div>
          </dl>
          <p>
            Values are browser-reported estimates shown in milliseconds. They are
            not exact end-to-end hardware latency.
          </p>
        </div>

        <div class="latency-offset-control">
          <div class="latency-field-header">
            <label for="audio-latency-offset">Manual sync offset</label>
            <output for="audio-latency-offset" data-latency-offset-value>0 ms</output>
          </div>
          <input
            id="audio-latency-offset"
            type="range"
            min={AV_SYNC_OFFSET_MIN_MS}
            max={AV_SYNC_OFFSET_MAX_MS}
            step={AV_SYNC_OFFSET_STEP_MS}
            value="0"
            data-latency-offset
          />
          <div class="latency-offset-control__bounds" aria-hidden="true">
            <span>−300 ms</span>
            <span>0</span>
            <span>+300 ms</span>
          </div>
          <p>
            Positive values place the audio click after the visual pulse. Negative
            values place the audio click before it. The 5 ms step is control
            granularity, not a ±5 ms accuracy claim.
          </p>
        </div>

        <div class="latency-actions">
          <button type="button" class="latency-start" data-latency-start>
            <i class="ph ph-play" aria-hidden="true"></i>
            Start sync loop
          </button>
          <button type="button" class="latency-stop" data-latency-stop disabled>
            <i class="ph ph-stop" aria-hidden="true"></i>
            Stop
          </button>
        </div>

        <p class="latency-error" data-latency-error role="alert" hidden></p>
      </section>
    </div>
  </InstrumentSurface>
</div>

<script>
  import { AudioLatencyController } from "./AudioLatencyController";

  const root = document.querySelector<HTMLElement>("[data-audio-latency]");
  let controller: AudioLatencyController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new AudioLatencyController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .latency-instrument {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(390px, 0.98fr);
    min-height: 520px;
  }

  .latency-stage,
  .latency-controls {
    min-width: 0;
    padding: clamp(20px, 2.6vw, 32px);
  }

  .latency-stage {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 18px;
    border-right: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 52% 48%, rgb(244 196 92 / 0.24), transparent 28%),
      linear-gradient(145deg, rgb(255 253 244 / 0.98), rgb(252 246 225 / 0.9));
  }

  .latency-stage__header,
  .latency-field-header,
  .latency-section-heading,
  .latency-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .latency-offset-summary {
    display: grid;
    justify-items: end;
    gap: 2px;
    text-align: right;
  }

  .latency-offset-summary span,
  .latency-stage__note,
  .latency-pulse-copy span,
  .latency-reported > p,
  .latency-offset-control > p {
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .latency-offset-summary strong {
    font-size: 1.25rem;
  }

  .latency-pulse-zone {
    display: grid;
    align-self: center;
    justify-items: center;
    gap: 22px;
    min-height: 260px;
    padding: 32px 18px;
  }

  .latency-pulse {
    display: grid;
    width: clamp(118px, 18vw, 170px);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(112 87 30 / 0.14);
    border-radius: 32px;
    background: rgb(255 255 255 / 0.62);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.8);
  }

  .latency-pulse span {
    width: 44%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgb(199 151 46 / 0.36);
    box-shadow: 0 0 0 12px rgb(199 151 46 / 0.07);
    opacity: 0.55;
    transition: opacity 70ms linear, background-color 70ms linear,
      box-shadow 70ms linear;
  }

  .latency-pulse[data-active="true"] span {
    background: rgb(199 151 46 / 0.95);
    box-shadow: 0 0 0 18px rgb(199 151 46 / 0.18);
    opacity: 1;
  }

  .latency-pulse-copy {
    display: grid;
    justify-items: center;
    gap: 5px;
    text-align: center;
  }

  .latency-pulse-copy strong {
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
  }

  .latency-result {
    margin: 0;
    padding: 13px 15px;
    border: 1px solid rgb(112 87 30 / 0.14);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.56);
    font-weight: 700;
  }

  .latency-stage__note {
    margin: 0;
  }

  .latency-controls {
    display: grid;
    align-content: start;
    gap: 18px;
  }

  .latency-safety {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 11px 13px;
    border: 1px solid rgb(199 151 46 / 0.18);
    border-radius: 14px;
    background: rgb(255 249 226 / 0.74);
  }

  .latency-safety i {
    margin-top: 2px;
    font-size: 1.05rem;
  }

  .latency-safety p,
  .latency-reported p,
  .latency-offset-control p {
    margin: 0;
  }

  .latency-safety p {
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .latency-reported,
  .latency-offset-control {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: rgb(255 255 255 / 0.58);
  }

  .latency-section-heading h3,
  .latency-section-heading p {
    margin: 0;
  }

  .latency-section-heading h3 {
    margin-top: 2px;
    font-size: 1rem;
  }

  .latency-section-heading > i {
    font-size: 1.25rem;
  }

  .latency-eyebrow {
    color: var(--color-ink-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .latency-reported dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 0;
  }

  .latency-reported dl > div {
    display: grid;
    gap: 4px;
    padding: 12px;
    border-radius: 12px;
    background: rgb(247 244 235 / 0.72);
  }

  .latency-reported dt {
    color: var(--color-ink-muted);
    font-size: 0.72rem;
  }

  .latency-reported dd {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .latency-field-header label {
    font-size: 0.86rem;
    font-weight: 700;
  }

  .latency-field-header output {
    font-weight: 700;
  }

  .latency-offset-control input[type="range"] {
    width: 100%;
    accent-color: rgb(183 132 20);
  }

  .latency-offset-control__bounds {
    display: flex;
    justify-content: space-between;
    color: var(--color-ink-muted);
    font-size: 0.68rem;
  }

  .latency-actions {
    justify-content: flex-start;
  }

  .latency-start,
  .latency-stop {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 18px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .latency-start {
    border-color: rgb(161 115 17 / 0.45);
    background: rgb(231 181 73);
    color: rgb(50 37 10);
  }

  .latency-stop {
    background: rgb(255 255 255 / 0.82);
    color: var(--color-ink);
  }

  .latency-start:disabled,
  .latency-stop:disabled {
    cursor: not-allowed;
    opacity: 0.46;
  }

  .latency-error {
    margin: 0;
    padding: 11px 13px;
    border: 1px solid rgb(176 68 57 / 0.28);
    border-radius: 12px;
    background: rgb(255 238 235 / 0.7);
    color: rgb(118 43 36);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .latency-instrument {
      grid-template-columns: 1fr;
    }

    .latency-stage {
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .latency-pulse-zone {
      min-height: 220px;
    }
  }

  @media (max-width: 520px) {
    .latency-stage,
    .latency-controls {
      padding: 18px;
    }

    .latency-stage__header {
      align-items: flex-start;
    }

    .latency-pulse-zone {
      min-height: 190px;
      padding: 18px 10px;
    }

    .latency-pulse {
      width: 118px;
      border-radius: 26px;
    }

    .latency-reported dl {
      grid-template-columns: 1fr;
    }

    .latency-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .latency-start,
    .latency-stop {
      width: 100%;
      padding-inline: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .latency-pulse span {
      transition: none;
    }
  }
</style>
