---
import {
  FREQUENCY_SWEEP_DEFAULT_DURATION_SECONDS,
  FREQUENCY_SWEEP_DEFAULT_HIGH_HZ,
  FREQUENCY_SWEEP_DEFAULT_LOW_HZ,
  FREQUENCY_SWEEP_MAX_DURATION_SECONDS,
  FREQUENCY_SWEEP_MAX_HZ,
  FREQUENCY_SWEEP_MIN_DURATION_SECONDS,
  FREQUENCY_SWEEP_MIN_HZ,
} from "../../browser/audio-output/referenceSignals";
import FrequencyControl from "../../components/controls/FrequencyControl.astro";
import LevelControl from "../../components/controls/LevelControl.astro";
import CapabilityNotice from "../../components/feedback/CapabilityNotice.astro";
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import SonicInstrument from "../../components/layout/SonicInstrument.astro";
---

<div
  data-frequency-sweep
  data-sweep-visual="idle"
  data-sweep-scale="logarithmic"
  data-sweep-direction="ascending"
  style={`--sweep-duration: ${FREQUENCY_SWEEP_DEFAULT_DURATION_SECONDS}s`}
>
  <SonicInstrument
    label="Frequency Sweep controls and scheduled sweep visualization"
    class="sweep-sheet"
  >
    <div class="sweep-sheet__bar">
      <ToolStatus id="frequency-sweep-status" label="Ready" state="idle" />
      <div class="sweep-sheet__state" aria-label="Scheduled sweep endpoints">
        <strong>
          <span data-sweep-from>20 Hz</span>
          <span aria-hidden="true">→</span>
          <span data-sweep-to>20 kHz</span>
        </strong>
        <span>
          <span data-sweep-duration-readout>15 s</span> ·
          <span data-sweep-scale-readout>Logarithmic</span>
        </span>
      </div>
    </div>

    <section class="sweep-field" aria-label="Frequency Sweep visualization">
      <div class="sweep-field__heading">
        <div>
          <span>Scheduled frequency path</span>
          <strong>Requested digital sweep</strong>
        </div>
        <span class="sweep-field__reference">20 Hz–20 kHz reference scale</span>
      </div>

      <div class="sweep-stage" aria-hidden="true">
        <svg
          class="sweep-curve"
          viewBox="0 0 100 42"
          preserveAspectRatio="none"
        >
          <path class="sweep-curve__grid" d="M0 35 H100 M0 22 H100 M0 9 H100"></path>
          <path
            class="sweep-curve__line sweep-curve__line--log"
            d="M1 36 C36 36 54 31 69 23 C82 16 91 8 99 4"></path>
          <path
            class="sweep-curve__line sweep-curve__line--linear"
            d="M1 36 L99 4"></path>
        </svg>
        <div class="sweep-progress-track">
          <span class="sweep-cursor"></span>
        </div>
        <div class="sweep-scale">
          <span>20</span>
          <span>100</span>
          <span>1k</span>
          <span>10k</span>
          <span>20k Hz</span>
        </div>
      </div>

      <p class="sweep-field__note">
        Stylized schedule visual. Endpoints, duration and cursor describe the
        requested/generated digital sweep; this page does not measure acoustic
        frequency response.
      </p>
    </section>

    <section class="sweep-rail" aria-label="Frequency Sweep settings">
      <div class="sweep-range-block">
        <span class="sweep-rail__label">Range</span>
        <div class="sweep-range-grid">
          <div data-sweep-low-control>
            <FrequencyControl
              id="frequency-sweep-low"
              label="Low frequency"
              valueHz={FREQUENCY_SWEEP_DEFAULT_LOW_HZ}
              minHz={FREQUENCY_SWEEP_MIN_HZ}
              maxHz={FREQUENCY_SWEEP_MAX_HZ}
            />
          </div>
          <div data-sweep-high-control>
            <FrequencyControl
              id="frequency-sweep-high"
              label="High frequency"
              valueHz={FREQUENCY_SWEEP_DEFAULT_HIGH_HZ}
              minHz={FREQUENCY_SWEEP_MIN_HZ}
              maxHz={FREQUENCY_SWEEP_MAX_HZ}
            />
          </div>
        </div>
      </div>

      <div class="sweep-shape-block">
        <span class="sweep-rail__label">Timing & path</span>
        <div class="sweep-duration">
          <div class="sweep-field-header">
            <label for="frequency-sweep-duration">Duration</label>
            <output
              id="frequency-sweep-duration-output"
              for="frequency-sweep-duration"
              >{FREQUENCY_SWEEP_DEFAULT_DURATION_SECONDS} s</output
            >
          </div>
          <input
            id="frequency-sweep-duration"
            type="range"
            min={FREQUENCY_SWEEP_MIN_DURATION_SECONDS}
            max={FREQUENCY_SWEEP_MAX_DURATION_SECONDS}
            step="1"
            value={FREQUENCY_SWEEP_DEFAULT_DURATION_SECONDS}
          />
          <div class="sweep-duration__bounds" aria-hidden="true">
            <span>{FREQUENCY_SWEEP_MIN_DURATION_SECONDS} s</span>
            <span>{FREQUENCY_SWEEP_MAX_DURATION_SECONDS} s</span>
          </div>
        </div>
        <div class="sweep-options">
          <fieldset>
            <legend>Scale</legend>
            <div class="sweep-selector">
              <button
                type="button"
                data-sweep-scale="linear"
                aria-pressed="false">Linear</button
              >
              <button
                type="button"
                data-sweep-scale="logarithmic"
                aria-pressed="true">Logarithmic</button
              >
            </div>
          </fieldset>
          <fieldset>
            <legend>Direction</legend>
            <div class="sweep-selector">
              <button
                type="button"
                data-sweep-direction="ascending"
                aria-pressed="true">Ascending</button
              >
              <button
                type="button"
                data-sweep-direction="descending"
                aria-pressed="false">Descending</button
              >
            </div>
          </fieldset>
        </div>
      </div>

      <div class="sweep-level-block">
        <span class="sweep-rail__label">Level</span>
        <LevelControl
          id="frequency-sweep-level"
          valueDb={-24}
          minDb={-60}
          maxDb={-12}
        />
      </div>

      <div class="sweep-transport-block">
        <span class="sweep-rail__label">Transport</span>
        <button type="button" class="sweep-play" data-sweep-play>
          <i class="ph ph-play" aria-hidden="true"></i>
          Play sweep
        </button>
        <button type="button" class="sweep-stop" data-sweep-stop disabled>
          <span class="transport-stop-shape" aria-hidden="true"></span>
          Stop
        </button>
      </div>
    </section>

    <div class="sweep-state-strip sweep-safety">
      <strong>Low volume</strong>
      <p>
        Start with your device/headphone volume low. Increase it only to a
        comfortable listening level. Do not turn the volume up to compensate for
        a tone you cannot hear.
      </p>
    </div>
    <CapabilityNotice id="frequency-sweep-cap" />
    <p class="sweep-error" data-sweep-error role="alert" hidden></p>
  </SonicInstrument>
</div>

<script>
  import { FrequencySweepController } from "./FrequencySweepController";

  const root = document.querySelector<HTMLElement>("[data-frequency-sweep]");
  let controller: FrequencySweepController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new FrequencySweepController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .sweep-sheet__bar {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 5px 18px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .sweep-sheet__state {
    display: grid;
    justify-items: end;
    gap: 1px;
    min-width: 0;
    text-align: right;
  }

  .sweep-sheet__state strong {
    display: inline-flex;
    gap: 7px;
    align-items: baseline;
    color: var(--sonic-current);
    font-size: clamp(1.08rem, 1.7vw, 1.45rem);
    font-variant-numeric: tabular-nums;
  }

  .sweep-sheet__state > span,
  .sweep-field__reference,
  .sweep-field__note,
  .sweep-duration__bounds {
    color: var(--sonic-muted);
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .sweep-field {
    display: grid;
    grid-template-rows: auto minmax(126px, 1fr) auto;
    gap: 7px;
    min-height: 218px;
    padding: 13px 18px 10px;
    border-bottom: 1px solid var(--sonic-border-soft);
    background: var(--sonic-field);
  }

  .sweep-field__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .sweep-field__heading > div {
    display: grid;
    gap: 2px;
  }

  .sweep-field__heading > div > span,
  .sweep-rail__label {
    color: var(--sonic-muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .sweep-field__heading strong {
    font-size: 0.92rem;
  }

  .sweep-field__reference {
    text-align: right;
    white-space: nowrap;
  }

  .sweep-stage {
    position: relative;
    min-height: 126px;
    overflow: hidden;
    border: 1px solid rgb(24 56 65 / 0.16);
    border-radius: 7px;
    background:
      linear-gradient(rgb(24 56 65 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(24 56 65 / 0.06) 1px, transparent 1px),
      rgb(243 240 232 / 0.28);
    background-size: 32px 32px;
  }

  .sweep-curve {
    position: absolute;
    inset: 10px 10px 25px;
    width: calc(100% - 20px);
    height: calc(100% - 35px);
    overflow: visible;
  }

  .sweep-curve__grid,
  .sweep-curve__line {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .sweep-curve__grid {
    stroke: rgb(24 56 65 / 0.12);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  .sweep-curve__line {
    stroke: var(--sonic-signal);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  [data-sweep-scale="linear"] .sweep-curve__line--log,
  [data-sweep-scale="logarithmic"] .sweep-curve__line--linear {
    display: none;
  }

  .sweep-progress-track {
    position: absolute;
    right: 10px;
    bottom: 24px;
    left: 10px;
    height: 3px;
    background: rgb(24 56 65 / 0.13);
  }

  .sweep-cursor {
    position: absolute;
    top: 50%;
    left: 0;
    width: 13px;
    height: 13px;
    border: 3px solid var(--sonic-sheet);
    border-radius: 50%;
    background: var(--sonic-current);
    transform: translateY(-50%);
  }

  [data-sweep-visual="playing"] .sweep-cursor {
    animation: sweep-progress var(--sweep-duration) linear forwards;
  }

  [data-sweep-visual="playing"][data-sweep-direction="descending"]
    .sweep-cursor {
    animation-direction: reverse;
  }

  .sweep-scale {
    position: absolute;
    right: 10px;
    bottom: 5px;
    left: 10px;
    display: flex;
    justify-content: space-between;
    color: var(--sonic-muted);
    font-size: 0.64rem;
    font-variant-numeric: tabular-nums;
  }

  .sweep-field__note {
    margin: 0;
  }

  .sweep-rail {
    display: grid;
    grid-template-columns:
      minmax(330px, 1.35fr) minmax(330px, 1.25fr) minmax(175px, 0.7fr)
      minmax(140px, 0.55fr);
    min-height: 190px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .sweep-rail > div {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 7px;
    padding: 11px 13px;
    border-right: 1px solid var(--sonic-border-soft);
  }

  .sweep-rail > div:last-child {
    border-right: 0;
  }

  .sweep-range-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .sweep-range-grid > div {
    min-width: 0;
  }

  .sweep-range-grid :global(.frequency-control) {
    min-width: 0;
  }

  .sweep-duration {
    display: grid;
    gap: 2px;
  }

  .sweep-field-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .sweep-field-header label,
  .sweep-options legend {
    font-size: 0.76rem;
    font-weight: 760;
  }

  .sweep-field-header output {
    color: var(--sonic-muted);
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
  }

  .sweep-duration input {
    width: 100%;
    min-height: 44px;
  }

  .sweep-duration__bounds {
    display: flex;
    justify-content: space-between;
  }

  .sweep-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .sweep-options fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .sweep-options legend {
    margin-bottom: 4px;
  }

  .sweep-selector {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
  }

  .sweep-selector button {
    min-width: 0;
    min-height: 44px;
    padding: 0 6px;
    border: 1px solid var(--sonic-border-soft);
    border-radius: var(--sonic-control-radius);
    background: var(--sonic-control-bg);
    color: var(--sonic-muted);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 760;
    cursor: pointer;
  }

  .sweep-selector button[aria-pressed="true"] {
    border-color: var(--sonic-signal);
    color: var(--sonic-ink);
    box-shadow: inset 0 -3px 0 var(--sonic-signal);
  }

  .sweep-level-block :global(.level-control) {
    min-width: 0;
  }

  .sweep-transport-block {
    grid-template-rows: auto auto auto;
  }

  .sweep-play,
  .sweep-stop {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid var(--sonic-border);
    border-radius: var(--sonic-control-radius);
    background: var(--sonic-control-bg);
    color: var(--sonic-ink);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }

  .sweep-play {
    border-color: var(--sonic-signal);
  }

  .sweep-stop:disabled,
  .sweep-play:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .transport-stop-shape {
    width: 0.72em;
    aspect-ratio: 1;
    border-radius: 1px;
    background: currentColor;
  }

  .sweep-state-strip {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    min-height: 52px;
    padding: 9px 18px 10px;
  }

  .sweep-state-strip strong {
    color: var(--sonic-current);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sweep-state-strip p,
  .sweep-error {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .sweep-error {
    padding: 10px 18px;
    border-top: 1px solid rgb(149 80 59 / 0.2);
    color: var(--sonic-opposing);
  }

  .sweep-error[hidden] {
    display: none;
  }

  @keyframes sweep-progress {
    from {
      left: 0;
    }
    to {
      left: calc(100% - 13px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-sweep-visual="playing"] .sweep-cursor {
      animation: none;
    }
  }

  @media (max-width: 1180px) {
    .sweep-rail {
      grid-template-columns: minmax(310px, 1.2fr) minmax(310px, 1.1fr) minmax(
          150px,
          0.65fr
        );
    }

    .sweep-transport-block {
      grid-column: 1 / -1;
      grid-template-columns: auto minmax(150px, 200px) minmax(110px, 160px);
      align-items: center;
      border-top: 1px solid var(--sonic-border-soft);
    }
  }

  @media (max-width: 900px) {
    .sweep-field {
      min-height: 210px;
    }

    .sweep-rail {
      grid-template-columns: 1fr 1fr;
    }

    .sweep-rail > div:nth-child(2) {
      border-right: 0;
    }

    .sweep-level-block,
    .sweep-transport-block {
      border-top: 1px solid var(--sonic-border-soft);
    }

    .sweep-transport-block {
      grid-column: auto;
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 620px) {
    .sweep-sheet__bar {
      align-items: flex-start;
      padding-inline: 14px;
    }

    .sweep-sheet__state strong {
      gap: 4px;
      font-size: 0.92rem;
    }

    .sweep-sheet__state > span {
      font-size: 0.64rem;
    }

    .sweep-field {
      grid-template-rows: auto 112px auto;
      min-height: 0;
      padding: 12px 14px 10px;
    }

    .sweep-field__reference {
      max-width: 116px;
      white-space: normal;
    }

    .sweep-stage {
      min-height: 112px;
    }

    .sweep-rail {
      grid-template-columns: 1fr;
    }

    .sweep-rail > div {
      border-right: 0;
      border-top: 1px solid var(--sonic-border-soft);
      padding-inline: 14px;
    }

    .sweep-rail > div:first-child {
      border-top: 0;
    }

    .sweep-range-grid,
    .sweep-options {
      grid-template-columns: 1fr;
    }

    .sweep-state-strip {
      grid-template-columns: 1fr;
      gap: 3px;
      padding-inline: 14px;
    }
  }
</style>
