---
import CapabilityNotice from "../../components/feedback/CapabilityNotice.astro";
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import FrequencyControl from "../../components/controls/FrequencyControl.astro";
import LevelControl from "../../components/controls/LevelControl.astro";
import ModePills from "../../components/controls/ModePills.astro";
import PlayStopControl from "../../components/controls/PlayStopControl.astro";
import InstrumentSurface from "../../components/layout/InstrumentSurface.astro";

const waveformOptions = [
  { value: "sine", label: "Sine" },
  { value: "square", label: "Square" },
  { value: "triangle", label: "Triangle" },
  { value: "sawtooth", label: "Saw" },
] as const;

const channelOptions = [
  { value: "left", label: "Left" },
  { value: "both", label: "Both" },
  { value: "right", label: "Right" },
] as const;

const presets = [40, 100, 440, 1_000, 10_000] as const;
---

<div data-tone-generator>
  <InstrumentSurface label="Tone Generator controls and waveform" accent="lavender">
    <div class="tone-instrument">
      <section class="tone-visual" aria-label="Generated waveform preview">
        <div class="tone-visual__header">
          <ToolStatus id="tone-status" label="Idle" state="idle" />
          <strong class="tone-frequency-readout" data-tone-frequency-readout
            >440 Hz</strong
          >
        </div>
        <div class="tone-canvas-wrap" aria-hidden="true">
          <canvas data-tone-waveform></canvas>
        </div>
        <p class="tone-visual__note">
          Stylized waveform preview. The numeric control is the requested digital frequency.
        </p>
      </section>

      <section class="tone-controls" aria-label="Tone settings">
        <FrequencyControl
          id="tone-frequency"
          valueHz={440}
          minHz={20}
          maxHz={20_000}
        />

        <div class="tone-presets" aria-label="Frequency presets">
          {
            presets.map((frequency) => (
              <button type="button" data-tone-preset={frequency}>
                {frequency >= 1_000 ? `${frequency / 1_000}k` : frequency}
                <span class="sr-only"> Hz</span>
              </button>
            ))
          }
        </div>

        <div class="tone-mode-grid">
          <ModePills
            legend="Waveform"
            name="tone-waveform"
            options={waveformOptions}
            value="sine"
          />
          <ModePills
            legend="Output"
            name="tone-channel"
            options={channelOptions}
            value="both"
          />
        </div>

        <LevelControl id="tone-level" valueDb={-24} minDb={-60} maxDb={-12} />

        <div class="tone-safety">
          <i class="ph ph-speaker-low" aria-hidden="true"></i>
          <p>
            Start with your device/headphone volume low. Increase it only to a comfortable listening level. Do not turn the volume up to compensate for a tone you cannot hear.
          </p>
        </div>

        <CapabilityNotice id="tone-frequency-cap" />
        <p class="tone-error" data-tone-error role="alert" hidden></p>

        <div class="tone-actions">
          <PlayStopControl id="tone-play-stop" isActive={false} />
          <span>Stops with a short click-reduction fade.</span>
        </div>
      </section>
    </div>
  </InstrumentSurface>
</div>

<script>
  import { ToneGeneratorController } from "./ToneGeneratorController";

  const root = document.querySelector<HTMLElement>("[data-tone-generator]");
  let controller: ToneGeneratorController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new ToneGeneratorController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .tone-instrument {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    min-height: 430px;
  }

  .tone-visual {
    display: grid;
    grid-template-rows: auto minmax(220px, 1fr) auto;
    min-width: 0;
    padding: clamp(22px, 3vw, 34px);
    border-right: 1px solid var(--color-border);
  }

  .tone-visual__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .tone-frequency-readout {
    font-size: clamp(1.35rem, 2.5vw, 2.2rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.035em;
  }

  .tone-canvas-wrap {
    min-height: 220px;
    margin: 12px -10px 0;
  }

  .tone-canvas-wrap canvas {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 220px;
  }

  .tone-visual__note {
    max-width: 520px;
    margin: 8px 0 0;
    color: var(--color-ink-muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .tone-controls {
    display: grid;
    align-content: center;
    gap: 18px;
    min-width: 0;
    padding: clamp(22px, 3vw, 34px);
    background: rgb(255 253 252 / 0.72);
  }

  .tone-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: -7px;
  }

  .tone-presets button {
    min-width: 52px;
    min-height: 38px;
    padding: 0 11px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink-muted);
    cursor: pointer;
  }

  .tone-presets button:hover:not(:disabled) {
    border-color: var(--color-focus);
    color: var(--color-ink);
  }

  .tone-presets button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .tone-mode-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 18px;
  }

  .tone-safety {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-control);
    background: rgb(255 215 106 / 0.18);
  }

  .tone-safety i {
    margin-top: 3px;
  }

  .tone-safety p,
  .tone-error {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .tone-error {
    padding: 11px 13px;
    border-radius: var(--radius-control);
    background: rgb(155 47 47 / 0.08);
    color: #7f2929;
  }

  .tone-error[hidden] {
    display: none;
  }

  .tone-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .tone-actions > span {
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .tone-instrument {
      grid-template-columns: 1fr;
    }

    .tone-visual {
      min-height: 330px;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 560px) {
    .tone-visual {
      min-height: 280px;
    }

    .tone-canvas-wrap,
    .tone-canvas-wrap canvas {
      min-height: 180px;
    }

    .tone-mode-grid {
      grid-template-columns: 1fr;
    }

    .tone-actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
