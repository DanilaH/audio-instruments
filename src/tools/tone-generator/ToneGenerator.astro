---
import FrequencyControl from "../../components/controls/FrequencyControl.astro";
import LevelControl from "../../components/controls/LevelControl.astro";
import ModePills from "../../components/controls/ModePills.astro";
import PlayStopControl from "../../components/controls/PlayStopControl.astro";
import CapabilityNotice from "../../components/feedback/CapabilityNotice.astro";
import MetricReadout from "../../components/feedback/MetricReadout.astro";
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import SonicInstrument from "../../components/layout/SonicInstrument.astro";

const waveformOptions = [
  { value: "sine", label: "Sine" },
  { value: "square", label: "Square" },
  { value: "triangle", label: "Triangle" },
  { value: "sawtooth", label: "Saw" },
] as const;

const channelOptions = [
  { value: "left", label: "Left" },
  { value: "both", label: "Both" },
  { value: "right", label: "Right" },
] as const;

const presets = [40, 100, 440, 1_000, 10_000] as const;
---

<div data-tone-generator>
  <SonicInstrument label="Tone Generator controls and waveform" class="tone-sheet">
    <div class="tone-sheet__bar">
      <ToolStatus id="tone-status" label="Idle" state="idle" />
      <div class="tone-sheet__state">
        <span>Requested frequency</span>
        <MetricReadout
          id="tone-frequency-readout"
          value="440"
          unit="Hz"
          label="Requested frequency"
          size="large"
        />
      </div>
    </div>

    <section class="tone-field" aria-label="Generated waveform preview">
      <div class="tone-field__heading">
        <div>
          <span>Generated signal</span>
          <strong>Requested waveform preview</strong>
        </div>
        <span class="tone-field__reference">20 Hz–20 kHz · digital request</span>
      </div>
      <div class="tone-canvas-wrap" aria-hidden="true">
        <canvas data-tone-waveform></canvas>
      </div>
      <p class="tone-field__note">
        Stylized waveform preview. The numeric control is the requested digital
        frequency; this is not an acoustic measurement.
      </p>
    </section>

    <section class="tone-rail" aria-label="Tone settings">
      <div class="tone-frequency-block">
        <span class="tone-rail__label">Frequency</span>
        <FrequencyControl
          id="tone-frequency"
          valueHz={440}
          minHz={20}
          maxHz={20_000}
        />
        <div class="tone-presets" aria-label="Frequency presets">
          {
            presets.map((frequency) => (
              <button type="button" data-tone-preset={frequency}>
                {frequency >= 1_000 ? `${frequency / 1_000}k` : frequency}
                <span class="sr-only"> Hz</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="tone-modes">
        <span class="tone-rail__label">Signal</span>
        <ModePills
          legend="Waveform"
          name="tone-waveform"
          options={waveformOptions}
          value="sine"
        />
        <ModePills
          legend="Output"
          name="tone-channel"
          options={channelOptions}
          value="both"
        />
      </div>

      <div class="tone-level">
        <span class="tone-rail__label">Level</span>
        <LevelControl id="tone-level" valueDb={-24} minDb={-60} maxDb={-12} />
      </div>

      <div class="tone-transport">
        <span class="tone-rail__label">Transport</span>
        <PlayStopControl id="tone-play-stop" isActive={false} />
        <span>Short click-reduction fade on stop.</span>
      </div>
    </section>

    <div class="tone-state-strip">
      <strong>Low volume</strong>
      <p>
        Start with your device/headphone volume low. Increase it only to a
        comfortable listening level. Do not turn the volume up to compensate for
        a tone you cannot hear.
      </p>
    </div>
    <CapabilityNotice id="tone-frequency-cap" />
    <p class="tone-error" data-tone-error role="alert" hidden></p>
  </SonicInstrument>
</div>

<script>
  import { ToneGeneratorController } from "./ToneGeneratorController";

  const root = document.querySelector<HTMLElement>("[data-tone-generator]");
  let controller: ToneGeneratorController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new ToneGeneratorController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .tone-sheet__bar {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 5px 18px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .tone-sheet__state {
    display: grid;
    justify-items: end;
    gap: 0;
    min-width: 0;
    text-align: right;
  }

  .tone-sheet__state > span,
  .tone-field__heading > div > span,
  .tone-rail__label {
    color: var(--sonic-muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .tone-sheet__state :global(.metric-readout) {
    color: var(--sonic-current);
    font-size: clamp(1.2rem, 2vw, 1.75rem);
  }

  .tone-field {
    display: grid;
    grid-template-rows: auto minmax(132px, 1fr) auto;
    gap: 8px;
    min-height: 222px;
    padding: 14px 18px 10px;
    border-bottom: 1px solid var(--sonic-border-soft);
    background: var(--sonic-field);
  }

  .tone-field__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .tone-field__heading > div {
    display: grid;
    gap: 2px;
  }

  .tone-field__heading strong {
    font-size: 0.92rem;
  }

  .tone-field__reference,
  .tone-field__note,
  .tone-transport > span:last-child {
    color: var(--sonic-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .tone-field__reference {
    text-align: right;
    white-space: nowrap;
  }

  .tone-canvas-wrap {
    min-height: 132px;
    overflow: hidden;
    border: 1px solid rgb(24 56 65 / 0.18);
    border-radius: 7px;
    background:
      linear-gradient(rgb(24 56 65 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(24 56 65 / 0.07) 1px, transparent 1px),
      rgb(243 240 232 / 0.32);
    background-size: 32px 32px;
  }

  .tone-canvas-wrap canvas {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 132px;
  }

  .tone-field__note {
    margin: 0;
  }

  .tone-rail {
    display: grid;
    grid-template-columns:
      minmax(290px, 1.35fr) minmax(290px, 1.2fr) minmax(180px, 0.75fr)
      minmax(145px, 0.6fr);
    min-height: 180px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .tone-rail > div {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 7px;
    padding: 12px 14px;
    border-right: 1px solid var(--sonic-border-soft);
  }

  .tone-rail > div:last-child {
    border-right: 0;
  }

  .tone-frequency-block :global(.frequency-control),
  .tone-level :global(.level-control) {
    min-width: 0;
  }

  .tone-presets {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 5px;
  }

  .tone-presets button {
    min-width: 0;
    min-height: 44px;
    padding: 0 8px;
    border: 1px solid var(--sonic-border-soft);
    border-radius: var(--sonic-control-radius);
    background: var(--sonic-control-bg);
    color: var(--sonic-ink);
    font: inherit;
    font-size: 0.76rem;
    font-weight: 760;
    cursor: pointer;
  }

  .tone-presets button:hover:not(:disabled) {
    border-color: var(--sonic-signal);
  }

  .tone-presets button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .tone-modes {
    grid-template-columns: 1fr;
  }

  .tone-modes :global(fieldset) {
    min-width: 0;
  }

  .tone-transport {
    grid-template-rows: auto auto 1fr;
  }

  .tone-transport :global(button) {
    width: 100%;
    min-height: 48px;
  }

  .tone-state-strip {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    min-height: 52px;
    padding: 9px 18px 10px;
  }

  .tone-state-strip strong {
    color: var(--sonic-current);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .tone-state-strip p,
  .tone-error {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .tone-error {
    padding: 10px 18px;
    border-top: 1px solid rgb(149 80 59 / 0.2);
    color: var(--sonic-opposing);
  }

  .tone-error[hidden] {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1120px) {
    .tone-rail {
      grid-template-columns: minmax(280px, 1.15fr) minmax(280px, 1fr) minmax(
          150px,
          0.65fr
        );
    }

    .tone-transport {
      grid-column: 1 / -1;
      grid-template-columns: auto minmax(130px, 180px) 1fr;
      align-items: center;
      border-top: 1px solid var(--sonic-border-soft);
    }
  }

  @media (max-width: 900px) {
    .tone-field {
      min-height: 210px;
    }

    .tone-rail {
      grid-template-columns: 1fr 1fr;
    }

    .tone-rail > div:nth-child(2) {
      border-right: 0;
    }

    .tone-level,
    .tone-transport {
      border-top: 1px solid var(--sonic-border-soft);
    }

    .tone-transport {
      grid-column: auto;
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 560px) {
    .tone-sheet__bar {
      align-items: flex-start;
      padding-inline: 14px;
    }

    .tone-sheet__state :global(.metric-readout) {
      font-size: 1.18rem;
    }

    .tone-field {
      grid-template-rows: auto 112px auto;
      min-height: 0;
      padding: 12px 14px 10px;
    }

    .tone-field__heading {
      align-items: flex-start;
    }

    .tone-field__reference {
      max-width: 118px;
      white-space: normal;
    }

    .tone-canvas-wrap,
    .tone-canvas-wrap canvas {
      min-height: 112px;
    }

    .tone-rail {
      grid-template-columns: 1fr;
    }

    .tone-rail > div {
      border-right: 0;
      border-top: 1px solid var(--sonic-border-soft);
      padding-inline: 14px;
    }

    .tone-rail > div:first-child {
      border-top: 0;
    }

    .tone-presets {
      grid-template-columns: repeat(5, minmax(48px, 1fr));
      overflow-x: auto;
      scrollbar-width: thin;
    }

    .tone-state-strip {
      grid-template-columns: 1fr;
      gap: 3px;
      padding-inline: 14px;
    }
  }
</style>
