---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import InstrumentSurface from "../../components/layout/InstrumentSurface.astro";
---

<div data-phase-test data-phase-mode="idle">
  <InstrumentSurface label="Phase Test output controls" accent="lavender">
    <div class="phase-instrument">
      <section class="phase-visual" aria-label="Phase relationship visualization">
        <div class="phase-visual__header">
          <ToolStatus id="phase-status" label="Ready" state="idle" />
          <div class="phase-reference">
            <strong>Correlated pink noise</strong>
            <span>same source · same playback position</span>
          </div>
        </div>

        <div class="phase-waveforms" aria-hidden="true">
          <div class="phase-waveform-row">
            <span>L</span>
            <svg viewBox="0 0 420 92" preserveAspectRatio="none">
              <path d="M0 46 C28 18 48 74 78 46 S130 20 160 46 S214 72 244 46 S296 18 326 46 S382 74 420 46"></path>
            </svg>
          </div>
          <div class="phase-waveform-row phase-waveform-row--right">
            <span>R</span>
            <svg viewBox="0 0 420 92" preserveAspectRatio="none">
              <path d="M0 46 C28 18 48 74 78 46 S130 20 160 46 S214 72 244 46 S296 18 326 46 S382 74 420 46"></path>
            </svg>
          </div>
        </div>

        <p class="phase-mode">
          Relationship: <strong data-phase-mode-label>None</strong>
        </p>
        <p class="phase-visual__note">
          Relationship cue only — not a measured waveform or a physical wiring
          diagnosis.
        </p>
      </section>

      <section class="phase-controls" aria-label="Phase Test actions">
        <div class="phase-safety">
          <i class="ph ph-speaker-low" aria-hidden="true"></i>
          <p>
            Start with your device/headphone volume low. Increase it only to a
            comfortable listening level. Do not turn the volume up to compensate
            for a tone you cannot hear.
          </p>
        </div>

        <div class="phase-group">
          <div>
            <strong>Compare relationship</strong>
            <span>Switching keeps the same deterministic source and playback position.</span>
          </div>
          <div class="phase-actions phase-actions--modes">
            <button type="button" data-phase-in-phase aria-pressed="false">In phase</button>
            <button type="button" data-phase-inverted aria-pressed="false">Inverted</button>
          </div>
        </div>

        <div class="phase-actions phase-actions--utility">
          <button type="button" class="phase-toggle" data-phase-toggle disabled>
            <i class="ph ph-arrows-left-right" aria-hidden="true"></i>
            A/B toggle
          </button>
          <button type="button" class="phase-stop" data-phase-stop disabled>
            <i class="ph ph-stop" aria-hidden="true"></i>
            Stop
          </button>
        </div>

        <p class="phase-error" data-phase-error role="alert" hidden></p>
      </section>
    </div>
  </InstrumentSurface>
</div>

<script>
  import { PhaseTestController } from "./PhaseTestController";

  const root = document.querySelector<HTMLElement>("[data-phase-test]");
  let controller: PhaseTestController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new PhaseTestController(root);
  };
  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });
  mount();
</script>

<style>
  .phase-instrument {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(360px, 0.94fr);
    min-height: 410px;
  }

  .phase-visual,
  .phase-controls {
    min-width: 0;
    padding: clamp(22px, 3vw, 34px);
  }

  .phase-visual {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    border-right: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 50% 52%, rgb(143 124 255 / 0.16), transparent 36%),
      linear-gradient(145deg, rgb(255 253 252 / 0.92), rgb(247 244 255 / 0.82));
  }

  .phase-visual__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .phase-reference {
    display: grid;
    justify-items: end;
    gap: 3px;
    text-align: right;
  }

  .phase-reference strong {
    font-size: 0.9rem;
  }

  .phase-reference span,
  .phase-group span,
  .phase-visual__note {
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .phase-waveforms {
    display: grid;
    align-content: center;
    gap: 12px;
    margin: 14px 0 8px;
  }

  .phase-waveform-row {
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: center;
    gap: 12px;
  }

  .phase-waveform-row > span {
    font-weight: 800;
    color: var(--color-ink-muted);
  }

  .phase-waveform-row svg {
    width: 100%;
    height: 92px;
    overflow: visible;
  }

  .phase-waveform-row path {
    fill: none;
    stroke: var(--color-lavender);
    stroke-width: 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.72;
    transition: transform 50ms linear, opacity 120ms ease;
    transform-origin: 50% 50%;
  }

  [data-phase-mode="inverted"] .phase-waveform-row--right path {
    transform: scaleY(-1);
    opacity: 1;
  }

  [data-phase-mode="in-phase"] .phase-waveform-row path {
    opacity: 1;
  }

  .phase-mode {
    margin: 0;
    text-align: center;
    font-size: 0.92rem;
  }

  .phase-visual__note {
    max-width: 560px;
    margin: 8px auto 0;
    text-align: center;
  }

  .phase-controls {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(20px, 2.4vw, 24px);
    background: rgb(255 253 252 / 0.74);
  }

  .phase-safety {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    padding: 11px 13px;
    border-radius: var(--radius-control);
    background: rgb(255 215 106 / 0.18);
  }

  .phase-safety p,
  .phase-error {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .phase-group {
    display: grid;
    gap: 8px;
  }

  .phase-group > div:first-child {
    display: grid;
    gap: 3px;
  }

  .phase-actions {
    display: grid;
    gap: 8px;
  }

  .phase-actions--modes,
  .phase-actions--utility {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .phase-actions button {
    min-height: 48px;
    border-radius: var(--radius-button);
    font-weight: 800;
    cursor: pointer;
  }

  .phase-actions--modes button {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .phase-actions--modes button[aria-pressed="true"] {
    border-color: rgb(93 74 232 / 0.42);
    background: rgb(143 124 255 / 0.12);
  }

  .phase-toggle,
  .phase-stop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .phase-toggle {
    border: 0;
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .phase-stop {
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-ink);
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.48;
  }

  .phase-error {
    padding: 11px 13px;
    border-radius: var(--radius-control);
    background: rgb(155 47 47 / 0.08);
    color: #7f2929;
  }

  .phase-error[hidden] {
    display: none;
  }

  @media (max-width: 900px) {
    .phase-instrument {
      grid-template-columns: 1fr;
    }

    .phase-visual {
      min-height: 330px;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 560px) {
    .phase-visual {
      min-height: 220px;
      padding: 14px 20px;
    }

    .phase-controls {
      padding: 16px 20px;
    }

    .phase-waveforms {
      gap: 2px;
      margin: 2px 0;
    }

    .phase-waveform-row svg {
      height: 44px;
    }

    .phase-reference span {
      display: none;
    }

    .phase-visual__note {
      margin-top: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phase-waveform-row path {
      transition: none;
    }
  }
</style>