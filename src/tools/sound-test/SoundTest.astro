---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import InstrumentSurface from "../../components/layout/InstrumentSurface.astro";
---

<div data-sound-test data-active-channel="none">
  <InstrumentSurface label="Sound Test output controls" accent="peach">
    <div class="sound-instrument">
      <section class="sound-visual" aria-label="Stereo channel activity">
        <div class="sound-visual__header">
          <ToolStatus id="sound-status" label="Ready" state="idle" />
          <div class="sound-reference" aria-label="Reference signal">
            <strong>500 Hz</strong>
            <span>700 ms sine burst</span>
          </div>
        </div>

        <div class="channel-stage" aria-hidden="true">
          <div class="channel-stage__speaker channel-stage__speaker--left">
            <span class="channel-stage__ring"></span>
            <strong>L</strong>
          </div>
          <div class="channel-stage__signal">
            <i class="ph ph-wave-sine"></i>
          </div>
          <div class="channel-stage__speaker channel-stage__speaker--right">
            <span class="channel-stage__ring"></span>
            <strong>R</strong>
          </div>
        </div>

        <p class="active-channel">
          Active channel: <strong data-active-channel-label>None</strong>
        </p>
        <p class="sound-visual__note">
          This shows the digital channel target. Confirm the expected sound with
          your own ears; the browser cannot verify physical speaker output.
        </p>
      </section>

      <section class="sound-controls" aria-label="Sound Test actions">
        <div class="sound-safety">
          <i class="ph ph-speaker-low" aria-hidden="true"></i>
          <p>
            Start with your device/headphone volume low. Increase it only to a
            comfortable listening level. Do not turn the volume up to compensate
            for a tone you cannot hear.
          </p>
        </div>

        <div class="sound-action-group">
          <div>
            <p class="sound-action-group__label">Play one channel</p>
            <p class="sound-action-group__hint">
              Each button plays the same 500 Hz reference burst.
            </p>
          </div>
          <div class="channel-actions">
            <button type="button" data-sound-channel="left">
              <i class="ph ph-speaker-simple-low" aria-hidden="true"></i>
              Left
            </button>
            <button type="button" data-sound-channel="both">
              <i class="ph ph-speaker-high" aria-hidden="true"></i>
              Both
            </button>
            <button type="button" data-sound-channel="right">
              <i class="ph ph-speaker-simple-high" aria-hidden="true"></i>
              Right
            </button>
          </div>
        </div>

        <div class="sequence-panel">
          <div>
            <strong>Guided sequence</strong>
            <span>Left → 300 ms gap → Both → 300 ms gap → Right</span>
          </div>
          <div class="sequence-actions">
            <button type="button" class="sequence-button" data-sound-sequence>
              <i class="ph ph-play" aria-hidden="true"></i>
              Run sequence
            </button>
            <button type="button" class="stop-button" data-sound-stop disabled>
              <i class="ph ph-stop" aria-hidden="true"></i>
              Stop
            </button>
          </div>
        </div>

        <p class="sound-error" data-sound-error role="alert" hidden></p>
      </section>
    </div>
  </InstrumentSurface>
</div>

<script>
  import { SoundTestController } from "./SoundTestController";

  const root = document.querySelector<HTMLElement>("[data-sound-test]");
  let controller: SoundTestController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new SoundTestController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .sound-instrument {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
    min-height: 410px;
  }

  .sound-visual {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    min-width: 0;
    padding: clamp(22px, 3vw, 34px);
    border-right: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 50% 52%,
        rgb(255 181 141 / 0.2),
        transparent 34%
      ),
      linear-gradient(145deg, rgb(255 253 252 / 0.9), rgb(255 247 242 / 0.72));
  }

  .sound-visual__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .sound-reference {
    display: grid;
    justify-items: end;
    gap: 3px;
  }

  .sound-reference strong {
    font-size: 1.35rem;
    letter-spacing: -0.035em;
  }

  .sound-reference span,
  .sound-visual__note,
  .sound-action-group__hint,
  .sequence-panel span {
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .channel-stage {
    display: grid;
    grid-template-columns: minmax(110px, 1fr) auto minmax(110px, 1fr);
    align-items: center;
    gap: clamp(18px, 4vw, 42px);
    width: min(100%, 560px);
    margin: 18px auto 10px;
  }

  .channel-stage__speaker {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    max-width: 190px;
    border: 1px solid var(--color-border);
    border-radius: 38%;
    background: var(--color-surface);
    color: var(--color-ink-muted);
    box-shadow: 0 18px 48px rgb(31 36 48 / 0.06);
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease;
  }

  .channel-stage__speaker strong {
    position: relative;
    z-index: 2;
    font-size: clamp(1.5rem, 4vw, 2.7rem);
  }

  .channel-stage__ring {
    position: absolute;
    width: 56%;
    aspect-ratio: 1;
    border: 8px solid currentColor;
    border-radius: 999px;
    opacity: 0.12;
  }

  .channel-stage__signal {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 999px;
    background: rgb(255 181 141 / 0.2);
    color: #b75c2d;
    font-size: 1.35rem;
  }

  [data-active-channel="left"] .channel-stage__speaker--left,
  [data-active-channel="both"] .channel-stage__speaker--left,
  [data-active-channel="right"] .channel-stage__speaker--right,
  [data-active-channel="both"] .channel-stage__speaker--right {
    transform: translateY(-3px);
    border-color: rgb(183 92 45 / 0.35);
    color: #9d4d27;
    box-shadow: 0 18px 52px rgb(183 92 45 / 0.16);
  }

  [data-active-channel="left"]
    .channel-stage__speaker--left
    .channel-stage__ring,
  [data-active-channel="both"]
    .channel-stage__speaker--left
    .channel-stage__ring,
  [data-active-channel="right"]
    .channel-stage__speaker--right
    .channel-stage__ring,
  [data-active-channel="both"]
    .channel-stage__speaker--right
    .channel-stage__ring {
    opacity: 0.34;
  }

  .active-channel {
    margin: 0;
    text-align: center;
    font-size: 0.92rem;
  }

  .sound-visual__note {
    max-width: 560px;
    margin: 10px auto 0;
    text-align: center;
  }

  .sound-controls {
    display: grid;
    align-content: start;
    gap: 18px;
    min-width: 0;
    padding: clamp(22px, 3vw, 34px);
    background: rgb(255 253 252 / 0.74);
  }

  .sound-safety {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    padding: 11px 13px;
    border-radius: var(--radius-control);
    background: rgb(255 215 106 / 0.18);
  }

  .sound-safety i {
    margin-top: 3px;
  }

  .sound-safety p,
  .sound-error {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .sound-action-group {
    display: grid;
    gap: 12px;
  }

  .sound-action-group__label,
  .sound-action-group__hint {
    margin: 0;
  }

  .sound-action-group__label {
    font-weight: 800;
  }

  .sound-action-group__hint {
    margin-top: 3px;
  }

  .channel-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .channel-actions button,
  .sequence-button,
  .stop-button {
    min-height: 48px;
    border-radius: var(--radius-button);
    font-weight: 800;
    cursor: pointer;
  }

  .channel-actions button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 10px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .channel-actions button:hover:not(:disabled) {
    border-color: rgb(183 92 45 / 0.42);
    background: #fff7f2;
  }

  .sequence-panel {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
  }

  .sequence-panel > div:first-child {
    display: grid;
    gap: 4px;
  }

  .sequence-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 0.42fr);
    gap: 8px;
  }

  .sequence-button,
  .stop-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 0 16px;
  }

  .sequence-button {
    border: 0;
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .stop-button {
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-ink);
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.48;
  }

  .sound-error {
    padding: 11px 13px;
    border-radius: var(--radius-control);
    background: rgb(155 47 47 / 0.08);
    color: #7f2929;
  }

  .sound-error[hidden] {
    display: none;
  }

  @media (max-width: 900px) {
    .sound-instrument {
      grid-template-columns: 1fr;
    }

    .sound-visual {
      min-height: 360px;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 560px) {
    .sound-visual,
    .sound-controls {
      padding: 18px 20px;
    }

    .sound-visual {
      min-height: 280px;
    }

    .channel-stage {
      grid-template-columns: 96px 32px 96px;
      justify-content: center;
      gap: 8px;
      margin: 10px auto 8px;
    }

    .channel-stage__speaker {
      width: 96px;
    }

    .channel-stage__signal {
      width: 32px;
      height: 32px;
    }

    .sound-visual__note {
      margin-top: 6px;
    }

    .channel-actions button {
      gap: 5px;
      padding-inline: 8px;
    }

    .sequence-actions {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-stage__speaker {
      transition: none;
    }

    [data-active-channel] .channel-stage__speaker {
      transform: none;
    }
  }
</style>
