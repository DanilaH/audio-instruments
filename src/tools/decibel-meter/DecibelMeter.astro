---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import SonicInstrument from "../../components/layout/SonicInstrument.astro";
---

<div data-decibel-meter data-db-state="idle">
  <SonicInstrument
    class="db-sheet"
    label="Decibel Meter digital microphone level"
  >
    <header class="db-bar">
      <ToolStatus id="decibel-meter-status" label="Ready" state="idle" />
      <div class="db-input-readout">
        <span>Input</span>
        <strong data-db-active-input>No active input</strong>
      </div>
    </header>

    <section class="db-field" aria-label="Digital microphone level">
      <div class="db-field__heading">
        <div>
          <span>Browser-stream level</span>
          <strong>Digital dBFS meter</strong>
        </div>
        <small>100 ms RMS · local input</small>
      </div>

      <div class="db-primary-readout">
        <p>RMS digital level</p>
        <strong data-db-rms>—</strong>
        <span>dBFS · not calibrated SPL</span>
      </div>

      <div class="db-meter" aria-hidden="true">
        <div class="db-meter__scale">
          <span>−100</span>
          <span>−75</span>
          <span>−50</span>
          <span>−25</span>
          <span>0 dBFS</span>
        </div>
        <div class="db-meter__track">
          <span class="db-meter__fill" data-db-meter-fill></span>
        </div>
      </div>

      <div class="db-readout-strip">
        <div class="db-secondary-readout">
          <span>Peak hold</span>
          <strong data-db-peak>—</strong>
        </div>
        <div class="db-estimate-slot">
          <div class="db-estimate" data-db-estimate-panel hidden>
            <div>
              <span>Reference-calibrated estimate</span>
              <strong data-db-estimate>—</strong>
            </div>
            <span class="db-estimate__badge">User-calibrated</span>
          </div>
          <p class="db-estimate-placeholder">
            Optional reference estimate appears here after calibration.
          </p>
        </div>
      </div>
    </section>

    <section class="db-rail" aria-label="Decibel Meter controls">
      <div class="db-capture-pane">
        <div class="db-permission">
          <i class="ph ph-microphone" aria-hidden="true"></i>
          <div>
            <strong>Permission is requested only after Start.</strong>
            <p>
              Audio stays local to this browser session and is never connected
              to speaker output.
            </p>
          </div>
        </div>

        <div class="db-primary-actions">
          <button type="button" class="db-start" data-db-start>
            <i class="ph ph-gauge" aria-hidden="true"></i>
            Start meter
          </button>
          <button type="button" class="db-stop" data-db-stop disabled>
            <span class="transport-stop-shape" aria-hidden="true"></span>
            Stop
          </button>
        </div>

        <div class="db-input-slot">
          <label class="db-control-field" data-db-input-field hidden>
            <span>Input device</span>
            <select data-db-input aria-label="Decibel Meter input device"
            ></select>
          </label>
          <p class="db-error" data-db-selection-error role="alert" hidden></p>
        </div>

        <details class="db-details">
          <summary>Capture details</summary>
          <dl>
            <div>
              <dt>Device ID</dt><dd data-db-detail-device-id>Not reported</dd>
            </div>
            <div>
              <dt>Web Audio processing rate</dt><dd
                data-db-detail-analysis-rate
              >
                Not reported
              </dd>
            </div>
            <div>
              <dt>Track-reported sample rate</dt><dd data-db-detail-sample-rate>
                Not reported
              </dd>
            </div>
            <div>
              <dt>Channel count</dt><dd data-db-detail-channel-count>
                Not reported
              </dd>
            </div>
            <div>
              <dt>Echo cancellation</dt><dd data-db-detail-echo-cancellation>
                Not reported
              </dd>
            </div>
            <div>
              <dt>Noise suppression</dt><dd data-db-detail-noise-suppression>
                Not reported
              </dd>
            </div>
            <div>
              <dt>Auto gain control</dt><dd data-db-detail-auto-gain>
                Not reported
              </dd>
            </div>
          </dl>
        </details>
      </div>

      <details class="db-calibration" data-db-calibration-disclosure>
        <summary>
          <span>
            <small>Optional</small>
            <strong>Reference calibration</strong>
          </span>
          <span class="db-calibration__badge" data-db-estimate-badge
            >Uncalibrated</span
          >
        </summary>

        <div class="db-calibration__body">
          <p
            class="db-calibration__eligibility"
            data-db-calibration-eligibility
          >
            Start the microphone to check whether reference calibration is
            eligible.
          </p>

          <label class="db-control-field db-control-field--stacked">
            <span>External reference reading</span>
            <div class="db-reference-input">
              <input
                type="number"
                step="0.1"
                inputmode="decimal"
                placeholder="72.0"
                data-db-reference
              />
              <span>dB SPL reference</span>
            </div>
          </label>

          <label class="db-weighting-confirm">
            <input type="checkbox" data-db-weighting-confirm />
            <span>
              Confirm that the external reference meter uses Z / Flat / Linear
              weighting. A- or C-weighted references are not accepted in v1.
            </span>
          </label>

          <button type="button" class="db-calibrate" data-db-calibrate disabled>
            Capture 3-second reference
          </button>

          <p class="db-calibration__status" data-db-calibration-status>
            Uncalibrated
          </p>
          <p
            class="sr-only"
            data-db-calibration-live-status
            role="status"
            aria-live="polite"
          >
          </p>

          <div class="db-calibration__limit">
            <i class="ph ph-info" aria-hidden="true"></i>
            <p>
              One-point reference calibration does not calibrate microphone
              frequency response. Recalibrate after changing microphone, system
              input gain, processing, position or reference conditions. The
              browser measurement chain is not claimed to be true Z-weighted or
              unweighted.
            </p>
          </div>
        </div>
      </details>
    </section>

    <div class="db-feedback-slot">
      <p class="db-error" data-db-error role="alert" hidden></p>
    </div>
  </SonicInstrument>
</div>

<script>
  import { DecibelMeterController } from "./DecibelMeterController";

  const root = document.querySelector<HTMLElement>("[data-decibel-meter]");
  let controller: DecibelMeterController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new DecibelMeterController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .db-bar {
    display: flex;
    min-height: 50px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 18px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .db-input-readout {
    display: grid;
    justify-items: end;
    gap: 1px;
    min-width: 0;
    text-align: right;
  }

  .db-input-readout span,
  .db-field__heading span,
  .db-primary-readout p,
  .db-primary-readout > span,
  .db-secondary-readout span,
  .db-estimate span,
  .db-control-field > span,
  .db-calibration summary small {
    color: var(--sonic-muted);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .db-input-readout strong {
    max-width: min(38vw, 300px);
    overflow: hidden;
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .db-field {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    grid-template-rows: auto minmax(154px, 1fr) auto;
    gap: 8px 16px;
    min-height: 270px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--sonic-border);
    background: var(--sonic-field);
  }

  .db-field__heading {
    grid-column: 1 / -1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .db-field__heading > div {
    display: grid;
    gap: 2px;
  }

  .db-field__heading strong {
    font-size: 0.9rem;
  }

  .db-field__heading small,
  .db-permission p,
  .db-calibration__eligibility,
  .db-calibration__status,
  .db-calibration__limit p,
  .db-estimate-placeholder,
  .db-error {
    margin: 0;
    color: var(--sonic-muted);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .db-primary-readout {
    display: grid;
    justify-items: center;
    align-content: center;
    min-height: 154px;
    padding: 16px;
    border: 1px solid var(--sonic-border);
    border-radius: var(--sonic-control-radius);
    background: rgb(243 240 232 / 0.52);
    text-align: center;
  }

  .db-primary-readout p,
  .db-primary-readout > span {
    margin: 0;
  }

  .db-primary-readout strong {
    margin: 7px 0 4px;
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    font-weight: 820;
    letter-spacing: -0.05em;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .db-meter {
    display: grid;
    align-content: center;
    gap: 8px;
  }

  .db-meter__scale {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    color: var(--sonic-muted);
    font-size: 0.65rem;
    font-variant-numeric: tabular-nums;
  }

  .db-meter__scale span:not(:first-child):not(:last-child) {
    text-align: center;
  }
  .db-meter__scale span:last-child {
    text-align: right;
  }

  .db-meter__track {
    height: 26px;
    overflow: hidden;
    border: 1px solid var(--sonic-border);
    border-radius: 4px;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent calc(25% - 1px),
        rgb(24 56 65 / 0.1) 25%
      ),
      rgb(243 240 232 / 0.64);
  }

  .db-meter__fill {
    --db-meter-fill: 0%;
    display: block;
    width: var(--db-meter-fill);
    height: 100%;
    background: var(--sonic-signal);
    transition: width 90ms linear;
  }

  .db-readout-strip {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(190px, 0.55fr) minmax(0, 1fr);
    border-top: 1px solid var(--sonic-border-soft);
  }

  .db-secondary-readout,
  .db-estimate-slot {
    min-width: 0;
    padding: 8px 10px 0;
  }

  .db-secondary-readout {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .db-secondary-readout strong,
  .db-estimate strong {
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .db-estimate-slot {
    border-left: 1px solid var(--sonic-border-soft);
  }

  .db-estimate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .db-estimate[hidden] {
    display: none;
  }
  .db-estimate:not([hidden]) + .db-estimate-placeholder {
    display: none;
  }

  .db-estimate__badge,
  .db-calibration__badge {
    flex: 0 0 auto;
    color: #155f68;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .db-rail {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    min-height: 196px;
  }

  .db-capture-pane,
  .db-calibration {
    min-width: 0;
    padding: 11px 14px;
  }

  .db-capture-pane {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    gap: 7px 10px;
    border-right: 1px solid var(--sonic-border-soft);
  }

  .db-permission {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
  }

  .db-permission > i {
    margin-top: 2px;
    color: var(--sonic-signal);
  }

  .db-permission strong {
    display: block;
    margin-bottom: 2px;
    font-size: 0.76rem;
  }

  .db-primary-actions {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(82px, 0.55fr);
    gap: 6px;
    align-self: start;
  }

  .db-start,
  .db-stop,
  .db-calibrate,
  .db-details summary,
  .db-control-field select,
  .db-reference-input input {
    min-height: 44px;
    border: 1px solid var(--sonic-border);
    border-radius: var(--sonic-control-radius);
    background: transparent;
    color: var(--sonic-ink);
    font: inherit;
  }

  .db-start,
  .db-stop,
  .db-calibrate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 11px;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
  }

  .db-start {
    border-color: var(--sonic-ink);
    background: var(--sonic-ink);
    color: var(--sonic-sheet);
  }

  .transport-stop-shape {
    display: inline-block;
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    border-radius: 1px;
    background: currentColor;
  }

  .db-input-slot {
    grid-column: 1 / -1;
    min-height: 50px;
  }

  .db-control-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 9px;
  }

  .db-control-field--stacked {
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .db-control-field[hidden],
  .db-error[hidden] {
    display: none;
  }

  .db-control-field select,
  .db-reference-input input {
    min-width: 0;
    padding: 0 10px;
    background: var(--sonic-control-bg);
  }

  .db-details {
    grid-column: 1 / -1;
    border-top: 1px solid var(--sonic-border-soft);
  }

  .db-details summary {
    display: flex;
    align-items: center;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    font-size: 0.73rem;
    font-weight: 800;
  }

  .db-details dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5px 12px;
    margin: 4px 0 2px;
    padding: 5px 0;
  }

  .db-details dl > div {
    display: grid;
    grid-template-columns: minmax(110px, 0.8fr) minmax(0, 1.2fr);
    gap: 8px;
    font-size: 0.68rem;
  }

  .db-details dt {
    color: var(--sonic-muted);
  }
  .db-details dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    font-weight: 700;
  }

  .db-calibration {
    padding: 0;
  }

  .db-calibration > summary {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 14px;
    cursor: pointer;
    list-style: none;
  }

  .db-calibration > summary::-webkit-details-marker {
    display: none;
  }

  .db-calibration > summary > span:first-child {
    display: grid;
    gap: 1px;
  }

  .db-calibration > summary strong {
    font-size: 0.82rem;
  }

  .db-calibration__body {
    display: grid;
    gap: 8px;
    padding: 0 14px 11px;
    border-top: 1px solid var(--sonic-border-soft);
  }

  .db-calibration__eligibility {
    padding-top: 8px;
  }

  .db-reference-input {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 7px;
  }

  .db-reference-input span {
    color: var(--sonic-muted);
    font-size: 0.68rem;
  }

  .db-weighting-confirm {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 7px;
    color: var(--sonic-muted);
    font-size: 0.69rem;
    line-height: 1.38;
  }

  .db-weighting-confirm input {
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
  }

  .db-calibrate {
    justify-self: start;
  }
  .db-calibration__status {
    color: var(--sonic-ink);
    font-weight: 760;
  }

  .db-calibration__limit {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    padding-top: 7px;
    border-top: 1px solid var(--sonic-border-soft);
  }

  .db-calibration__limit i {
    color: var(--sonic-current);
  }

  .db-feedback-slot:empty {
    display: none;
  }

  .db-error {
    color: #773927;
  }

  .db-feedback-slot .db-error {
    margin: 0;
    padding: 8px 14px;
    border-top: 1px solid rgb(149 80 59 / 0.25);
    background: rgb(149 80 59 / 0.06);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    border: 0;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  button:disabled,
  select:disabled,
  input:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .db-meter__fill {
      transition: none;
    }
  }

  @media (min-width: 901px) and (max-height: 820px) {
    .db-bar {
      min-height: 46px;
      padding-block: 5px;
    }
    .db-field {
      grid-template-rows: auto 126px auto;
      min-height: 0;
      padding-block: 8px;
    }
    .db-primary-readout {
      min-height: 126px;
    }
    .db-rail {
      min-height: 176px;
    }
    .db-capture-pane {
      padding-block: 8px;
    }
  }

  @media (max-width: 900px) {
    .db-field {
      grid-template-columns: minmax(210px, 0.78fr) minmax(0, 1.22fr);
    }
    .db-rail {
      grid-template-columns: 1fr;
    }
    .db-capture-pane {
      border-right: 0;
      border-bottom: 1px solid var(--sonic-border-soft);
    }
  }

  @media (max-width: 560px) {
    .db-bar {
      align-items: flex-start;
      padding: 7px 12px;
    }
    .db-input-readout strong {
      max-width: 48vw;
    }
    .db-field {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto auto;
      gap: 7px;
      min-height: 0;
      padding: 10px 12px;
    }
    .db-field__heading {
      grid-column: 1;
      align-items: start;
    }
    .db-field__heading small {
      max-width: 130px;
      text-align: right;
    }
    .db-primary-readout {
      min-height: 114px;
      padding: 12px;
    }
    .db-primary-readout strong {
      font-size: clamp(2.4rem, 11vw, 3.4rem);
    }
    .db-meter {
      min-height: 58px;
    }
    .db-readout-strip {
      grid-column: 1;
      grid-template-columns: 1fr;
    }
    .db-estimate-slot {
      border-left: 0;
      border-top: 1px solid var(--sonic-border-soft);
    }
    .db-capture-pane {
      grid-template-columns: 1fr;
      padding: 10px 12px;
    }
    .db-primary-actions,
    .db-input-slot,
    .db-details {
      grid-column: 1;
    }
    .db-control-field {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .db-details dl {
      grid-template-columns: 1fr;
    }
    .db-reference-input {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
