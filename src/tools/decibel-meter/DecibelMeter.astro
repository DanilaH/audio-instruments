---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import InstrumentSurface from "../../components/layout/InstrumentSurface.astro";
---

<div data-decibel-meter data-db-state="idle">
  <InstrumentSurface label="Decibel Meter digital microphone level" accent="cyan">
    <div class="db-instrument">
      <section class="db-monitor" aria-label="Digital microphone level">
        <div class="db-monitor__header">
          <ToolStatus id="decibel-meter-status" label="Ready" state="idle" />
          <div class="db-input-readout">
            <span>Input</span>
            <strong data-db-active-input>No active input</strong>
          </div>
        </div>

        <div class="db-primary-readout">
          <p>RMS digital level</p>
          <strong data-db-rms>—</strong>
          <span>100 ms RMS · dBFS</span>
        </div>

        <div class="db-meter" aria-hidden="true">
          <div class="db-meter__scale">
            <span>−100</span><span>−75</span><span>−50</span><span>−25</span><span
              >0 dBFS</span
            >
          </div>
          <div class="db-meter__track">
            <span class="db-meter__fill" data-db-meter-fill></span>
          </div>
        </div>

        <div class="db-secondary-readout">
          <span>Peak hold</span>
          <strong data-db-peak>—</strong>
        </div>

        <div class="db-estimate" data-db-estimate-panel hidden>
          <div>
            <span>Reference-calibrated level estimate</span>
            <strong data-db-estimate>—</strong>
          </div>
          <span class="db-estimate__badge">User-calibrated</span>
        </div>
      </section>

      <section class="db-controls" aria-label="Decibel Meter controls">
        <div class="db-permission">
          <i class="ph ph-microphone" aria-hidden="true"></i>
          <div>
            <strong>Microphone permission is requested only after Start.</strong>
            <p>
              Audio stays local to this browser session. The live microphone is
              never connected to speaker output.
            </p>
          </div>
        </div>

        <div class="db-primary-actions">
          <button type="button" class="db-start" data-db-start>
            <i class="ph ph-gauge" aria-hidden="true"></i>
            Start meter
          </button>
          <button type="button" class="db-stop" data-db-stop disabled>
            <i class="ph ph-stop" aria-hidden="true"></i>
            Stop
          </button>
        </div>

        <label class="db-field" data-db-input-field hidden>
          <span>Input device</span>
          <select data-db-input aria-label="Decibel Meter input device"></select>
        </label>
        <p class="db-error" data-db-selection-error role="alert" hidden></p>

        <section class="db-calibration" aria-labelledby="db-calibration-title">
          <div class="db-calibration__heading">
            <div>
              <p class="db-eyebrow">Optional</p>
              <h3 id="db-calibration-title">One-point reference calibration</h3>
            </div>
            <span data-db-estimate-badge>Uncalibrated</span>
          </div>

          <p class="db-calibration__eligibility" data-db-calibration-eligibility>
            Start the microphone to check whether reference calibration is eligible.
          </p>

          <label class="db-field db-field--stacked">
            <span>External reference reading</span>
            <div class="db-reference-input">
              <input
                type="number"
                step="0.1"
                inputmode="decimal"
                placeholder="72.0"
                data-db-reference
              />
              <span>dB SPL reference</span>
            </div>
          </label>

          <label class="db-weighting-confirm">
            <input type="checkbox" data-db-weighting-confirm />
            <span>
              I confirm the external reference meter is set to Z / Flat / Linear
              weighting. A- or C-weighted references are not accepted in v1.
            </span>
          </label>

          <button type="button" class="db-calibrate" data-db-calibrate disabled>
            Capture 3-second reference
          </button>

          <p class="db-calibration__status" data-db-calibration-status>
            Uncalibrated
          </p>
          <p
            class="sr-only"
            data-db-calibration-live-status
            role="status"
            aria-live="polite"
          ></p>

          <div class="db-calibration__limit">
            <i class="ph ph-info" aria-hidden="true"></i>
            <p>
              One-point reference calibration. This does not calibrate microphone
              frequency response. Recalibrate after changing microphone, system
              input gain, processing, position or reference conditions. The browser
              measurement chain is not claimed to be true Z-weighted or unweighted.
            </p>
          </div>
        </section>

        <details class="db-details">
          <summary>Capture details</summary>
          <dl>
            <div>
              <dt>Device ID</dt>
              <dd data-db-detail-device-id>Not reported</dd>
            </div>
            <div>
              <dt>Web Audio processing rate</dt>
              <dd data-db-detail-analysis-rate>Not reported</dd>
            </div>
            <div>
              <dt>Track-reported sample rate</dt>
              <dd data-db-detail-sample-rate>Not reported</dd>
            </div>
            <div>
              <dt>Channel count</dt>
              <dd data-db-detail-channel-count>Not reported</dd>
            </div>
            <div>
              <dt>Echo cancellation</dt>
              <dd data-db-detail-echo-cancellation>Not reported</dd>
            </div>
            <div>
              <dt>Noise suppression</dt>
              <dd data-db-detail-noise-suppression>Not reported</dd>
            </div>
            <div>
              <dt>Auto gain control</dt>
              <dd data-db-detail-auto-gain>Not reported</dd>
            </div>
          </dl>
        </details>

        <p class="db-error" data-db-error role="alert" hidden></p>
      </section>
    </div>
  </InstrumentSurface>
</div>

<script>
  import { DecibelMeterController } from "./DecibelMeterController";

  const root = document.querySelector<HTMLElement>("[data-decibel-meter]");
  let controller: DecibelMeterController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new DecibelMeterController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .db-instrument {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(380px, 0.96fr);
    min-height: 540px;
  }

  .db-monitor,
  .db-controls {
    min-width: 0;
    padding: clamp(20px, 2.6vw, 32px);
  }

  .db-monitor {
    display: grid;
    align-content: start;
    gap: 18px;
    border-right: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 24% 18%, rgb(99 197 222 / 0.19), transparent 34%),
      radial-gradient(circle at 78% 74%, rgb(102 209 178 / 0.13), transparent 35%),
      linear-gradient(145deg, rgb(251 254 255 / 0.98), rgb(239 250 252 / 0.95));
  }

  .db-monitor__header,
  .db-primary-actions,
  .db-calibration__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .db-input-readout {
    display: grid;
    justify-items: end;
    gap: 2px;
    text-align: right;
  }

  .db-input-readout span,
  .db-primary-readout p,
  .db-primary-readout > span,
  .db-secondary-readout span,
  .db-field > span,
  .db-eyebrow {
    color: var(--color-ink-muted);
    font-size: 0.7rem;
    font-weight: 780;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .db-input-readout strong {
    max-width: 260px;
    overflow: hidden;
    font-size: 0.85rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .db-primary-readout {
    display: grid;
    justify-items: center;
    min-height: 230px;
    align-content: center;
    padding: 24px;
    border: 1px solid rgb(38 126 151 / 0.14);
    border-radius: 28px;
    background: rgb(255 255 255 / 0.7);
    text-align: center;
  }

  .db-primary-readout p,
  .db-primary-readout > span {
    margin: 0;
  }

  .db-primary-readout strong {
    margin: 8px 0 6px;
    font-size: clamp(2.8rem, 5.4vw, 4.9rem);
    font-weight: 820;
    letter-spacing: -0.055em;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .db-meter {
    display: grid;
    gap: 7px;
  }

  .db-meter__scale {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    color: var(--color-ink-muted);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }

  .db-meter__scale span:not(:first-child):not(:last-child) {
    text-align: center;
  }

  .db-meter__scale span:last-child {
    text-align: right;
  }

  .db-meter__track {
    height: 18px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent calc(25% - 1px),
        rgb(34 62 70 / 0.11) 25%
      ),
      rgb(255 255 255 / 0.8);
  }

  .db-meter__fill {
    --db-meter-fill: 0%;
    display: block;
    width: var(--db-meter-fill);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, rgb(83 183 211), rgb(87 190 159));
    transition: width 90ms linear;
  }

  .db-secondary-readout {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: rgb(255 255 255 / 0.67);
  }

  .db-secondary-readout strong {
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }

  .db-estimate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 15px;
    border: 1px solid rgb(68 147 124 / 0.2);
    border-radius: var(--radius-control);
    background: rgb(102 209 178 / 0.11);
  }

  .db-estimate[hidden] {
    display: none;
  }

  .db-estimate > div {
    display: grid;
    gap: 4px;
  }

  .db-estimate > div > span {
    color: var(--color-ink-muted);
    font-size: 0.72rem;
  }

  .db-estimate strong {
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }

  .db-estimate__badge,
  .db-calibration__heading > span {
    flex: 0 0 auto;
    padding: 5px 8px;
    border-radius: 999px;
    background: rgb(102 209 178 / 0.16);
    font-size: 0.68rem;
    font-weight: 780;
  }

  .db-controls {
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .db-permission,
  .db-calibration__limit {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 11px 12px;
    border-radius: var(--radius-control);
    background: rgb(99 197 222 / 0.1);
  }

  .db-permission strong {
    display: block;
    margin-bottom: 3px;
    font-size: 0.82rem;
  }

  .db-permission p,
  .db-calibration__limit p,
  .db-calibration__eligibility,
  .db-calibration__status,
  .db-error {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .db-primary-actions {
    justify-content: flex-start;
  }

  .db-start,
  .db-stop,
  .db-calibrate {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 16px;
    border-radius: var(--radius-button);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
  }

  .db-start {
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .db-stop,
  .db-calibrate {
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  button:disabled,
  select:disabled,
  input:disabled {
    cursor: not-allowed;
    opacity: 0.52;
  }

  .db-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }

  .db-field--stacked {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .db-field[hidden],
  .db-error[hidden] {
    display: none;
  }

  .db-field select,
  .db-reference-input input {
    min-width: 0;
    min-height: 42px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }

  .db-field select {
    padding: 0 34px 0 11px;
  }

  .db-reference-input {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
  }

  .db-reference-input input {
    padding: 0 11px;
  }

  .db-reference-input span {
    color: var(--color-ink-muted);
    font-size: 0.72rem;
  }

  .db-calibration {
    display: grid;
    gap: 11px;
    padding: 14px;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: rgb(255 255 255 / 0.55);
  }

  .db-calibration h3 {
    margin: 1px 0 0;
    font-size: 1rem;
  }

  .db-eyebrow {
    margin: 0;
  }

  .db-weighting-confirm {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 8px;
    color: var(--color-ink-muted);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .db-weighting-confirm input {
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
  }

  .db-calibrate {
    justify-self: start;
    min-height: 42px;
  }

  .db-calibration__status {
    color: var(--color-ink);
    font-weight: 720;
  }

  .db-details {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
  }

  .db-details summary {
    padding: 11px 12px;
    font-size: 0.78rem;
    font-weight: 760;
    cursor: pointer;
  }

  .db-details dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-border);
  }

  .db-details dl > div {
    display: grid;
    gap: 3px;
    padding: 9px 10px;
    background: var(--color-surface);
  }

  .db-details dt {
    color: var(--color-ink-muted);
    font-size: 0.67rem;
  }

  .db-details dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.76rem;
    font-weight: 720;
  }

  .db-error {
    color: var(--color-danger, #9a3434);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    border: 0;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .db-meter__fill {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .db-instrument {
      grid-template-columns: 1fr;
    }

    .db-controls {
      order: -1;
      border-bottom: 1px solid var(--color-border);
    }

    .db-monitor {
      border-right: 0;
    }
  }

  @media (max-width: 560px) {
    .db-monitor,
    .db-controls {
      padding: 16px;
    }

    .db-primary-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .db-start,
    .db-stop {
      width: 100%;
      padding-inline: 8px;
    }

    .db-primary-readout {
      min-height: 170px;
      padding: 18px 14px;
      border-radius: 22px;
    }

    .db-primary-readout strong {
      font-size: clamp(2.5rem, 11vw, 3.5rem);
    }

    .db-field {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .db-reference-input {
      grid-template-columns: 1fr;
      gap: 5px;
    }

    .db-details dl {
      grid-template-columns: 1fr;
    }
  }
</style>
