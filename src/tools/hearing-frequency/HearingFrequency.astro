---
import LevelControl from "../../components/controls/LevelControl.astro";
import ModePills from "../../components/controls/ModePills.astro";
import CapabilityNotice from "../../components/feedback/CapabilityNotice.astro";
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import InstrumentSurface from "../../components/layout/InstrumentSurface.astro";
import {
  HEARING_LEVEL_DEFAULT_DB,
  HEARING_LEVEL_MAX_DB,
  HEARING_LEVEL_MIN_DB,
} from "../../utils/audio";
import {
  HEARING_GUIDED_FREQUENCIES_HZ,
  HEARING_GUIDED_LEVEL_DB,
  HEARING_REFERENCE_FREQUENCY_HZ,
  formatHearingFrequency,
} from "./hearingTestModel";

const modeOptions = [
  { value: "guided", label: "Guided" },
  { value: "manual", label: "Manual" },
] as const;
---

<div
  data-hearing-frequency
  data-hearing-mode="guided"
  data-hearing-state="idle"
>
  <InstrumentSurface
    label="Hearing Frequency Test high-frequency exploration"
    accent="yellow"
  >
    <div class="hearing-instrument">
      <section class="hearing-stage" aria-label="Hearing frequency session">
        <div class="hearing-stage__header">
          <ToolStatus id="hearing-frequency-status" label="Ready" state="idle" />
          <div class="hearing-fixed-level">
            <span>Guided level</span>
            <strong>{HEARING_GUIDED_LEVEL_DB} dB</strong>
            <small>relative to unity</small>
          </div>
        </div>

        <div class="hearing-frequency-display">
          <p>Current guided frequency</p>
          <strong data-hearing-current-frequency>—</strong>
          <span data-hearing-progress>Not started</span>
        </div>

        <div class="hearing-result-card">
          <p>Highest frequency you reported hearing in this session</p>
          <strong data-hearing-result>—</strong>
          <span>
            Guided answers only. This is not a diagnosis, audiogram, hearing age or
            normal/abnormal assessment.
          </span>
        </div>

        <div class="hearing-frequency-track" aria-hidden="true">
          {
            HEARING_GUIDED_FREQUENCIES_HZ.map((frequencyHz) => (
              <span title={formatHearingFrequency(frequencyHz)}></span>
            ))
          }
        </div>
      </section>

      <section class="hearing-controls" aria-label="Hearing Frequency Test controls">
        <div class="hearing-safety">
          <i class="ph ph-shield-check" aria-hidden="true"></i>
          <p>
            Start with your device/headphone volume low. Increase it only to a low
            comfortable listening level during the 1 kHz setup reference. Then keep
            system/device volume unchanged. Do not turn it up to hear higher tones.
          </p>
        </div>

        <div class="hearing-control-header">
          <ModePills
            legend="Mode"
            name="hearing-mode"
            options={modeOptions}
            value="guided"
          />
          <button type="button" class="hearing-stop" data-hearing-stop disabled>
            <i class="ph ph-stop" aria-hidden="true"></i>
            Stop
          </button>
        </div>

        <section data-hearing-guided-panel aria-labelledby="hearing-guided-title">
          <div class="hearing-section-heading">
            <div>
              <p class="hearing-eyebrow">Fixed-level sequence</p>
              <h3 id="hearing-guided-title">Guided mode</h3>
            </div>
            <span>{HEARING_GUIDED_LEVEL_DB} dB</span>
          </div>

          <div class="hearing-setup">
            <div>
              <strong>1. Set a low comfortable system volume</strong>
              <p>
                Play the {HEARING_REFERENCE_FREQUENCY_HZ / 1_000} kHz reference at
                the fixed low app Level. Adjust only your device/system volume, then
                leave it unchanged for Guided mode.
              </p>
            </div>
            <button type="button" class="hearing-secondary" data-hearing-reference>
              <i class="ph ph-speaker-high" aria-hidden="true"></i>
              Play 1 kHz setup tone
            </button>
            <p data-hearing-setup-status>
              Play the setup reference before starting Guided mode.
            </p>
            <label class="hearing-confirm">
              <input type="checkbox" data-hearing-setup-confirm disabled />
              <span>
                System/device volume is low and comfortable, and I will keep it
                unchanged during Guided mode.
              </span>
            </label>
            <button type="button" class="hearing-primary" data-hearing-guided-start disabled>
              Start Guided mode
            </button>
          </div>

          <div class="hearing-answer" data-hearing-answer-panel hidden>
            <strong>Did you hear the tone?</strong>
            <div>
              <button type="button" data-hearing-heard disabled>I heard it</button>
              <button type="button" data-hearing-not-heard disabled>
                I didn't hear it
              </button>
            </div>
            <p>
              Your answer records only this session observation. It does not classify
              your hearing as normal or abnormal.
            </p>
          </div>
        </section>

        <section data-hearing-manual-panel aria-labelledby="hearing-manual-title" hidden>
          <div class="hearing-section-heading">
            <div>
              <p class="hearing-eyebrow">Exploration only</p>
              <h3 id="hearing-manual-title">Manual mode</h3>
            </div>
          </div>

          <label class="hearing-manual-frequency">
            <span>Frequency</span>
            <select data-hearing-manual-frequency>
              {
                HEARING_GUIDED_FREQUENCIES_HZ.map((frequencyHz) => (
                  <option value={frequencyHz}>
                    {formatHearingFrequency(frequencyHz)}
                  </option>
                ))
              }
            </select>
          </label>

          <LevelControl
            id="hearing-manual-level"
            valueDb={HEARING_LEVEL_DEFAULT_DB}
            minDb={HEARING_LEVEL_MIN_DB}
            maxDb={HEARING_LEVEL_MAX_DB}
          />

          <button type="button" class="hearing-primary" data-hearing-manual-play>
            Play 800 ms tone
          </button>
          <p class="hearing-manual-status" data-hearing-manual-status>
            Manual tones do not update the Guided session result.
          </p>
        </section>

        <CapabilityNotice id="hearing-frequency-cap" />
        <p class="hearing-error" data-hearing-error role="alert" hidden></p>
      </section>
    </div>
  </InstrumentSurface>
</div>

<script>
  import { HearingFrequencyController } from "./HearingFrequencyController";

  const root = document.querySelector<HTMLElement>("[data-hearing-frequency]");
  let controller: HearingFrequencyController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new HearingFrequencyController(root);
  };

  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });

  mount();
</script>

<style>
  .hearing-instrument {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(440px, 1.08fr);
    min-height: 570px;
  }

  .hearing-stage,
  .hearing-controls {
    min-width: 0;
    padding: clamp(20px, 2.6vw, 32px);
  }

  .hearing-stage {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 18px;
    border-right: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 50% 38%, rgb(246 205 93 / 0.22), transparent 30%),
      linear-gradient(150deg, rgb(255 253 244 / 0.98), rgb(251 246 229 / 0.9));
  }

  .hearing-stage__header,
  .hearing-control-header,
  .hearing-section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .hearing-fixed-level {
    display: grid;
    justify-items: end;
    gap: 2px;
    color: var(--color-ink-muted);
    font-size: 0.7rem;
    text-align: right;
  }

  .hearing-fixed-level strong {
    color: var(--color-ink);
    font-size: 1rem;
  }

  .hearing-frequency-display {
    display: grid;
    align-self: center;
    justify-items: center;
    gap: 6px;
    min-height: 230px;
    align-content: center;
    padding: 24px;
    border: 1px solid rgb(156 119 35 / 0.12);
    border-radius: 28px;
    background: rgb(255 255 255 / 0.62);
    text-align: center;
  }

  .hearing-frequency-display p,
  .hearing-frequency-display span,
  .hearing-result-card p,
  .hearing-result-card span {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .hearing-frequency-display strong {
    font-size: clamp(3rem, 6vw, 5rem);
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .hearing-result-card {
    display: grid;
    gap: 5px;
    padding: 14px 15px;
    border: 1px solid rgb(156 119 35 / 0.14);
    border-radius: 16px;
    background: rgb(255 255 255 / 0.58);
  }

  .hearing-result-card strong {
    font-size: 1.45rem;
  }

  .hearing-frequency-track {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 4px;
  }

  .hearing-frequency-track span {
    height: 6px;
    border-radius: 999px;
    background: rgb(188 146 52 / 0.2);
  }

  .hearing-controls {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .hearing-safety {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 11px 13px;
    border: 1px solid rgb(199 151 46 / 0.18);
    border-radius: 14px;
    background: rgb(255 249 226 / 0.74);
  }

  .hearing-safety i {
    margin-top: 2px;
  }

  .hearing-safety p,
  .hearing-setup p,
  .hearing-answer p,
  .hearing-manual-status {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.76rem;
    line-height: 1.48;
  }

  .hearing-stop,
  .hearing-primary,
  .hearing-secondary,
  .hearing-answer button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 15px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 750;
    cursor: pointer;
  }

  .hearing-primary {
    border-color: rgb(159 112 16 / 0.4);
    background: rgb(230 181 75);
    color: rgb(49 35 8);
  }

  .hearing-stop,
  .hearing-secondary,
  .hearing-answer button {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  button:disabled,
  select:disabled,
  input:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  [data-hearing-guided-panel],
  [data-hearing-manual-panel] {
    display: grid;
    gap: 13px;
    padding: 15px;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: rgb(255 255 255 / 0.58);
  }

  [data-hearing-guided-panel][hidden],
  [data-hearing-manual-panel][hidden],
  .hearing-answer[hidden] {
    display: none;
  }

  .hearing-section-heading h3,
  .hearing-section-heading p {
    margin: 0;
  }

  .hearing-section-heading h3 {
    margin-top: 2px;
    font-size: 1rem;
  }

  .hearing-section-heading > span {
    color: var(--color-ink-muted);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .hearing-eyebrow {
    color: var(--color-ink-muted);
    font-size: 0.66rem;
    font-weight: 720;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .hearing-setup {
    display: grid;
    gap: 10px;
  }

  .hearing-setup > div {
    display: grid;
    gap: 4px;
  }

  .hearing-confirm {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 9px;
    color: var(--color-ink-muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .hearing-confirm input {
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
  }

  .hearing-answer {
    display: grid;
    gap: 9px;
    padding: 12px;
    border-radius: 14px;
    background: rgb(248 243 226 / 0.8);
  }

  .hearing-answer > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .hearing-manual-frequency {
    display: grid;
    gap: 7px;
  }

  .hearing-manual-frequency > span {
    font-size: 0.84rem;
    font-weight: 750;
  }

  .hearing-manual-frequency select {
    min-height: 44px;
    padding: 0 36px 0 11px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    color: var(--color-ink);
    font: inherit;
  }

  .hearing-error {
    margin: 0;
    color: var(--color-danger, #9a3434);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .hearing-instrument {
      grid-template-columns: 1fr;
    }

    .hearing-stage {
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .hearing-frequency-display {
      min-height: 170px;
    }
  }

  @media (max-width: 520px) {
    .hearing-stage,
    .hearing-controls {
      padding: 14px 16px;
    }

    .hearing-stage {
      gap: 12px;
    }

    .hearing-frequency-display {
      min-height: 126px;
      padding: 14px;
      border-radius: 22px;
    }

    .hearing-frequency-display strong {
      font-size: clamp(2.7rem, 13vw, 3.7rem);
    }

    .hearing-result-card {
      padding: 11px 12px;
    }

    .hearing-result-card strong {
      font-size: 1.2rem;
    }

    .hearing-controls {
      gap: 12px;
    }

    .hearing-safety,
    [data-hearing-guided-panel],
    [data-hearing-manual-panel] {
      padding: 10px 11px;
    }

    .hearing-control-header {
      align-items: end;
    }

    .hearing-stop {
      flex: 0 0 auto;
    }
  }
</style>
