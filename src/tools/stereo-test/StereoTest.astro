---
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import InstrumentSurface from "../../components/layout/InstrumentSurface.astro";
---

<div data-stereo-test data-stereo-visual="center">
  <InstrumentSurface label="Stereo Test output controls" accent="lavender">
    <div class="stereo-instrument">
      <section class="stereo-visual" aria-label="Stereo position visualization">
        <div class="stereo-visual__header">
          <ToolStatus id="stereo-status" label="Ready" state="idle" />
          <div class="stereo-reference">
            <strong>500 Hz</strong>
            <span>700 ms static · 4 s pan</span>
          </div>
        </div>

        <div class="stereo-track" aria-hidden="true">
          <span class="stereo-track__rail"></span>
          <span class="stereo-track__trail stereo-track__trail--one"></span>
          <span class="stereo-track__trail stereo-track__trail--two"></span>
          <span class="stereo-track__signal"><i class="ph ph-wave-sine"></i></span>
          <span class="stereo-track__label stereo-track__label--left">L</span>
          <span class="stereo-track__label stereo-track__label--center">C</span>
          <span class="stereo-track__label stereo-track__label--right">R</span>
        </div>

        <p class="stereo-position">
          Digital target: <strong data-stereo-position-label>None</strong>
        </p>
        <p class="stereo-visual__note">
          Static Center uses explicit equal Left + Right routing. Pan sweeps use
          continuous stereo panning and do not verify physical speaker placement.
        </p>
      </section>

      <section class="stereo-controls" aria-label="Stereo Test actions">
        <div class="stereo-safety">
          <i class="ph ph-speaker-low" aria-hidden="true"></i>
          <p>
            Start with your device/headphone volume low. Increase it only to a
            comfortable listening level. Do not turn the volume up to compensate
            for a tone you cannot hear.
          </p>
        </div>

        <div class="stereo-group">
          <div>
            <strong>Static position</strong>
            <span>Same short reference burst in each position.</span>
          </div>
          <div class="stereo-actions stereo-actions--static">
            <button type="button" data-stereo-action="left">Left</button>
            <button type="button" data-stereo-action="center">Center</button>
            <button type="button" data-stereo-action="right">Right</button>
          </div>
        </div>

        <div class="stereo-group">
          <div>
            <strong>Pan sweep</strong>
            <span>Linear movement over four seconds.</span>
          </div>
          <div class="stereo-actions stereo-actions--pan">
            <button type="button" data-stereo-action="left-to-right">L → R</button>
            <button type="button" data-stereo-action="right-to-left">R → L</button>
          </div>
        </div>

        <button type="button" class="stereo-stop" data-stereo-stop disabled>
          <i class="ph ph-stop" aria-hidden="true"></i>
          Stop
        </button>

        <p class="stereo-error" data-stereo-error role="alert" hidden></p>
      </section>
    </div>
  </InstrumentSurface>
</div>

<script>
  import { StereoTestController } from "./StereoTestController";

  const root = document.querySelector<HTMLElement>("[data-stereo-test]");
  let controller: StereoTestController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new StereoTestController(root);
  };
  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });
  mount();
</script>

<style>
  .stereo-instrument {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(360px, 0.94fr);
    min-height: 410px;
  }

  .stereo-visual,
  .stereo-controls {
    min-width: 0;
    padding: clamp(22px, 3vw, 34px);
  }

  .stereo-visual {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    border-right: 1px solid var(--color-border);
    background:
      radial-gradient(circle at 50% 54%, rgb(143 124 255 / 0.19), transparent 34%),
      linear-gradient(145deg, rgb(255 253 252 / 0.92), rgb(247 244 255 / 0.8));
  }

  .stereo-visual__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  .stereo-reference {
    display: grid;
    justify-items: end;
    gap: 3px;
  }

  .stereo-reference strong { font-size: 1.3rem; }
  .stereo-reference span,
  .stereo-group span,
  .stereo-visual__note {
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .stereo-track {
    position: relative;
    min-height: 190px;
    margin: 20px 34px 8px;
  }

  .stereo-track__rail {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 4px;
    border-radius: 999px;
    background: rgb(143 124 255 / 0.2);
    transform: translateY(-50%);
  }

  .stereo-track__signal,
  .stereo-track__trail {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 54px;
    height: 54px;
    border-radius: 999px;
    transform: translate(-50%, -50%);
  }

  .stereo-track__signal {
    z-index: 3;
    display: grid;
    place-items: center;
    background: var(--color-ink);
    color: var(--color-surface);
    box-shadow: 0 14px 36px rgb(93 74 232 / 0.2);
    transition: left 180ms ease;
  }

  .stereo-track__trail {
    z-index: 2;
    background: rgb(143 124 255 / 0.18);
    opacity: 0;
    filter: blur(1px);
  }

  .stereo-track__label {
    position: absolute;
    bottom: 18px;
    font-weight: 800;
    color: var(--color-ink-muted);
  }
  .stereo-track__label--left { left: 0; }
  .stereo-track__label--center { left: 50%; transform: translateX(-50%); }
  .stereo-track__label--right { right: 0; }

  [data-stereo-visual="left"] .stereo-track__signal { left: 0; }
  [data-stereo-visual="center"] .stereo-track__signal { left: 50%; }
  [data-stereo-visual="right"] .stereo-track__signal { left: 100%; }

  [data-stereo-visual="left-to-right"] .stereo-track__signal,
  [data-stereo-visual="left-to-right"] .stereo-track__trail {
    animation: stereo-left-to-right 4s linear both;
  }
  [data-stereo-visual="right-to-left"] .stereo-track__signal,
  [data-stereo-visual="right-to-left"] .stereo-track__trail {
    animation: stereo-right-to-left 4s linear both;
  }
  [data-stereo-visual*="to"] .stereo-track__trail { opacity: 1; }
  [data-stereo-visual*="to"] .stereo-track__trail--one { animation-delay: -0.08s; opacity: 0.5; }
  [data-stereo-visual*="to"] .stereo-track__trail--two { animation-delay: -0.16s; opacity: 0.24; }

  @keyframes stereo-left-to-right {
    from { left: 0; }
    to { left: 100%; }
  }
  @keyframes stereo-right-to-left {
    from { left: 100%; }
    to { left: 0; }
  }

  .stereo-position { margin: 0; text-align: center; font-size: 0.92rem; }
  .stereo-visual__note { max-width: 560px; margin: 10px auto 0; text-align: center; }

  .stereo-controls {
    display: grid;
    align-content: start;
    gap: 18px;
    background: rgb(255 253 252 / 0.74);
  }

  .stereo-safety {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    padding: 11px 13px;
    border-radius: var(--radius-control);
    background: rgb(255 215 106 / 0.18);
  }
  .stereo-safety p,
  .stereo-error { margin: 0; font-size: 0.8rem; line-height: 1.45; }

  .stereo-group { display: grid; gap: 10px; }
  .stereo-group > div:first-child { display: grid; gap: 3px; }
  .stereo-actions { display: grid; gap: 8px; }
  .stereo-actions--static { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .stereo-actions--pan { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .stereo-actions button,
  .stereo-stop {
    min-height: 48px;
    border-radius: var(--radius-button);
    font-weight: 800;
    cursor: pointer;
  }
  .stereo-actions button {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .stereo-stop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-ink);
  }
  button:disabled { cursor: not-allowed; opacity: 0.48; }

  .stereo-error {
    padding: 11px 13px;
    border-radius: var(--radius-control);
    background: rgb(155 47 47 / 0.08);
    color: #7f2929;
  }
  .stereo-error[hidden] { display: none; }

  @media (max-width: 900px) {
    .stereo-instrument { grid-template-columns: 1fr; }
    .stereo-visual { min-height: 330px; border-right: 0; border-bottom: 1px solid var(--color-border); }
  }

  @media (max-width: 560px) {
    .stereo-visual,
    .stereo-controls { padding: 18px 20px; }
    .stereo-visual { min-height: 270px; }
    .stereo-track { min-height: 120px; margin: 8px 28px 4px; }
    .stereo-track__signal,
    .stereo-track__trail { width: 44px; height: 44px; }
    .stereo-track__label { bottom: 5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stereo-track__signal,
    .stereo-track__trail { animation: none !important; transition: none; }
    [data-stereo-visual="left-to-right"] .stereo-track__signal,
    [data-stereo-visual="right-to-left"] .stereo-track__signal { left: 50%; }
    .stereo-track__trail { display: none; }
  }
</style>
