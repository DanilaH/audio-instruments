---
import CapabilityNotice from "../../components/feedback/CapabilityNotice.astro";
import LevelControl from "../../components/controls/LevelControl.astro";
import ToolStatus from "../../components/feedback/ToolStatus.astro";
import SonicInstrument from "../../components/layout/SonicInstrument.astro";
---

<div
  data-headphone-test
  data-headphone-mode="left"
  data-headphone-visual="idle"
>
  <SonicInstrument label="Headphone Test controls" class="headphone-sheet">
    <div class="headphone-sheet__bar">
      <ToolStatus id="headphone-status" label="Ready" state="idle" />
      <div class="headphone-sheet__state">
        <span>Requested target</span>
        <strong data-headphone-visual-label>Left ear</strong>
      </div>
    </div>

    <section class="headphone-field" aria-label="Headphone stereo field">
      <div class="headphone-field__heading">
        <div>
          <span>Stereo field</span>
          <strong>Choose the output you want to verify</strong>
        </div>
        <span class="headphone-field__reference">500 Hz · 700 ms reference</span>
      </div>

      <div class="headphone-stage">
        <span class="headphone-stage__axis" aria-hidden="true"></span>
        <span class="headphone-stage__bridge" aria-hidden="true"></span>

        <button
          type="button"
          class="headphone-node headphone-node--left"
          data-headphone-mode="left"
          data-headphone-anchor="left"
          aria-pressed="true"
          aria-label="Left"
        >
          <span class="headphone-node__driver" aria-hidden="true"></span>
          <strong>L</strong>
          <small>Left ear</small>
        </button>

        <button
          type="button"
          class="headphone-node headphone-node--both"
          data-headphone-mode="both"
          data-headphone-anchor="center"
          aria-pressed="false"
          aria-label="Both"
        >
          <span class="headphone-node__signal" aria-hidden="true">∿</span>
          <strong>Both</strong>
          <small>Centered</small>
        </button>

        <button
          type="button"
          class="headphone-node headphone-node--right"
          data-headphone-mode="right"
          data-headphone-anchor="right"
          aria-pressed="false"
          aria-label="Right"
        >
          <span class="headphone-node__driver" aria-hidden="true"></span>
          <strong>R</strong>
          <small>Right ear</small>
        </button>
      </div>

      <div class="headphone-field__scale" aria-hidden="true">
        <span>20 Hz</span>
        <i></i>
        <span>20 kHz</span>
      </div>

      <p class="headphone-field__note">
        Requested digital routing only — this does not measure headphone
        frequency response, loudness or driver quality.
      </p>
    </section>

    <section class="headphone-rail" aria-label="Headphone Test actions">
      <div class="headphone-rail__modes" aria-label="Advanced headphone modes">
        <span class="headphone-rail__label">Mode</span>
        <div>
          <button
            type="button"
            data-headphone-mode="phase"
            aria-pressed="false"
          >
            Phase
          </button>
          <button
            type="button"
            data-headphone-mode="sweep"
            aria-pressed="false"
          >
            Sweep
          </button>
          <button
            type="button"
            data-headphone-mode="bass"
            aria-pressed="false"
          >
            Bass / rattle
          </button>
        </div>
      </div>

      <div class="headphone-mode-slot">
        <div class="headphone-channel-hint" data-headphone-channel-hint>
          <span>Ear check</span>
          <strong>Use L, Both or R directly in the stereo field.</strong>
          <p>Each target plays the same 500 Hz · 700 ms reference burst.</p>
        </div>

        <div class="headphone-panel" data-headphone-panel="phase" hidden>
          <div class="headphone-panel__heading">
            <span>Phase comparison</span>
            <strong>Correlated pink noise</strong>
            <p>Only the right-channel sign changes.</p>
          </div>
          <div class="headphone-actions headphone-actions--two">
            <button type="button" data-headphone-phase-in aria-pressed="false">
              In phase
            </button>
            <button
              type="button"
              data-headphone-phase-inverted
              aria-pressed="false"
            >
              Inverted
            </button>
          </div>
          <button
            type="button"
            class="headphone-primary"
            data-headphone-phase-toggle
            disabled
          >
            A/B toggle
          </button>
        </div>

        <div class="headphone-panel" data-headphone-panel="sweep" hidden>
          <div class="headphone-panel__heading">
            <span>Frequency sweep</span>
            <strong>15 s logarithmic sweep</strong>
            <p>Default 20 → 20,000 Hz.</p>
          </div>
          <div class="headphone-sweep-fields">
            <label>
              <span>Low</span>
              <span class="headphone-field-input">
                <input
                  id="headphone-sweep-low"
                  type="number"
                  min="20"
                  max="20000"
                  step="1"
                  value="20"
                  inputmode="decimal"
                />
                Hz
              </span>
            </label>
            <label>
              <span>High</span>
              <span class="headphone-field-input">
                <input
                  id="headphone-sweep-high"
                  type="number"
                  min="20"
                  max="20000"
                  step="1"
                  value="20000"
                  inputmode="decimal"
                />
                Hz
              </span>
            </label>
          </div>
          <button type="button" class="headphone-primary" data-headphone-sweep>
            Run headphone sweep
          </button>
        </div>

        <div class="headphone-panel" data-headphone-panel="bass" hidden>
          <div class="headphone-panel__heading">
            <span>Bass / rattle</span>
            <strong>20 → 120 Hz · 12 s</strong>
            <p>
              Listen for rattles or obvious left/right asymmetry at moderate
              volume.
            </p>
          </div>
          <button type="button" class="headphone-primary" data-headphone-bass>
            Run bass / rattle sweep
          </button>
        </div>
      </div>

      <div class="headphone-level">
        <LevelControl id="headphone-level" valueDb={-24} />
      </div>

      <button
        type="button"
        class="headphone-stop"
        data-headphone-stop
        disabled
      >
        <span class="transport-stop-shape" aria-hidden="true"></span>
        Stop
      </button>
    </section>

    <div class="headphone-state-strip">
      <strong>Low volume</strong>
      <p>
        Start with your device/headphone volume low. Increase it only to a
        comfortable listening level. Do not turn the volume up to compensate for
        a tone you cannot hear.
      </p>
    </div>

    <CapabilityNotice id="headphone-frequency-cap" message="" />
    <p class="headphone-error" data-headphone-error role="alert" hidden></p>
  </SonicInstrument>
</div>

<script>
  import { HeadphoneTestController } from "./HeadphoneTestController";

  const root = document.querySelector<HTMLElement>("[data-headphone-test]");
  let controller: HeadphoneTestController | null = null;

  const mount = () => {
    if (!root || controller) return;
    controller = new HeadphoneTestController(root);
  };
  const teardown = () => {
    const current = controller;
    controller = null;
    if (current) void current.dispose();
  };

  window.addEventListener("pagehide", teardown);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });
  mount();
</script>

<style>
  .headphone-sheet__bar {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 6px 18px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .headphone-sheet__state {
    display: grid;
    justify-items: end;
    gap: 1px;
    min-width: 0;
    text-align: right;
  }

  .headphone-sheet__state span,
  .headphone-field__heading > div > span,
  .headphone-rail__label,
  .headphone-channel-hint > span,
  .headphone-panel__heading > span {
    color: var(--sonic-muted);
    font-size: 0.67rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .headphone-sheet__state strong {
    max-width: 260px;
    overflow: hidden;
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .headphone-field {
    display: grid;
    gap: 9px;
    min-height: 244px;
    padding: 16px 22px 14px;
    border-bottom: 1px solid var(--sonic-border);
    background: var(--sonic-field);
  }

  .headphone-field__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
  }

  .headphone-field__heading > div {
    display: grid;
    gap: 2px;
  }

  .headphone-field__heading strong {
    font-size: 0.88rem;
  }

  .headphone-field__reference {
    color: var(--sonic-muted);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .headphone-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(118px, 1fr) minmax(96px, 0.72fr) minmax(
        118px,
        1fr
      );
    align-items: center;
    gap: clamp(18px, 5vw, 72px);
    width: min(100%, 720px);
    min-height: 132px;
    margin-inline: auto;
  }

  .headphone-stage__axis {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: 8%;
    left: 8%;
    height: 1px;
    background: var(--sonic-border);
  }

  .headphone-stage__axis::before,
  .headphone-stage__axis::after {
    position: absolute;
    top: -3px;
    width: 7px;
    height: 7px;
    border: 1px solid var(--sonic-border);
    border-radius: 50%;
    background: var(--sonic-field);
    content: "";
  }

  .headphone-stage__axis::before {
    left: 0;
  }

  .headphone-stage__axis::after {
    right: 0;
  }

  .headphone-stage__bridge {
    position: absolute;
    z-index: 0;
    top: 2px;
    left: 50%;
    width: min(58%, 390px);
    height: 74px;
    border: 1px solid var(--sonic-border);
    border-bottom: 0;
    border-radius: 50% 50% 0 0;
    opacity: 0.8;
    transform: translateX(-50%);
  }

  .headphone-node {
    position: relative;
    z-index: 2;
    display: grid;
    min-width: 0;
    min-height: 104px;
    place-items: center;
    align-content: center;
    gap: 2px;
    padding: 10px;
    border: 1px solid var(--sonic-border);
    border-radius: 8px;
    background: rgb(238 234 224 / 0.88);
    color: var(--sonic-ink);
    cursor: pointer;
    transition:
      border-color 120ms ease,
      background-color 120ms ease,
      color 120ms ease;
  }

  .headphone-node::after {
    position: absolute;
    inset: 7px;
    border: 1px solid transparent;
    border-radius: 5px;
    content: "";
    pointer-events: none;
  }

  .headphone-node strong {
    position: relative;
    z-index: 2;
    font-size: 1.55rem;
    font-variant-numeric: tabular-nums;
  }

  .headphone-node small {
    position: relative;
    z-index: 2;
    color: var(--sonic-muted);
    font-size: 0.67rem;
    font-weight: 750;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .headphone-node__driver {
    position: absolute;
    width: 46px;
    height: 46px;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.24;
  }

  .headphone-node__driver::after {
    position: absolute;
    inset: 9px;
    border: 1px solid currentColor;
    border-radius: 50%;
    content: "";
  }

  .headphone-node__signal {
    position: absolute;
    top: 8px;
    color: var(--sonic-muted);
    font-size: 1.15rem;
  }

  .headphone-node[aria-pressed="true"] {
    border-color: var(--sonic-signal);
    background: #eef0e7;
    color: var(--sonic-signal);
  }

  .headphone-node[aria-pressed="true"]::after {
    border-color: currentColor;
  }

  [data-headphone-visual="left"] .headphone-node--left,
  [data-headphone-visual="right"] .headphone-node--right,
  [data-headphone-visual="both"] .headphone-node--both,
  [data-headphone-visual="phase-in"] .headphone-node--left,
  [data-headphone-visual="phase-in"] .headphone-node--right,
  [data-headphone-visual="phase-inverted"] .headphone-node--left,
  [data-headphone-visual="phase-inverted"] .headphone-node--right,
  [data-headphone-visual="sweep"] .headphone-node,
  [data-headphone-visual="bass"] .headphone-node {
    border-color: var(--sonic-signal);
  }

  [data-headphone-visual="phase-inverted"] .headphone-node--right {
    border-style: dashed;
    color: var(--sonic-opposing);
  }

  .headphone-field__scale {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    color: var(--sonic-muted);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .headphone-field__scale i {
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      var(--sonic-border) 0 1px,
      transparent 1px 12.5%
    );
  }

  .headphone-field__note {
    margin: 0;
    color: var(--sonic-muted);
    font-size: 0.71rem;
    line-height: 1.35;
  }

  .headphone-rail {
    display: grid;
    grid-template-columns: minmax(210px, 0.72fr) minmax(330px, 1.35fr) minmax(
        180px,
        0.65fr
      ) 110px;
    min-height: 178px;
    align-items: stretch;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .headphone-rail > * {
    min-width: 0;
    padding: 12px 14px;
  }

  .headphone-rail > * + * {
    border-left: 1px solid var(--sonic-border-soft);
  }

  .headphone-rail__modes {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .headphone-rail__modes > div {
    display: grid;
    gap: 5px;
  }

  .headphone-rail__modes button,
  .headphone-actions button,
  .headphone-primary,
  .headphone-stop {
    min-height: 42px;
    border: 1px solid var(--sonic-border);
    border-radius: 5px;
    background: transparent;
    color: var(--sonic-ink);
    font: inherit;
    font-size: 0.76rem;
    font-weight: 780;
    cursor: pointer;
  }

  .headphone-rail__modes button[aria-pressed="true"],
  .headphone-actions button[aria-pressed="true"] {
    border-color: var(--sonic-signal);
    background: rgb(39 127 138 / 0.08);
    color: #155f68;
  }

  .headphone-mode-slot {
    position: relative;
    min-height: 176px;
  }

  .headphone-channel-hint,
  .headphone-panel {
    position: absolute;
    inset: 12px 14px;
    display: grid;
    align-content: center;
    gap: 7px;
    min-width: 0;
  }

  [data-headphone-mode="phase"] .headphone-channel-hint,
  [data-headphone-mode="sweep"] .headphone-channel-hint,
  [data-headphone-mode="bass"] .headphone-channel-hint,
  .headphone-panel[hidden] {
    display: none;
  }

  .headphone-channel-hint strong,
  .headphone-panel__heading strong {
    font-size: 0.86rem;
  }

  .headphone-channel-hint p,
  .headphone-panel__heading p {
    margin: 0;
    color: var(--sonic-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .headphone-panel__heading {
    display: grid;
    gap: 2px;
  }

  .headphone-actions,
  .headphone-sweep-fields {
    display: grid;
    gap: 6px;
  }

  .headphone-actions--two,
  .headphone-sweep-fields {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .headphone-primary {
    border-color: var(--sonic-ink);
    background: var(--sonic-ink);
    color: var(--sonic-sheet);
  }

  .headphone-sweep-fields label {
    display: grid;
    gap: 3px;
    color: var(--sonic-muted);
    font-size: 0.7rem;
    font-weight: 720;
  }

  .headphone-field-input {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 5px;
  }

  .headphone-field-input input {
    width: 100%;
    min-height: 38px;
    padding: 0 8px;
    border: 1px solid var(--sonic-border);
    border-radius: 4px;
    background: #f3f0e8;
    color: var(--sonic-ink);
    font-variant-numeric: tabular-nums;
  }

  .headphone-level {
    display: grid;
    align-content: center;
  }

  .headphone-level :global(.level-control) {
    gap: 5px;
  }

  .headphone-level :global(.level-control__hint) {
    display: none;
  }

  .headphone-level :global(.level-control label),
  .headphone-level :global(.level-control output) {
    color: var(--sonic-ink);
    font-size: 0.76rem;
  }

  .headphone-level :global(.level-control input) {
    min-height: 36px;
    accent-color: var(--sonic-signal);
  }

  .headphone-stop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    align-self: center;
    margin: 12px;
    padding: 0 10px;
  }

  .transport-stop-shape {
    width: 9px;
    height: 9px;
    border-radius: 1px;
    background: currentColor;
  }

  .headphone-state-strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    padding: 9px 18px;
    border-bottom: 1px solid var(--sonic-border-soft);
  }

  .headphone-state-strip strong {
    color: var(--sonic-current);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .headphone-state-strip p,
  .headphone-error {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .headphone-state-strip p {
    color: var(--sonic-muted);
  }

  .headphone-error {
    padding: 9px 18px;
    color: var(--sonic-opposing);
  }

  .headphone-error[hidden] {
    display: none;
  }

  button:disabled,
  input:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  @media (max-width: 900px) {
    .headphone-stage {
      gap: 18px;
    }

    .headphone-rail {
      grid-template-columns: minmax(180px, 0.8fr) minmax(300px, 1.4fr) minmax(
          160px,
          0.7fr
        );
    }

    .headphone-stop {
      grid-column: 1 / -1;
      min-height: 42px;
      margin: 0 12px 12px;
    }

    .headphone-rail > .headphone-stop {
      border-left: 1px solid var(--sonic-border);
    }
  }

  @media (max-width: 700px) {
    .headphone-sheet__bar {
      padding-inline: 14px;
    }

    .headphone-field {
      min-height: 220px;
      padding: 14px;
    }

    .headphone-field__heading {
      align-items: start;
    }

    .headphone-field__reference {
      display: none;
    }

    .headphone-stage {
      grid-template-columns: minmax(74px, 1fr) minmax(72px, 0.85fr) minmax(
          74px,
          1fr
        );
      gap: 8px;
      min-height: 120px;
    }

    .headphone-stage__bridge {
      width: 62%;
      height: 58px;
    }

    .headphone-node {
      min-height: 92px;
      padding: 8px 4px;
    }

    .headphone-node__driver {
      width: 38px;
      height: 38px;
    }

    .headphone-node strong {
      font-size: 1.25rem;
    }

    .headphone-rail {
      grid-template-columns: 1fr;
    }

    .headphone-rail > * + * {
      border-top: 1px solid var(--sonic-border-soft);
      border-left: 0;
    }

    .headphone-rail__modes > div {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .headphone-mode-slot {
      min-height: 190px;
    }

    .headphone-stop {
      width: calc(100% - 28px);
      margin: 0 14px 14px;
    }

    .headphone-state-strip {
      grid-template-columns: 1fr;
      gap: 3px;
      padding-inline: 14px;
    }
  }

  @media (max-width: 380px) {
    .headphone-sheet__state span {
      display: none;
    }

    .headphone-field__note,
    .headphone-field__scale {
      display: none;
    }

    .headphone-field {
      min-height: 190px;
    }

    .headphone-node small {
      font-size: 0.58rem;
    }

    .headphone-rail__modes > div {
      grid-template-columns: 1fr;
    }

    .headphone-mode-slot {
      min-height: 205px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .headphone-node {
      transition: none;
    }
  }
</style>